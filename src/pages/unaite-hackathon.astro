---
import Layout from "layouts/LayoutLanding.astro";
import OpenArmViewer from "components/OpenArmViewer.astro";
---

<Layout
  title="Unaite Hackathon - GOSIM Paris 2026"
  description="A hands-on robotics hackathon with LeRobot's OpenArm. Build with real robots. Fully open source."
  navDarkMode={true}
  navBackground="header-home"
>
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-background">
        <div class="hero-gradient"></div>
        <OpenArmViewer />
      </div>
      <div class="hero-content">
        <div class="hero-badges">
          <span class="badge">GOSIM Paris 2026</span>
          <span class="badge">Hackathon</span>
          <span class="badge">Open Source Robotics</span>
        </div>
        <h1 class="hero-title">Unaite Hackathon</h1>
        <p class="hero-subtitle">Build with real robots. Powered by LeRobot. Fully open source.</p>
        <div class="hero-intro">
          <h2>A Hands-On Robotics Hackathon</h2>
          <p>
            The Unaite Hackathon is a hands-on robotics hackathon featuring LeRobot's OpenArm — built in partnership with the LeRobot team. LeRobot is releasing a new version with full OpenArm support, including a dataset and a cloth-folding model ready to use out of the box.
          </p>
          <p>
            The entire setup is fully open source, with potential industrial use cases. Whether you're a seasoned robotics engineer or a curious hacker, this is your chance to build something real with real robots.
          </p>
        </div>
      </div>
    </section>

    <!-- Details Section -->
    <section class="categories-section">
      <div class="container">
        <h2>Hackathon Details</h2>
        <div class="categories-list">

          <div class="category-row" style="--accent: #6366f1; --accent-light: #818cf8;">
            <div class="category-scene" data-scene="venue">
              <div class="scene-placeholder">
                <span class="scene-icon">🏛️</span>
              </div>
            </div>
            <div class="category-info">
              <span class="category-number">01</span>
              <h3>Venue</h3>
              <p>Station F Open Platform (center island) with tables, chairs, and plugs. The space is accessible from 8am to 8pm throughout the event.</p>
            </div>
          </div>

          <div class="category-row" style="--accent: #10b981; --accent-light: #34d399;">
            <div class="category-scene" data-scene="hardware">
              <div class="scene-placeholder">
                <span class="scene-icon">🦾</span>
              </div>
            </div>
            <div class="category-info">
              <span class="category-number">02</span>
              <h3>Hardware</h3>
              <p>10 OpenArms (2 arms each) with a teleoperation arm. The new LeRobot release includes a dataset and cloth-folding model. A simulated environment will be available before the event for early development.</p>
            </div>
          </div>

          <div class="category-row" style="--accent: #3b82f6; --accent-light: #60a5fa;">
            <div class="category-scene" data-scene="remote">
              <div class="scene-placeholder">
                <span class="scene-icon">🌐</span>
              </div>
            </div>
            <div class="category-info">
              <span class="category-number">03</span>
              <h3>Remote Access</h3>
              <p>Access OpenArms remotely from home or school. Validate your work in simulation for early hardware access — available one week and one weekend before the event.</p>
            </div>
          </div>

          <div class="category-row" style="--accent: #f59e0b; --accent-light: #fbbf24;">
            <div class="category-scene" data-scene="teams">
              <div class="scene-placeholder">
                <span class="scene-icon">👥</span>
              </div>
            </div>
            <div class="category-info">
              <span class="category-number">04</span>
              <h3>Teams</h3>
              <p>Teams of 3–5 people, approximately 50 participants total. Each team gets one OpenArm to build with during the hackathon.</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Partnership Section -->
    <section class="partnership-section">
      <div class="container">
        <h2>Partnership &amp; Sponsorship</h2>
        <p class="intro-text">
          Partners get their name featured on the event website, signage, screens, and roll-up banners — plus access to the networking event. The hackathon features human-size robots with industrial use cases, including a cloth-folding model, and the entire stack is fully open source.
        </p>
        <p class="intro-text">
          Interested in supporting the next generation of open-source robotics? Reach out to become a sponsor.
        </p>
      </div>
    </section>

    <!-- Call to Action Section with Video -->
    <section class="cta-video-section">
      <div class="cta-video-background">
        <video
          autoplay
          loop
          muted
          playsinline
          webkit-playsinline
          poster="/videos/paris-hero-bk.jpg"
          onloadstart="this.playbackRate=0.25"
        >
          <source src="/videos/paris-hero-compressed.mp4" type="video/mp4" />
        </video>
        <div class="cta-video-overlay"></div>
      </div>
      <div class="cta-video-content">
        <h2>Join the Hackathon</h2>
        <p>
          Build with real robots, collaborate with the LeRobot team, and push the boundaries of open-source robotics. Whether you want to hack on-site or participate remotely — we'd love to have you.
        </p>
        <div class="cta-buttons">
          <a href="mailto:contact@gosim.org" class="cta-button">Become a Sponsor</a>
          <a href="https://gosim.org/" target="_blank" rel="noopener noreferrer" class="cta-button cta-button-outline">Register</a>
        </div>
      </div>
    </section>

</Layout>

<style>
  /* Hero Section */
  .hero-section {
    position: relative;
    min-height: 500px;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .hero-gradient {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 40%, #0e7aff 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(20px, 6vw, 64px);
    padding-top: clamp(80px, 12vw, 140px);
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .badge {
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    padding: 6px 12px;
    font-weight: 600;
    color: #fff;
    font-size: 14px;
  }

  .hero-title {
    font-size: clamp(28px, 4.2vw, 60px);
    line-height: 1.08;
    margin: 0.2em 0;
    font-weight: 700;
    color: #fff;
  }

  .hero-subtitle {
    color: rgba(255, 255, 255, 0.8);
    font-size: clamp(16px, 1.4vw, 20px);
    margin: 0;
  }

  .hero-intro {
    margin-top: 2rem;
    max-width: 800px;
  }

  .hero-intro h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: #fff;
    text-align: left;
  }

  .hero-intro p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  /* Common */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(20px, 5vw, 60px);
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    color: #0f172a;
    text-align: left;
  }

  /* Categories Section */
  .categories-section {
    padding: 60px 0;
    background: #0f172a;
  }

  .categories-section h2 {
    color: #fff;
  }

  .categories-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 20px;
    overflow: hidden;
  }

  .category-row {
    display: grid;
    grid-template-columns: 280px 1fr;
    background: rgba(15, 23, 42, 0.95);
    transition: background 0.4s ease;
    cursor: default;
  }

  .category-row:hover {
    background: rgba(30, 41, 59, 0.95);
  }

  .category-scene {
    position: relative;
    min-height: 180px;
    overflow: hidden;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 15%, transparent), color-mix(in srgb, var(--accent-light) 8%, transparent));
  }

  .scene-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .scene-icon {
    font-size: 4rem;
    filter: grayscale(0.3);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.4s ease;
  }

  .category-row:hover .scene-icon {
    transform: scale(1.15);
    filter: grayscale(0);
  }

  .category-info {
    padding: 2rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    border-left: 1px solid rgba(255, 255, 255, 0.06);
  }

  .category-number {
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
    color: var(--accent-light);
    opacity: 0.7;
  }

  .category-info h3 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #fff;
    margin: 0;
    letter-spacing: -0.01em;
    transition: color 0.3s ease;
  }

  .category-row:hover .category-info h3 {
    color: var(--accent-light);
  }

  .category-info p {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.92rem;
    line-height: 1.65;
    margin: 0;
    max-width: 540px;
    transition: color 0.3s ease;
  }

  .category-row:hover .category-info p {
    color: rgba(255, 255, 255, 0.7);
  }

  /* Partnership Section */
  .partnership-section {
    padding: 40px 0;
    background: #fff;
  }

  /* CTA Video Section */
  .cta-video-section {
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .cta-video-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .cta-video-background video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta-video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(14, 23, 42, 0.9) 0%, rgba(30, 58, 95, 0.75) 50%, rgba(14, 122, 255, 0.6) 100%);
  }

  .cta-video-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 700px;
    padding: clamp(40px, 8vw, 80px) clamp(20px, 5vw, 60px);
  }

  .cta-video-content h2 {
    color: #fff;
    text-align: center;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .cta-video-content p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-button {
    display: inline-block;
    background: #0e7aff;
    color: #fff;
    padding: 14px 36px;
    border-radius: 999px;
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .cta-button:hover {
    background: #0b63d1;
    transform: translateY(-2px);
  }

  .cta-button-outline {
    background: transparent;
    border: 2px solid rgba(255, 255, 255, 0.5);
  }

  .cta-button-outline:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: #fff;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .category-row {
      grid-template-columns: 1fr;
    }

    .category-scene {
      min-height: 120px;
    }

    .category-info {
      border-left: none;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      padding: 1.5rem;
    }
  }
</style>
