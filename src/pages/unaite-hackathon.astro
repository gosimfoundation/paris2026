---
import Layout from "layouts/LayoutLanding.astro";
import OpenArmViewer from "components/OpenArmViewer.astro";
---

<Layout
  title="Robotics Hackathon - GOSIM Paris 2026"
  description="A hands-on robotics hackathon with LeRobot's OpenArm. Build with real robots. Fully open source."
  navDarkMode={true}
  navBackground="header-home"
>
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-background">
        <video
          autoplay
          loop
          muted
          playsinline
          webkit-playsinline
        >
          <source src="https://openarm.dev/videos/kv.mp4#t=5" type="video/mp4" />
        </video>
        <div class="hero-overlay"></div>
      </div>
      <div class="hero-content">
        <h1 class="hero-title">Robotics Hackathon</h1>
        <p class="hero-details">May 5-6, 2026 &middot; OpenPlatform, STATION F, Paris</p>
        <p class="hero-subtitle">Build with real robots. Fully open source.</p>
        <div class="hero-intro">
          <h2>A Hands-On Robotics Hackathon</h2>
          <p>
            The Robotics Hackathon is a hands-on hackathon featuring OpenArm — a fully open-source humanoid robot arm. The entire setup is open source, with potential industrial use cases. Whether you're a seasoned robotics engineer or a curious hacker, this is your chance to build something real with real robots.
          </p>
        </div>

        <div class="hero-people">
          <div class="hero-people-group">
            <h3>Organizer</h3>
            <div class="hero-people-row">
              <a href="https://unaite.fr" target="_blank" rel="noopener noreferrer" class="person-card">
                <img src="/images/speakers/unaite-logo.jpg" alt="Unaite" class="person-photo" />
                <span class="person-name">Unaite</span>
                <span class="person-role">AI Student Federation</span>
              </a>
              <a href="https://github.com/haixuanTao" target="_blank" rel="noopener noreferrer" class="person-card">
                <img src="/images/speakers/haixuan-tao.jpg" alt="Haixuan Xavier Tao" class="person-photo" />
                <span class="person-name">Haixuan Xavier Tao</span>
                <span class="person-role">Founder @ 1ms.ai</span>
              </a>
              <a href="https://42-ai.github.io" target="_blank" rel="noopener noreferrer" class="person-card">
                <img src="/images/speakers/42-ai-logo.png" alt="42 AI" class="person-photo" />
                <span class="person-name">42 AI</span>
                <span class="person-role">AI Student Association @ 42 Paris</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Call for Participation Section -->
    <section class="cfp-section">
      <div class="container">
        <h2>Call for Participation</h2>
        <p class="cfp-intro">We're looking for talented roboticists looking to apply state-of-the-art models on physical hardware — in the hope of increasing community interest in solving the open challenges associated with robotic grasping and manipulation.</p>
        <p class="cfp-intro">Tasks we're looking to solve include:</p>
        <ul class="cfp-tasks">
          <li>Assembling and disassembling boards</li>
          <li>Hand-in-hand grasping</li>
          <li>Picking and placing various objects</li>
          <li>Pouring liquids into a cup</li>
          <li>Bin picking</li>
          <li>Rearranging and setting formal tables</li>
          <li>Folding and unfolding cloths</li>
          <li>Receiving objects handed over by a person</li>
        </ul>
        <p class="cfp-details">Teams of 3–5 people, approximately 50 participants total. Each team gets 1 physical OpenArm to build with during the hackathon. Remote physical access is also available — control the robot from your home or school once your code is validated in simulation.</p>
        <a href="https://luma.com/11cjioey" target="_blank" rel="noopener noreferrer" class="cta-button">Join the Hackathon</a>
      </div>
    </section>

    <!-- Hardware Section -->
    <section class="hardware-section">
      <div class="hardware-background">
        <div class="hardware-gradient"></div>
        <div class="hardware-viewer">
          <OpenArmViewer />
        </div>
      </div>
      <div class="hardware-content">
        <h2>Work with OpenArm</h2>
        <ul class="hardware-specs-list">
          <li><strong>7 DoF</strong> humanoid robot arm with 633mm reach</li>
          <li><strong>6kg peak payload</strong>, 5.5kg arm weight</li>
          <li><strong>Teleoperation kit</strong> — 2 arms + teleop arm per team</li>
          <li><strong>1kHz CAN-FD</strong> control for precise, responsive motion</li>
          <li><strong>Backdrivable &amp; compliant</strong> for safe human-robot interaction</li>
          <li><strong>Fully open source</strong> — CAD, URDF, firmware, control software</li>
          <li><strong>Compatible</strong> with LeRobot, dora-rs, ROS2, MuJoCo, and Isaac Lab</li>
          <li><strong>Simulation</strong> environment available before the event</li>
        </ul>
        <a href="https://openarm.dev" target="_blank" rel="noopener noreferrer" class="cta-button">Learn More about OpenArm</a>
      </div>
    </section>

    <!-- Setups Section -->
    <section class="setups-section">
      <div class="container">
        <h2>Two Setups Available</h2>
        <div class="setups-grid">
          <div class="setup-card">
            <h3>dora-rs + RealSense Depth Camera</h3>
            <p>A setup powered by <strong>dora-rs</strong> with an Intel RealSense depth camera for 3D perception and manipulation tasks.</p>
            <a href="https://x.com/HaixuanT/status/2038914443505983665" target="_blank" rel="noopener noreferrer" class="setup-link">See it in action &rarr;</a>
          </div>
          <div class="setup-card">
            <h3>LeRobot + 3 Cameras</h3>
            <p>A setup powered by <strong>LeRobot</strong> with a 3-camera configuration for multi-view teleoperation and learning.</p>
            <a href="https://x.com/LeRobotHF/status/2041542790610297259" target="_blank" rel="noopener noreferrer" class="setup-link">See it in action &rarr;</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Partnership Section -->
    <section class="partnership-section">
      <div class="container">
        <h2>Partnership &amp; Sponsorship</h2>
        <p class="intro-text">
          Partners get their name featured on the event website, signage, screens, and roll-up banners — plus access to the networking event. The hackathon features human-size robots with industrial use cases, including a cloth-folding model, and the entire stack is fully open source.
        </p>
        <p class="intro-text">
          Interested in supporting the next generation of open-source robotics? Reach out to become a sponsor.
        </p>
      </div>
    </section>

    <!-- Venue Section -->
    <section class="venue-section">
      <div class="venue-background">
        <img src="/images/openplatform-stationf.jpeg" alt="STATION F - OpenPlatform" />
        <div class="venue-overlay"></div>
      </div>
      <div class="venue-content">
        <h2>Venue</h2>
        <h3>STATION F — OpenPlatform, Paris</h3>
        <p>Hosted at STATION F, the world's largest startup campus, on the OpenPlatform — an open co-working space with tables, chairs, and plugs, accessible from 8am to 8pm throughout the event.</p>
        <a href="https://luma.com/11cjioey" target="_blank" rel="noopener noreferrer" class="cta-button">Register</a>
      </div>
    </section>


</Layout>

<style>
  /* Hero Section */
  .hero-section {
    position: relative;
    min-height: 500px;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .hero-background video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(14, 23, 42, 0.7) 0%, rgba(30, 58, 95, 0.5) 50%, rgba(14, 122, 255, 0.3) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(20px, 6vw, 64px);
    padding-top: clamp(80px, 12vw, 140px);
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .badge {
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    padding: 6px 12px;
    font-weight: 600;
    color: #fff;
    font-size: 14px;
  }

  .hero-title {
    font-size: clamp(28px, 4.2vw, 60px);
    line-height: 1.08;
    margin: 0.2em 0;
    font-weight: 700;
    color: #fff;
  }

  .hero-details {
    color: rgba(255, 255, 255, 0.7);
    font-size: clamp(16px, 1.4vw, 20px);
    margin: 0.5rem 0 0 0;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .hero-subtitle {
    color: rgba(255, 255, 255, 0.8);
    font-size: clamp(16px, 1.4vw, 20px);
    margin: 0.5rem 0 0 0;
  }

  .hero-intro {
    margin-top: 2rem;
    max-width: 800px;
  }

  .hero-intro h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: #fff;
    text-align: left;
  }

  .hero-intro p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  /* Hero People */
  .hero-people {
    display: flex;
    gap: 3rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .hero-people-group h3 {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 0.75rem 0;
  }

  .hero-people-row {
    display: flex;
    gap: 1.5rem;
  }

  .person-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .person-card:hover {
    transform: translateY(-3px);
  }

  .person-photo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255, 255, 255, 0.2);
    transition: border-color 0.2s ease;
  }

  .person-card:hover .person-photo {
    border-color: #0e7aff;
  }

  .person-name {
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: center;
  }

  .person-role {
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.75rem;
    text-align: center;
  }

  /* Common */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(20px, 5vw, 60px);
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    color: #0f172a;
    text-align: left;
  }

  /* Call for Participation Section */
  .cfp-section {
    padding: 60px 0;
    background: #f8fafc;
  }

  .cfp-section h2 {
    color: #0f172a;
  }

  .cfp-intro {
    font-size: 1.15rem;
    color: #334155;
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .cfp-tasks {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-left: 0.75rem;
  }

  .cfp-tasks li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.95rem;
    color: #475569;
    line-height: 1.6;
  }

  .cfp-tasks li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0e7aff;
  }

  .cfp-details {
    font-size: 1rem;
    color: #334155;
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  /* Setups Section */
  .setups-section {
    padding: 60px 0;
    background: #fff;
  }

  .setups-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .setup-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 2rem;
  }

  .setup-card h3 {
    font-size: 1.25rem;
    color: #0f172a;
    margin: 0 0 0.75rem 0;
  }

  .setup-card p {
    color: #475569;
    line-height: 1.7;
    margin: 0 0 1.25rem 0;
  }

  .setup-link {
    color: #0e7aff;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .setup-link:hover {
    color: #0b63d1;
  }

  @media (max-width: 768px) {
    .setups-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Partnership Section */
  .partnership-section {
    padding: 40px 0;
    background: #fff;
  }

  /* Venue Section */
  .venue-section {
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #0e1729;
  }

  .venue-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .venue-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: blur(4px);
  }

  .venue-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(14, 40, 80, 0.6);
  }

  .venue-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 700px;
    padding: clamp(40px, 8vw, 80px) clamp(20px, 5vw, 60px);
  }

  .venue-content h2 {
    color: #fff;
    text-align: center;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .venue-content h3 {
    color: #60a5fa;
    font-size: 1.3rem;
    margin: 0 0 1rem 0;
  }

  .venue-content p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  /* Hardware Section */
  .hardware-section {
    position: relative;
    min-height: 500px;
    overflow: hidden;
  }

  .hardware-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .hardware-gradient {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 40%, #0e7aff 100%);
  }

  .hardware-viewer {
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
  }

  .hardware-content {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(40px, 6vw, 80px) clamp(20px, 6vw, 64px);
  }

  .hardware-content h2 {
    color: #fff;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    text-align: left;
    margin-bottom: 1.5rem;
  }

  .hardware-specs-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 550px;
  }

  .hardware-specs-list li {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1rem;
    line-height: 1.6;
    padding-left: 1.25rem;
    position: relative;
  }

  .hardware-specs-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0e7aff;
  }

  .hardware-specs-list strong {
    color: #fff;
  }

  @media (max-width: 768px) {
    .hardware-viewer {
      width: 100%;
      opacity: 0.3;
    }
  }

  .cta-button {
    display: inline-block;
    background: #0e7aff;
    color: #fff;
    padding: 14px 36px;
    border-radius: 999px;
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .cta-button:hover {
    background: #0b63d1;
    transform: translateY(-2px);
  }

  .cta-button-outline {
    background: transparent;
    border: 2px solid rgba(255, 255, 255, 0.5);
  }

  .cta-button-outline:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: #fff;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .category-row {
      grid-template-columns: 1fr;
    }

    .category-scene {
      min-height: 120px;
    }

    .category-info {
      border-left: none;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      padding: 1.5rem;
    }
  }
</style>
