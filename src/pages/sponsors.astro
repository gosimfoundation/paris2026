---
// Components
import Layout from "layouts/LayoutLanding.astro"
import GetTickets from "components/GetTickets.astro"
import HeroText from "components/HeroText.astro"
import AllSponsors from "components/Sponsors.astro"
import TextAndSponsors from "components/TextAndSponsors.astro"
---

<Layout
  title="Supporters – GOSIM Paris 2026"
  description="GOSIM Paris 2026 is a gathering of open-source AI projects, developers, researchers, and industry supporters to share knowledge, learn from each other, and collaborate."
  navBackground="light"
  pageTransitionName="Supporters"
>
  <HeroText
    title="Supporters"
    text="We're excited to bring you an incredible experience, made possible by the generous support of our Supporters and Supporting Organizations. We've partnered with true innovators that are pushing the boundaries of our industry."
    lightgray
  />

  <AllSponsors />

  <GetTickets
    title="GOSIM Paris 2026 Has Concluded"
    location="Paris"
    date="May 5-6, 2026"
    text="Thank you to everyone who joined us at GOSIM Paris 2026. It was an incredible gathering of innovators, industry pioneers, and open-source enthusiasts shaping the future of technology together."
    ctaButton={{
      text: "Event Ended",
      link: "https://gosimparis2026.eventbrite.com/",
      openInNewTab: true,
    }}
  />
</Layout>
