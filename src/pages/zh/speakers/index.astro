---
// Components
import Layout from "layouts/LayoutLandingZh.astro";
import GetTickets from "components/GetTickets.astro";
import HeroText from "components/HeroText.astro";
import AllSpeakers from "components/SpeakersZh.astro";
---

<Layout
  title="演讲嘉宾 – GOSIM Paris 2026"
  description="GOSIM Paris 2026 是一个开源人工智能项目、开发者、研究人员和行业赞助商的聚会，旨在分享知识、相互学习和合作。"
  navBackground="light"
  pageTransitionName="Speakers"
>
  <HeroText title="演讲嘉宾" lightgray />

  <AllSpeakers />

  <GetTickets
    title="GOSIM Paris 2026 已圆满结束"
    location="巴黎"
    date="2026年5月4-6日"
    text="感谢所有参加 GOSIM Paris 2026 的朋友们。这是一次汇聚创新者、行业先驱和开源爱好者的精彩盛会，共同塑造技术的未来。"
    ctaButton={{
      text: "活动已结束",
      link: "https://gosimparis2026.eventbrite.com/",
      openInNewTab: true,
    }}
  />
</Layout>
