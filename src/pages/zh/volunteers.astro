---
// Components
import Layout from "layouts/LayoutLandingZh.astro"
import Content from "markdown/VolunteersZh.md"
---

<Layout
  title="志愿者 – GOSIM Paris 2026"
  description="加入 GOSIM Paris 2026 志愿者团队，在欧洲最大的开源会议之一中获得独特体验。"
  navBackground="light"
  pageTransitionName="Volunteers"
>
  <section
    class="section speaker-detail-header"
    data-theme-section="light"
    data-bg-section="lightgray"
  >
    <div class="gradient-circle-wrap">
      <div class="gradient-circle"></div>
    </div>
    <div class="container">
      <div class="row">
        <div class="col-markdown">
          <h1>加入 GOSIM Paris 2026 志愿者团队</h1>
          <div class="volunteer-cta-wrap">
            <a class="volunteer-cta" href="https://docs.google.com/forms/d/e/1FAIpQLSc62kJczw7lr-l0JAAbkabeIrrPPAD7OWyzwDopTD0L4HC6EQ/viewform" target="_blank">志愿者报名</a>
          </div>
          <img src="/images/homepage/paris_2025_crowd2.png" alt="GOSIM Paris 2025" class="volunteer-photo" />
          <Content />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .volunteer-cta-wrap {
    margin: 0.5rem 0 2rem;
  }
  .volunteer-cta {
    display: inline-block;
    padding: 0.7rem 1.8rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #333 !important;
    background: transparent;
    border: 2px solid #333;
    border-radius: 50px;
    text-decoration: none !important;
    cursor: pointer;
    box-shadow: 0 3px 8px rgba(0,0,0,0.2);
    transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }
  .col-markdown {
    display: block !important;
  }
  .volunteer-photo {
    float: right;
    width: 45%;
    margin: 0 0 1.5rem 1.5rem;
    border-radius: 12px;
  }
  @media (max-width: 600px) {
    .volunteer-photo {
      float: none;
      width: 100%;
      margin: 0 0 1.5rem 0;
    }
  }
  .volunteer-cta:hover {
    background: #333;
    color: #fff !important;
    transform: translateY(-1px);
    box-shadow: 0 5px 14px rgba(0,0,0,0.3);
  }
</style>
