---
import Layout from "layouts/LayoutLandingZh.astro"
import HeroText from "components/HeroText.astro"
import VenueInfo from "components/VenueInfo.astro"
import GetTickets from "components/GetTickets.astro"
---

<Layout
  title="会场 – GOSIM Paris 2026"
  description="GOSIM Paris 2026 的会场信息"
  navBackground="lightgray"
>
  <HeroText title="会场" lightgray />

  <VenueInfo
    subtitle="GOSIM Paris 2026"
    title="STATION F"
    location="5 Parv. Alan Turing, 75013 Paris, France"
    image="/images/venue/station-f.jpg"
    text="STATION F 是全球最大的初创企业园区，容纳了超过1,000家初创企业和众多科技项目。它位于巴黎第十三区塞纳河畔，拥有一流的会议和活动设施。标志性的 Halle Freyssinet 建筑占地34,000平方米，配备现代化活动空间、高速Wi-Fi和出色的无障碍设施。"
    ctaButton={{
      text: "访问 STATION F",
      link: "https://stationf.co/",
      openInNewTab: true,
    }}
  >
    <div class="transport-strip">
      <div class="transport-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" fill="currentColor"/></svg>
        <span><strong>机场</strong> — 距CDG 28公里</span>
      </div>
      <div class="transport-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2c-4 0-8 .5-8 4v9.5C4 17.43 5.57 19 7.5 19L6 20.5v.5h2l2-2h4l2 2h2v-.5L16.5 19c1.93 0 3.5-1.57 3.5-3.5V6c0-3.5-4-4-8-4zM7.5 17c-.83 0-1.5-.67-1.5-1.5S6.67 14 7.5 14s1.5.67 1.5 1.5S8.33 17 7.5 17zm3.5-6H6V6h5v5zm2 0V6h5v5h-5zm3.5 6c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" fill="currentColor"/></svg>
        <span><strong>火车站</strong> — 距 Gare d'Austerlitz 0.5公里</span>
      </div>
      <div class="transport-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M17.8 2H6.2C4.44 2 3 3.44 3 5.2v12.6c0 1.76 1.44 3.2 3.2 3.2h11.6c1.76 0 3.2-1.44 3.2-3.2V5.2C21 3.44 19.56 2 17.8 2zM12 4c2.76 0 5 1.12 5 2.5S14.76 9 12 9 7 7.88 7 6.5 9.24 4 12 4zm0 15c-1.38 0-2.5-1.12-2.5-2.5S10.62 14 12 14s2.5 1.12 2.5 2.5S13.38 19 12 19zm5-7H7V7h10v5z" fill="currentColor"/></svg>
        <span><strong>地铁</strong> — 距 Chevaleret 站（6号线）0.2公里</span>
      </div>
      <div class="transport-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 16c0 .88.39 1.67 1 2.22V20c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h8v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1.78c.61-.55 1-1.34 1-2.22V6c0-3.5-3.58-4-8-4s-8 .5-8 4v10zm3.5 1c-.83 0-1.5-.67-1.5-1.5S6.67 14 7.5 14s1.5.67 1.5 1.5S8.33 17 7.5 17zm9 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm1.5-6H6V6h12v5z" fill="currentColor"/></svg>
        <span><strong>公交</strong> — 27、64路，200米内</span>
      </div>
    </div>
  </VenueInfo>
  <!-- 附近酒店 -->
  <section
    class="section section-hotels"
    data-theme-section="light"
    data-bg-section="lightgray"
  >
    <div class="container">
      <h2 class="section-heading">附近酒店</h2>
      <p class="section-subheading">Station F 附近部分酒店推荐</p>

      <div class="hotels-layout">
        <!-- Map + Neighborhood info (left) -->
        <div class="hotels-map-col">
          <div class="map-sticky">
            <div id="hotel-map" style="width:100%; height:400px; border-radius:12px; border:1px solid #d5d5c2;"></div>
          </div>
          <div class="neighborhood-cards">
            <h3 class="neighborhood-heading">周边街区</h3>
            <div class="neighborhood-card" style="border-left: 3px solid #16a34a;">
              <h4>火车站区</h4>
              <p>Station F 所在区域，以法国国家图书馆为地标。这是一个现代化、适合步行的街区，拥有河滨步道、影院，以及 Tolbiac 路沿线日益丰富的餐饮选择。地铁14号线和 RER C 线交通便利。</p>
            </div>
            <div class="neighborhood-card" style="border-left: 3px solid #9333ea;">
              <h4>Bercy / 里昂火车站</h4>
              <p>塞纳河对岸的 Bercy Village 拥有鹅卵石街道，两旁是由旧石仓库改建的餐厅、商店和酒吧。该区域坐落着雅高体育馆和 Bercy 公园——从 Station F 步行或乘一站地铁即可到达。</p>
            </div>
            <div class="neighborhood-card" style="border-left: 3px solid #ea580c;">
              <h4>意大利广场</h4>
              <p>第13区的主要交通枢纽，距 Station F 步行即可到达。广场周围有商店、影院和餐厅，地铁交通便利（5、6、7号线）。这里是连接会场与巴黎其他地区的活力中心。</p>
            </div>
            <div class="neighborhood-card" style="border-left: 3px solid #0891b2;">
              <h4>巴黎唐人街</h4>
              <p>巴黎最大的亚洲街区，以 Avenue de Choisy 和 Avenue d'Ivry 为中心。这里汇集了正宗的中餐、越南菜和泰国菜餐厅，还有亚洲超市和奶茶店——是会场附近享用实惠美食的好去处。</p>
            </div>
          </div>
        </div>

        <!-- Hotels (right 2/3) -->
        <div class="hotels-list-col">
          <div class="hotel-item">
            <div class="hotel-info">
              <h3>Hôtel Le Richemont <span class="hotel-stars">★★★</span></h3>
              <span class="hotel-meta"><strong>~350m</strong> · 17 Rue Jean Colly · 紧邻 Station F，第13区</span>
            </div>
            <a class="hotel-link" href="https://www.hotel-richemont.com/en/" target="_blank" rel="noopener noreferrer">官网</a>
          </div>
          <div class="hotel-item">
            <div class="hotel-info">
              <h3>Mercure Paris Bercy Bibliothèque <span class="hotel-stars">★★★★</span></h3>
              <span class="hotel-meta"><strong>~500m</strong> · 6 Bd Vincent Auriol · 雅高酒店，塞纳河景</span>
            </div>
            <a class="hotel-link" href="https://all.accor.com/hotel/0934/index.en.shtml" target="_blank" rel="noopener noreferrer">官网</a>
          </div>
          <div class="hotel-item">
            <div class="hotel-info">
              <h3>ibis Styles Paris Tolbiac Bibliothèque <span class="hotel-stars">★★★</span></h3>
              <span class="hotel-meta"><strong>~650m</strong> · 21 Rue de Tolbiac · 含早餐</span>
            </div>
            <a class="hotel-link" href="https://all.accor.com/hotel/7976/index.en.shtml" target="_blank" rel="noopener noreferrer">官网</a>
          </div>
          <div class="hotel-item">
            <div class="hotel-info">
              <h3>Hôtel Sanso by HappyCulture <span class="hotel-stars">★★★</span></h3>
              <span class="hotel-meta"><strong>~650m</strong> · 15 Rue de Tolbiac · 近国家图书馆，地铁14号线</span>
            </div>
            <a class="hotel-link" href="https://www.hotel-sanso.com/en/" target="_blank" rel="noopener noreferrer">官网</a>
          </div>
          <div class="hotel-item">
            <div class="hotel-info">
              <h3>Citadines Austerlitz Paris <span class="hotel-stars">★★★</span></h3>
              <span class="hotel-meta"><strong>~900m</strong> · 27 Rue Esquirol · 公寓式酒店，配厨房</span>
            </div>
            <a class="hotel-link" href="https://www.discoverasr.com/en/citadines/france/citadines-austerlitz-paris" target="_blank" rel="noopener noreferrer">官网</a>
          </div>
          <div class="hotel-item">
            <div class="hotel-info">
              <h3>Urban Bivouac Hôtel <span class="hotel-stars">★★★</span></h3>
              <span class="hotel-meta"><strong>~1 km</strong> · 1 Rue Sthrau · 精品酒店，近地铁14号线</span>
            </div>
            <a class="hotel-link" href="https://www.ubparis.com" target="_blank" rel="noopener noreferrer">官网</a>
          </div>
          <div class="hotel-item">
            <div class="hotel-info">
              <h3>Novotel Paris Centre Bercy <span class="hotel-stars">★★★★</span></h3>
              <span class="hotel-meta"><strong>~1 km</strong> · 85 Rue de Bercy · 雅高酒店，近 Bercy Village</span>
            </div>
            <a class="hotel-link" href="https://all.accor.com/hotel/0935/index.en.shtml" target="_blank" rel="noopener noreferrer">官网</a>
          </div>
          <div class="hotel-item">
            <div class="hotel-info">
              <h3>Jack's Hotel <span class="hotel-stars">★★★</span></h3>
              <span class="hotel-meta"><strong>~1.1 km</strong> · 19 Av. Stephen Pichon · 环保酒店</span>
            </div>
            <a class="hotel-link" href="https://www.jacks-hotel.com" target="_blank" rel="noopener noreferrer">官网</a>
          </div>
          <div class="hotel-item">
            <div class="hotel-info">
              <h3>Pullman Paris Centre Bercy <span class="hotel-stars">★★★★</span></h3>
              <span class="hotel-meta"><strong>~1.1 km</strong> · 1 Rue de Libourne · 雅高高档酒店，近 Arena</span>
            </div>
            <a class="hotel-link" href="https://all.accor.com/hotel/2192/index.en.shtml" target="_blank" rel="noopener noreferrer">官网</a>
          </div>
          <div class="hotel-item">
            <div class="hotel-info">
              <h3>Courtyard by Marriott <span class="hotel-stars">★★★★</span></h3>
              <span class="hotel-meta"><strong>~1.2 km</strong> · 209 Rue de Bercy · 万豪酒店，近里昂火车站</span>
            </div>
            <a class="hotel-link" href="https://www.marriott.com/en-us/hotels/pargl-courtyard-paris-gare-de-lyon/overview/" target="_blank" rel="noopener noreferrer">官网</a>
          </div>
          <div class="hotel-item">
            <div class="hotel-info">
              <h3>citizenM Paris Gare de Lyon <span class="hotel-stars">★★★★</span></h3>
              <span class="hotel-meta"><strong>~1.2 km</strong> · 8 Rue Van Gogh · 现代设计酒店，近里昂火车站</span>
            </div>
            <a class="hotel-link" href="https://www.citizenm.com/hotels/europe/paris/paris-gare-de-lyon-hotel" target="_blank" rel="noopener noreferrer">官网</a>
          </div>
          <div class="hotel-item">
            <div class="hotel-info">
              <h3>Hôtel La Manufacture <span class="hotel-stars">★★★</span></h3>
              <span class="hotel-meta"><strong>~1.3 km</strong> · 8 Rue Philippe de Champagne · 左岸精品酒店，近地铁7号线</span>
            </div>
            <a class="hotel-link" href="https://www.hotel-la-manufacture.com/en/" target="_blank" rel="noopener noreferrer">官网</a>
          </div>
          <div class="hotel-item">
            <div class="hotel-info">
              <h3>Mercure Paris Place d'Italie <span class="hotel-stars">★★★★</span></h3>
              <span class="hotel-meta"><strong>~1.3 km</strong> · 25 Bd Auguste Blanqui · 雅高酒店，近意大利广场</span>
            </div>
            <a class="hotel-link" href="https://all.accor.com/hotel/1188/index.en.shtml" target="_blank" rel="noopener noreferrer">官网</a>
          </div>
          <div class="hotel-item">
            <div class="hotel-info">
              <h3>Hôtel Marguerite <span class="hotel-stars">★★★</span></h3>
              <span class="hotel-meta"><strong>~1.5 km</strong> · 102 Avenue de Choisy · 精品酒店，第13区</span>
            </div>
            <a class="hotel-link" href="https://www.hotelmargueriteparis.com/" target="_blank" rel="noopener noreferrer">官网</a>
          </div>
        </div>
      </div>
      <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
      <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
      <script is:inline>
        document.addEventListener('DOMContentLoaded', function() {
          var map = L.map('hotel-map', { scrollWheelZoom: false }).setView([48.8340, 2.3700], 14);
          L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
            maxZoom: 18
          }).addTo(map);
          var venueIcon = L.divIcon({ html: '<div style="display:flex;flex-direction:column;align-items:center;"><div style="background:#dc2626;color:#fff;font-weight:700;padding:4px 10px;border-radius:6px;font-size:12px;white-space:nowrap;box-shadow:0 2px 6px rgba(0,0,0,.3);margin-bottom:4px;">STATION F</div><div style="width:0;height:0;border-left:6px solid transparent;border-right:6px solid transparent;border-top:8px solid #dc2626;"></div></div>', className: 'leaflet-div-icon-clean', iconSize: [100, 40], iconAnchor: [50, 40] });
          var hotelIcon = L.divIcon({ html: '<div style="background:#2563eb;color:#fff;width:20px;height:20px;border-radius:50%;border:3px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.4);"></div>', className: '', iconSize: [26, 26], iconAnchor: [13, 13] });
          L.marker([48.8345, 2.3709], { icon: venueIcon }).addTo(map).bindPopup('<b>STATION F</b><br>5 Parv. Alan Turing, 75013 Paris');
          var hotels = [
            [48.8374, 2.3730, 'Mercure Paris Bercy Bibliothèque ★★★★', '6 Bd Vincent Auriol', 'https://all.accor.com/hotel/0934/index.en.shtml'],
            [48.8290, 2.3740, 'ibis Styles Paris Tolbiac Bibliothèque ★★★', '21 Rue de Tolbiac', 'https://all.accor.com/hotel/7976/index.en.shtml'],
            [48.8273, 2.3669, 'Urban Bivouac Hôtel ★★★', '1 Rue Sthrau', 'https://www.ubparis.com'],
            [48.8329, 2.3591, "Jack's Hotel ★★★", '19 Av. Stephen Pichon', 'https://www.jacks-hotel.com'],
            [48.8329, 2.3554, 'Hôtel La Manufacture ★★★', '8 Rue Philippe de Champagne', 'https://www.hotel-la-manufacture.com/en/'],
            [48.8349, 2.3603, 'Citadines Austerlitz Paris ★★★', '27 Rue Esquirol', 'https://www.discoverasr.com/en/citadines/france/citadines-austerlitz-paris'],
            [48.8387, 2.3804, 'Novotel Paris Centre Bercy ★★★★', '85 Rue de Bercy', 'https://all.accor.com/hotel/0935/index.en.shtml'],
            [48.8314, 2.3871, 'Pullman Paris Centre Bercy ★★★★', '1 Rue de Libourne', 'https://all.accor.com/hotel/2192/index.en.shtml'],
            [48.8440, 2.3796, 'Courtyard by Marriott ★★★★', '209 Rue de Bercy', 'https://www.marriott.com/en-us/hotels/pargl-courtyard-paris-gare-de-lyon/overview/'],
            [48.8318, 2.3680, 'Hôtel Le Richemont ★★★', '17 Rue Jean Colly', 'https://www.hotel-richemont.com/en/'],
            [48.8295, 2.3730, 'Hôtel Sanso by HappyCulture ★★★', '15 Rue de Tolbiac', 'https://www.hotel-sanso.com/en/'],
            [48.8415, 2.3735, 'citizenM Paris Gare de Lyon ★★★★', '8 Rue Van Gogh', 'https://www.citizenm.com/hotels/europe/paris/paris-gare-de-lyon-hotel'],
            [48.8310, 2.3510, "Mercure Paris Place d'Italie ★★★★", '25 Bd Auguste Blanqui', 'https://all.accor.com/hotel/1188/index.en.shtml'],
            [48.8255, 2.3580, 'Hôtel Marguerite ★★★', '102 Avenue de Choisy', 'https://www.hotelmargueriteparis.com/']
          ];
          hotels.forEach(function(h) { L.marker([h[0], h[1]], { icon: hotelIcon }).addTo(map).bindPopup('<b>' + h[2] + '</b><br>' + h[3] + '<br><a href="' + h[4] + '" target="_blank" rel="noopener noreferrer">官网</a>'); });
          var neighborhoods = [
            { center: [48.8305, 2.3755], name: '火车站区', color: '#16a34a' },
            { center: [48.8400, 2.3820], name: 'Bercy / 里昂火车站', color: '#9333ea' },
            { center: [48.8312, 2.3558], name: '意大利广场', color: '#ea580c' },
            { center: [48.8265, 2.3615], name: '巴黎唐人街', color: '#0891b2' }
          ];
          var hoodLabelStyle = 'font-size:11px;font-weight:700;padding:2px 8px;border-radius:4px;color:#fff;opacity:0.85;text-align:center;width:140px;';
          neighborhoods.forEach(function(n) {
            L.circle(n.center, { radius: 350, color: n.color, fillColor: n.color, fillOpacity: 0.06, weight: 1.5, opacity: 0.4, dashArray: '6 4' }).addTo(map);
            var icon = L.divIcon({ html: '<div style="' + hoodLabelStyle + 'background:' + n.color + ';transform:translate(-50%,-50%);">' + n.name + '</div>', className: 'leaflet-div-icon-clean', iconSize: null, iconAnchor: [0, 0] });
            L.marker(n.center, { icon: icon, interactive: false }).addTo(map);
          });
        });
      </script>
    </div>
  </section>

  <GetTickets
    title="立即获取 GOSIM Paris 门票"
    location="法国巴黎"
    date="2026年5月5-6日"
    text="立即确保您在 GOSIM Paris 2026 的席位。与创新者合作，与行业先驱交流，成为塑造开源技术未来的一部分。"
    ctaButton={{
      text: "立即购票",
      link: "https://gosimparis2026.eventbrite.com/",
      openInNewTab: true,
    }}
  />
</Layout>

<style is:global>
  /* Leaflet custom icon fix */
  .leaflet-div-icon-clean {
    background: none !important;
    border: none !important;
  }

  /* Transport Strip */
  .transport-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #d5d5c2;
  }

  .transport-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--color-text);
  }

  .transport-item svg {
    flex-shrink: 0;
    color: var(--color-dark);
  }

  .section-hotels {
    padding-top: 1.5rem !important;
  }

  .section-heading {
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .section-subheading {
    text-align: center;
    font-size: 0.95rem;
    color: #777;
    margin-bottom: 2.5rem;
  }

  /* Hotels Layout - Map left, list right */
  .hotels-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .hotels-map-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .map-sticky {
    position: sticky;
    top: calc(var(--nav-bar-height) + 1rem);
    border-radius: 12px;
    overflow: hidden;
    z-index: 1;
  }

  .neighborhood-cards {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .neighborhood-heading {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0.5rem 0 0;
  }

  .neighborhood-card {
    padding: 1rem 1.25rem;
    background: #fff;
    border-radius: 10px;
    border: 1px solid #e5e5dc;
  }

  .neighborhood-card h4 {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0 0 0.4rem;
  }

  .neighborhood-card p {
    font-size: 0.85rem;
    line-height: 1.55;
    color: #555;
    margin: 0;
  }

  .hotels-list-col {
    display: flex;
    flex-direction: column;
  }

  .hotel-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid #e5e5dc;
  }

  .hotel-item:first-child {
    padding-top: 0;
  }

  .hotel-item:last-child {
    border-bottom: none;
  }

  .hotel-info {
    flex: 1;
    min-width: 0;
  }

  .hotel-info h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.2rem;
    line-height: 1.3;
  }

  .hotel-stars {
    font-size: 0.8rem;
    color: #d4a017;
    font-weight: 400;
    letter-spacing: 1px;
