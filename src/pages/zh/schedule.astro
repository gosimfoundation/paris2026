---
// Components
import Layout from "layouts/LayoutLandingZh.astro";
import GetTickets from "components/GetTickets.astro";
import HeroText from "components/HeroText.astro";
import ScheduleTracks from "components/ScheduleTracks.astro";
---

<Layout
  title="日程安排 – GOSIM Paris 2026"
  description="GOSIM Paris 2026 是开源AI项目、开发者、研究人员和行业赞助商的聚会，旨在分享知识、相互学习和协作。"
  navBackground="light"
  pageTransitionName="5月5日"
>
  <HeroText title="议程安排" lightgray />

  <ScheduleTracks currentDay="May 5" lang="zh" speakerBasePath="/zh/speakers/" />

  <GetTickets
    title="获取您的GOSIM Paris门票"
    location="巴黎"
    date="2026年5月4-6日"
    text="立即预订您在GOSIM Paris 2026的席位。与创新者协作，与行业先锋交流，参与塑造开源技术的未来。"
    ctaButton={{
      text: "立即购票",
      link: "https://gosimparis2026.eventbrite.com/",
      openInNewTab: true,
    }}
  />
</Layout>
