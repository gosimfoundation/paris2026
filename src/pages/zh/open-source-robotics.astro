---
import Layout from "layouts/LayoutLandingZh.astro";
import OpenArmViewer from "components/OpenArmViewer.astro";
---

<Layout
  title="开源机器人舞台 - GOSIM Paris 2026"
  description="在 GOSIM Paris 2026 的互动开放舞台上，亲手体验真正的开源机器人。"
  navDarkMode={true}
  navBackground="header-home"
>
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-background">
        <div class="hero-gradient"></div>
        <OpenArmViewer />
      </div>
      <div class="hero-content">
        <div class="hero-badges">
          <span class="badge">GOSIM Paris 2026</span>
          <span class="badge">互动体验</span>
          <span class="badge">开源</span>
        </div>
        <h1 class="hero-title">开源机器人舞台</h1>
        <p class="hero-subtitle">看得见，摸得着，自己造。机器人的未来是开源的。</p>
        <div class="hero-intro">
          <h2>近距离体验开源机器人</h2>
          <p>
            开源机器人舞台是一个开放的互动区域，参会者可以亲眼看到、亲手触摸并与真正的开源机器人互动。从行走的双足机器人到灵巧的机械手、机械臂和自主导航平台——在这里，你将零距离体验开源机器人技术的最前沿。
          </p>
          <p>
            许多展示的机器人都可以亲手操作，让你有机会亲身体验。除了互动演示之外，还有深入的技术演讲，介绍项目的架构设计和背后的开源社区。
          </p>
        </div>
      </div>
    </section>

    <!-- Workshop Category Rows -->
    <section class="categories-section">
      <div class="container">
        <h2>工作坊类别</h2>
        <div class="categories-list">

          <div class="category-row" style="--accent: #6366f1; --accent-light: #818cf8;">
            <div class="category-scene" data-scene="legs">
              <div class="scene-placeholder">
                <span class="scene-icon">🦿</span>
              </div>
            </div>
            <div class="category-info">
              <span class="category-number">01</span>
              <h3>开源腿部机器人</h3>
              <p>人形运动、行走机器人和多足平台。观看开源双足和四足机器人迈出步伐——并了解如何构建你自己的。</p>
            </div>
          </div>

          <div class="category-row" style="--accent: #3b82f6; --accent-light: #60a5fa;">
            <div class="category-scene" data-scene="hands">
              <div class="scene-placeholder">
                <span class="scene-icon">🤲</span>
              </div>
            </div>
            <div class="category-info">
              <span class="category-number">02</span>
              <h3>开源手部与夹爪</h3>
              <p>灵巧操作、机械手和自适应夹爪。看看开源硬件和软件如何结合，赋予机器人触觉和精细运动控制能力。</p>
            </div>
          </div>

          <div class="category-row" style="--accent: #10b981; --accent-light: #34d399;">
            <div class="category-scene" data-scene="arms">
              <div class="scene-placeholder">
                <span class="scene-icon">🦾</span>
              </div>
            </div>
            <div class="category-info">
              <span class="category-number">03</span>
              <h3>开源机械臂</h3>
              <p>用于远程操控、抓取和自动化的机械臂。从桌面级操作器到全尺寸工业机械臂——全部开源，全部可自由改造。</p>
            </div>
          </div>

          <div class="category-row" style="--accent: #f59e0b; --accent-light: #fbbf24;">
            <div class="category-scene" data-scene="navigation">
              <div class="scene-placeholder">
                <span class="scene-icon">🧭</span>
              </div>
            </div>
            <div class="category-info">
              <span class="category-number">04</span>
              <h3>开源导航</h3>
              <p>自主移动机器人、巡检车和自动驾驶平台。探索开源技术栈如何驱动机器人感知、建图和导航周围世界。</p>
            </div>
          </div>

          <div class="category-row" style="--accent: #ec4899; --accent-light: #f472b6;">
            <div class="category-scene" data-scene="haptics">
              <div class="scene-placeholder">
                <span class="scene-icon">🖐️</span>
              </div>
            </div>
            <div class="category-info">
              <span class="category-number">05</span>
              <h3>开源触觉技术</h3>
              <p>触觉反馈、触觉传感和力反馈接口。感受机器人所感——体验下一代开源感知技术。</p>
            </div>
          </div>

          <div class="category-row" style="--accent: #8b5cf6; --accent-light: #a78bfa;">
            <div class="category-scene" data-scene="simulation">
              <div class="scene-placeholder">
                <span class="scene-icon">🖥️</span>
              </div>
            </div>
            <div class="category-info">
              <span class="category-number">06</span>
              <h3>仿真模拟</h3>
              <p>用于机器人开发和测试的物理仿真环境。了解开源仿真器如何在硬件就位之前加速机器人研究。</p>
            </div>
          </div>

          <div class="category-row" style="--accent: #06b6d4; --accent-light: #22d3ee;">
            <div class="category-scene" data-scene="companion">
              <div class="scene-placeholder">
                <span class="scene-icon">🤖</span>
              </div>
            </div>
            <div class="category-info">
              <span class="category-number">07</span>
              <h3>陪伴机器人</h3>
              <p>社交机器人、互动伙伴和消费级机器人产品。认识那些为日常生活而设计的友好开源机器人。</p>
            </div>
          </div>

          <div class="category-row" style="--accent: #ef4444; --accent-light: #f87171;">
            <div class="category-scene" data-scene="humanoids">
              <div class="scene-placeholder">
                <span class="scene-icon">🧑</span>
              </div>
            </div>
            <div class="category-info">
              <span class="category-number">08</span>
              <h3>开源人形机器人</h3>
              <p>将腿、臂、手和大脑融为一体的全身人形机器人。从开源硬件平台到模仿学习框架——构建完整的人形机器人技术栈。</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Call to Action Section with Video -->
    <section class="cta-video-section">
      <div class="cta-video-background">
        <video
          autoplay
          loop
          muted
          playsinline
          webkit-playsinline
          poster="/videos/paris-hero-bk.jpg"
          onloadstart="this.playbackRate=0.25"
        >
          <source src="/videos/paris-hero-compressed.mp4" type="video/mp4" />
        </video>
        <div class="cta-video-overlay"></div>
      </div>
      <div class="cta-video-content">
        <h2>有兴趣演讲或展示？</h2>
        <p>
          我们正在寻找优秀的开源机器人项目登上舞台——无论是现场演示、技术演讲还是互动工作坊。如果你正在从事令人兴奋的开源机器人项目，我们期待你的参与。
        </p>
        <a href="https://cfp.gosim.org/" target="_blank" rel="noopener noreferrer" class="cta-button">
          提交演讲提案
        </a>
      </div>
    </section>

</Layout>

<style>
  /* Hero Section */
  .hero-section {
    position: relative;
    min-height: 500px;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .hero-gradient {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 40%, #0e7aff 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(20px, 6vw, 64px);
    padding-top: clamp(80px, 12vw, 140px);
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .badge {
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    padding: 6px 12px;
    font-weight: 600;
    color: #fff;
    font-size: 14px;
  }

  .hero-title {
    font-size: clamp(28px, 4.2vw, 60px);
    line-height: 1.08;
    margin: 0.2em 0;
    font-weight: 700;
    color: #fff;
  }

  .hero-subtitle {
    color: rgba(255, 255, 255, 0.8);
    font-size: clamp(16px, 1.4vw, 20px);
    margin: 0;
  }

  .hero-intro {
    margin-top: 2rem;
    max-width: 800px;
  }

  .hero-intro h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: #fff;
    text-align: left;
  }

  .hero-intro p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  /* Common */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(20px, 5vw, 60px);
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    color: #0f172a;
    text-align: left;
  }

  /* Categories Section */
  .categories-section {
    padding: 60px 0;
    background: #0f172a;
  }

  .categories-section h2 {
    color: #fff;
  }

  .categories-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 20px;
    overflow: hidden;
  }

  .category-row {
    display: grid;
    grid-template-columns: 280px 1fr;
    background: rgba(15, 23, 42, 0.95);
    transition: background 0.4s ease;
    cursor: default;
  }

  .category-row:hover {
    background: rgba(30, 41, 59, 0.95);
  }

  /* Scene area — future Three.js container */
  .category-scene {
    position: relative;
    min-height: 180px;
    overflow: hidden;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 15%, transparent), color-mix(in srgb, var(--accent-light) 8%, transparent));
  }

  .scene-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .scene-icon {
    font-size: 4rem;
    filter: grayscale(0.3);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.4s ease;
  }

  .category-row:hover .scene-icon {
    transform: scale(1.15);
    filter: grayscale(0);
  }

  /* Info area */
  .category-info {
    padding: 2rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    border-left: 1px solid rgba(255, 255, 255, 0.06);
  }

  .category-number {
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
    color: var(--accent-light);
    opacity: 0.7;
  }

  .category-info h3 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #fff;
    margin: 0;
    letter-spacing: -0.01em;
    transition: color 0.3s ease;
  }

  .category-row:hover .category-info h3 {
    color: var(--accent-light);
  }

  .category-info p {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.92rem;
    line-height: 1.65;
    margin: 0;
    max-width: 540px;
    transition: color 0.3s ease;
  }

  .category-row:hover .category-info p {
    color: rgba(255, 255, 255, 0.7);
  }

  /* CTA Video Section */
  .cta-video-section {
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .cta-video-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .cta-video-background video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta-video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(14, 23, 42, 0.9) 0%, rgba(30, 58, 95, 0.75) 50%, rgba(14, 122, 255, 0.6) 100%);
  }

  .cta-video-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 700px;
    padding: clamp(40px, 8vw, 80px) clamp(20px, 5vw, 60px);
  }

  .cta-video-content h2 {
    color: #fff;
    text-align: center;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .cta-video-content p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .cta-button {
    display: inline-block;
    background: #0e7aff;
    color: #fff;
    padding: 14px 36px;
    border-radius: 999px;
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .cta-button:hover {
    background: #0b63d1;
    transform: translateY(-2px);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .category-row {
      grid-template-columns: 1fr;
    }

    .category-scene {
      min-height: 120px;
    }

    .category-info {
      border-left: none;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      padding: 1.5rem;
    }
  }
</style>
