---
import Layout from "layouts/LayoutLandingZh.astro";
import OpenArmViewer from "components/OpenArmViewer.astro";
import BipedalViewer from "components/BipedalViewer.astro";
---

<Layout
  title="开源机器人工作坊 - GOSIM Paris 2026"
  description="在 GOSIM Paris 2026 的开源机器人工作坊中，亲手体验真正的开源机器人。"
  navDarkMode={true}
  navBackground="header-home"
>
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-background">
        <div class="hero-gradient"></div>
        <div class="viewer-left">
          <OpenArmViewer />
        </div>
        <div class="viewer-right">
          <BipedalViewer />
        </div>
      </div>
      <div class="hero-content">
        <h1 class="hero-title">开源机器人工作坊</h1>
        <p class="hero-details">2026年5月5-6日 &middot; STATION F，巴黎</p>

        <div class="hero-people">
          <div class="hero-people-group">
            <h3>演讲嘉宾</h3>
            <div class="hero-people-row">
              <a href="https://github.com/CarolinePascal" target="_blank" rel="noopener noreferrer" class="person-card">
                <img src="/images/speakers/caroline-pascal.jpg" alt="Caroline Pascal" class="person-photo" />
                <span class="person-name">Caroline Pascal</span>
                <span class="person-role">LeRobot 维护者</span>
              </a>
              <a href="https://github.com/Virgileboat" target="_blank" rel="noopener noreferrer" class="person-card">
                <img src="/images/speakers/virgile-batto.jpg" alt="Virgile Batto" class="person-photo" />
                <span class="person-name">Virgile Batto</span>
                <span class="person-role">HF 足式机器人</span>
              </a>
              <a href="https://cfp.gosim.org/" target="_blank" rel="noopener noreferrer" class="person-card person-card-cta">
                <span class="person-photo person-photo-cta">?</span>
                <span class="person-name">你？</span>
                <span class="person-role">提交演讲提案</span>
              </a>
            </div>
          </div>
          <div class="hero-people-group">
            <h3>组织者</h3>
            <div class="hero-people-row">
              <a href="https://github.com/haixuanTao" target="_blank" rel="noopener noreferrer" class="person-card">
                <img src="/images/speakers/haixuan-tao.jpg" alt="Haixuan Xavier Tao" class="person-photo" />
                <span class="person-name">Haixuan Xavier Tao</span>
                <span class="person-role">1ms.ai 创始人</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Call for Proposals Section -->
    <section class="cfp-section">
      <div class="container">
        <h2>征稿主题</h2>
        <p class="cfp-intro">工作坊为期2天，共约20场演讲（10分钟演讲 + 5-10分钟问答），并设有专门的演示环节。我们欢迎以下主题的投稿（包括但不限于）：</p>
        <div class="cfp-categories">
          <div class="cfp-category">
            <h3>开源机器人硬件</h3>
            <ul class="cfp-topics">
              <li>开源执行器、传感器和末端执行器</li>
              <li>开源机械臂、灵巧手和夹爪</li>
              <li>开源足式和轮式移动平台</li>
              <li>开源人形机器人设计</li>
              <li>模块化和可重构硬件架构</li>
            </ul>
          </div>
          <div class="cfp-category">
            <h3>开源学习与控制</h3>
            <ul class="cfp-topics">
              <li>开源模仿学习与示教学习</li>
              <li>开源强化学习用于操作和运动</li>
              <li>开源导航与SLAM</li>
              <li>开源真实世界模型与机器人世界模型</li>
              <li>开源运动规划与控制框架</li>
              <li>面向未知物体、环境和任务的泛化能力</li>
            </ul>
          </div>
          <div class="cfp-category">
            <h3>开源基础设施</h3>
            <ul class="cfp-topics">
              <li>开源仿真环境与物理引擎</li>
              <li>开源可视化与调试工具</li>
              <li>开源机器人中间件与通信框架</li>
              <li>开源部署与编排工具</li>
            </ul>
          </div>
          <div class="cfp-category">
            <h3>开源数据与基准测试</h3>
            <ul class="cfp-topics">
              <li>开源数据采集管线与遥操作系统</li>
              <li>开源机器人数据集与数据格式</li>
              <li>开源操作、导航和运动基准测试</li>
              <li>用于训练机器人基础模型的互联网规模数据</li>
            </ul>
          </div>
          <div class="cfp-category">
            <h3>挑战与局限</h3>
            <ul class="cfp-topics">
              <li>开源机器人的可复现性与标准化</li>
              <li>仿真到真实的迁移差距与失败模式</li>
              <li>开源系统的安全性、鲁棒性与可靠性</li>
              <li>从稀缺或噪声数据中引导学习</li>
            </ul>
          </div>
        </div>
        <h3 class="cfp-dates-title">重要日期</h3>
        <ul class="cfp-dates">
          <li><strong>投稿截止：</strong>2026年3月</li>
          <li><strong>录用通知：</strong>2026年4月</li>
          <li><strong>工作坊：</strong>2026年5月5-6日</li>
        </ul>
        <a href="https://cfp.gosim.org/" target="_blank" rel="noopener noreferrer" class="cta-button">
          提交演讲提案
        </a>
      </div>
    </section>

    <!-- Speakers & Organizers Section -->
    <section class="people-section">
      <div class="container">
        <h2>特邀嘉宾</h2>
        <div class="people-grid">
          <a href="https://github.com/CarolinePascal" target="_blank" rel="noopener noreferrer" class="person-card">
            <img src="/images/speakers/caroline-pascal.jpg" alt="Caroline Pascal" class="person-photo" />
            <h3>Caroline Pascal</h3>
            <p>LeRobot 维护者</p>
          </a>
          <a href="https://github.com/Virgileboat" target="_blank" rel="noopener noreferrer" class="person-card">
            <img src="/images/speakers/virgile-batto.jpg" alt="Virgile Batto" class="person-photo" />
            <h3>Virgile Batto</h3>
            <p>HF 足式机器人</p>
          </a>
        </div>

        <h2>组织者</h2>
        <div class="people-grid">
          <a href="https://github.com/haixuanTao" target="_blank" rel="noopener noreferrer" class="person-card">
            <img src="/images/speakers/haixuan-tao.jpg" alt="Haixuan Xavier Tao" class="person-photo" />
            <h3>Haixuan Xavier Tao</h3>
            <p>1ms.ai 创始人</p>
          </a>
        </div>
      </div>
    </section>

    <!-- Venue Section -->
    <section class="venue-section">
      <div class="venue-background">
        <img src="/images/central-room.webp" alt="STATION F - Central Room" />
        <div class="venue-overlay"></div>
      </div>
      <div class="venue-content">
        <h2>场地</h2>
        <h3>STATION F — Central Room，巴黎</h3>
        <p>工作坊在全球最大的创业园区STATION F举办，位于其中的Central Room——一个可容纳70人的精致空间，适合演讲、演示和面对面交流。</p>
        <a href="https://cfp.gosim.org/" target="_blank" rel="noopener noreferrer" class="cta-button">
          提交演讲提案
        </a>
      </div>
    </section>

</Layout>

<style>
  /* Hero Section */
  .hero-section {
    position: relative;
    min-height: 500px;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .hero-gradient {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 40%, #0e7aff 100%);
  }

  .viewer-left {
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
  }

  .viewer-right {
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
  }

  @media (max-width: 768px) {
    .viewer-right {
      display: none;
    }
    .viewer-left {
      width: 100%;
    }
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(20px, 6vw, 64px);
    padding-top: clamp(80px, 12vw, 140px);
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .badge {
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    padding: 6px 12px;
    font-weight: 600;
    color: #fff;
    font-size: 14px;
  }

  .hero-title {
    font-size: clamp(28px, 4.2vw, 60px);
    line-height: 1.08;
    margin: 0.2em 0;
    font-weight: 700;
    color: #fff;
  }

  .hero-details {
    color: rgba(255, 255, 255, 0.7);
    font-size: clamp(16px, 1.4vw, 20px);
    margin: 0.5rem 0 0 0;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* Common */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(20px, 5vw, 60px);
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    color: #0f172a;
    text-align: left;
  }

  /* Call for Papers Section */
  .cfp-section {
    padding: 60px 0;
    background: #f8fafc;
  }

  .cfp-section h2 {
    color: #0f172a;
  }

  .cfp-intro {
    font-size: 1.15rem;
    color: #334155;
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .cfp-categories {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .cfp-category h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 1rem 0;
    border-left: 3px solid #0e7aff;
    padding-left: 0.75rem;
  }

  .cfp-topics {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-left: 0.75rem;
  }

  .cfp-topics li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.95rem;
    color: #475569;
    line-height: 1.6;
  }

  .cfp-topics li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #94a3b8;
  }

  .cfp-dates-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.75rem 0;
    border-left: 3px solid #0e7aff;
    padding-left: 0.75rem;
  }

  .cfp-dates {
    list-style: none;
    padding: 0 0 0 0.75rem;
    margin: 0 0 2.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cfp-dates li {
    font-size: 1rem;
    color: #334155;
    line-height: 1.6;
  }

  .cfp-dates strong {
    color: #0f172a;
  }

  /* Hero People */
  .hero-people {
    display: flex;
    gap: 3rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .hero-people-group h3 {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 0.75rem 0;
  }

  .hero-people-row {
    display: flex;
    gap: 1.5rem;
  }

  .person-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .person-card:hover {
    transform: translateY(-3px);
  }

  .person-photo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(255, 255, 255, 0.2);
    transition: border-color 0.2s ease;
  }

  .person-card:hover .person-photo {
    border-color: #0e7aff;
  }

  .person-photo-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(14, 122, 255, 0.2);
    border: 2px dashed rgba(14, 122, 255, 0.5);
    color: #0e7aff;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .person-card-cta:hover .person-photo-cta {
    background: rgba(14, 122, 255, 0.3);
    border-color: #0e7aff;
  }

  .person-name {
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: center;
  }

  .person-role {
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.75rem;
    text-align: center;
  }

  .person-card-cta .person-role {
    color: #0e7aff;
  }

  /* Venue Section */
  .venue-section {
    position: relative;
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #0e1729;
  }

  .venue-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .venue-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: blur(4px);
  }

  .venue-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(14, 40, 80, 0.6);
  }

  .venue-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 700px;
    padding: clamp(40px, 8vw, 80px) clamp(20px, 5vw, 60px);
  }

  .venue-content h2 {
    color: #fff;
    text-align: center;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .venue-content h3 {
    color: #60a5fa;
    font-size: 1.3rem;
    margin: 0 0 1rem 0;
  }

  .venue-content p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .cta-button {
    display: inline-block;
    background: #0e7aff;
    color: #fff;
    padding: 14px 36px;
    border-radius: 999px;
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .cta-button:hover {
    background: #0b63d1;
    transform: translateY(-2px);
  }

</style>
