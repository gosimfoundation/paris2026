---
// Components
import Layout from "layouts/LayoutLandingZh.astro";
import GetTickets from "components/GetTickets.astro";
import HeroText from "components/HeroText.astro";
import AllWorkshops from "components/WorkshopsZh.astro";
---

<Layout
  title="Workshops – GOSIM Paris 2025"
  description="GOSIM Paris 2025 is a gathering of open-source AI projects, developers, researchers, and industry sponsors to share knowledge, learn from each other, and collaborate."
  navBackground="light"
  pageTransitionName="Speakers"
>
  <HeroText
    title="工作坊 & 同期活动演讲嘉宾"
    text=""
    lightgray
  />

  <AllWorkshops />

  <GetTickets
    title="获取您的GOSIM Paris门票"
    location="巴黎"
    date="2026年5月5-6日"
    text="立即确保您在GOSIM Paris 2026的席位。与创新者合作，与行业先驱交流，成为塑造开源技术未来的一部分。"
    ctaButton={{
      text: "立即购票",
      link: "https://gosimparis2026.eventbrite.com/",
      openInNewTab: true,
    }}
  />
</Layout>
