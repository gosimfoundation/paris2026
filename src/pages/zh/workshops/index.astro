---
// Components
import Layout from "layouts/LayoutLandingZh.astro";
import GetTickets from "components/GetTickets.astro";
import HeroText from "components/HeroText.astro";
import AllWorkshops from "components/WorkshopsZh.astro";
---

<Layout
  title="Workshops – GOSIM Paris 2026"
  description="GOSIM Paris 2026 is a gathering of open-source AI projects, developers, researchers, and industry sponsors to share knowledge, learn from each other, and collaborate."
  navBackground="light"
  pageTransitionName="Speakers"
>
  <HeroText
    title="工作坊 & 同期活动演讲嘉宾"
    text=""
    lightgray
  />

  <AllWorkshops />

  <GetTickets
    title="GOSIM Paris 2026 已圆满结束"
    location="巴黎"
    date="2026年5月4-6日"
    text="感谢所有参加 GOSIM Paris 2026 的朋友们。这是一次汇聚创新者、行业先驱和开源爱好者的精彩盛会，共同塑造技术的未来。"
    ctaButton={{
      text: "活动已结束",
      link: "https://gosimparis2026.eventbrite.com/",
      openInNewTab: true,
    }}
  />
</Layout>
