---

<Layout
  title="GOSIM Paris 2026"
  description="GOSIM Paris 2026 — 智能体AI技术盛会。2026年5月4-6日，巴黎STATION F。"
  navDarkMode={true}
  navBackground="header-home"
  pageTransitionName="Home"
>
  <Hero
    date="2026年5月4-6日"
    location="STATION F, 巴黎"
    subtitle="智能体AI技术盛会"
    description="全球顶级开源项目、顶尖开发者、最新智能体技术前沿，将齐聚巴黎 STATION F，带来为期两天的开发者沉浸式体验。"
    links={[
      {
        text: "提交演讲提案",
        link: "https://cfp.gosim.org",
        openInNewTab: true,
      },
      {
        text: "立即购票",
        link: "https://gosimparis2026.eventbrite.com/",
        openInNewTab: true,
        class: "btn hero-ticket xl btn-hover fade-in-last",
      },
    ]}
  />

  <TextAndSponsors
    id="supporting-organizations"
    title="支持单位"
    text="GOSIM Paris 2026 获得多家顶级开源与 AI 组织的鼎力支持。"
    text2=""
    logoGroups={[
      {
        cols: 3,
        logos: [
          { image: "minimax-wide.png", imageAlt: "MiniMax" },
          { image: "modelbest.png", imageAlt: "ModelBest" },
          { image: "kimi-logo.png", imageAlt: "Kimi" },
          { image: "sgl.png", imageAlt: "SGLang" },
          { image: "vllm.png", imageAlt: "vLLM" },
          { image: "zai.png", imageAlt: "智谱 ZAI", logoClass: "m" },
        ],
      },
    ]}
  />

  <div
    class="section-wrap"
    id="intro"
    data-theme-section="light"
    data-bg-section="lightgray"
  >
    <div class="intro-statistics-container" style="">
      <Intro
        eyebrow="GOSIM PARIS 2026 / 5月4-6日 / STATION F"
        headlineLines={[
          "理解智能体 AI",
          "前沿正在发生什么",
          "就在 GOSIM，",
          "就在巴黎",
        ]}
        accentLine={1}
        body="全球顶级开源项目、顶尖开发者、最新智能体技术前沿，将齐聚巴黎 STATION F，带来为期两天的开发者沉浸式体验。"
        facetsTitle="大会现场"
        facets={[
          {
            title: "顶级项目",
            text: "llama.cpp、GLM、SGLang、vLLM 等代表性开源项目背后的团队都会在现场出现。",
          },
          {
            title: "多元讲者",
            text: "从 builder、研究者、创始人到基础设施工程师和开源维护者，覆盖不同地区与社区。",
          },
          {
            title: "最新动向",
            text: "聚焦智能体框架、MCP 类互操作、模型服务、边缘部署与生产系统等最新演进。",
          },
          {
            title: "开发者体验",
            text: "workshop、spotlight demo、hackathon 与全球参与者一起，构成欧洲极具辨识度的开源智能体 AI 会议现场。",
          },
        ]}
        signals={[
          "基础模型",
          "智能体框架",
          "模型服务",
          "边缘部署",
          "生产系统",
        ]}
        projectsLabel="现场项目"
        projects={[
          "llama.cpp",
          "GLM",
          "SGLang",
          "vLLM",
        ]}
      />

