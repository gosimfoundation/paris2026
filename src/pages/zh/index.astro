  <ConferenceTracks
    title="精彩主题演讲与工作坊"
    tracksTitle="主题演讲"
    tracks={[
      {
        title: "Agentic AI Summit (智能体 AI 峰会)",
        text: "2026年是智能体生态大爆发的关键之年。峰会将聚焦智能体系统的核心标准与软件范式演进，探讨 MCP、A2A 等协议及主权 AI 新趋势，解析Codex 等工具驱动的 AI 软件开发新模式。这里将汇聚创新企业、创作者、投资机构与企业领袖，共论开源智能体的创新路径及商业发展。",
      },
      {
        title: "Open Source Robotics (开源机器人)",
        text: "当大模型赋予机器人\u201c灵魂\u201d，开源正赋予其\u201c躯体\u201d。本论坛将介绍具身智能开源机器人平台与应用的最新进展与创新，并通过主题演讲与动手工作坊多种形式，带您使用开源框架构建自主机器人系统和真实世界AI应用。这里是硬件与算法结合定义下一代具身智能的实战场。",
        link: "/zh/open-source-robotics",
      },
      {
        title: "Agentic App (智能体应用)",
        text: "从意图驱动的 AI 原生应用到「智能体互联网」，本论坛覆盖智能体时代的全栈技术。探索多模态生成、Makepad Splash 与 A2UI 等框架驱动的创意工作流，以及 MCP、ACP 等关键协议和 OpenClaw、Claude Code 等开源编程智能体。无论你是打造下一个现象级生成式应用，还是共建多智能体协作基础设施，这里是起点。",
      },
      {
        title: "Agentic AI on Edge (边缘智能体 AI)",
        text: "端侧 AI 正迎来类似 Nano Banana 2 式的性能觉醒，智能体正在向边缘设备全面渗透。本论坛聚焦资源受限环境下的强大 AI 模型部署，深挖端侧推理加速、模型压缩与实时决策的工程实践。与我们一同探索，如何让 AI 在无网、低功耗场景下依然爆发出极致的本地智能。",
      },
      {
        title: "AgenticOS (智能体操作系统)",
        text: "在\u201c算力即国力\u201d的 2026 年，硬件架构的每一次演进都在重新定义大模型的天花板。本论坛展示和推动全球AI硬件的创新与链接，连接巴黎和深圳，聚焦顶尖 AI 芯片、加速器生态与软硬件协同优化，深入探讨开源硬件趋势如何打破行业垄断。这里将汇聚全球芯片极客与硬件创业者，为千亿级参数模型与智能体系统打造最高效的算力引擎。",
      },
      {
        title: "Open Source Model (开源模型)",
        text: "开源模型正迎来\u201c以小胜大\u201d的范式拐点。本论坛涵盖LLM、音频、图像和视频的开放基础模型，聚焦模型技术的最新发展与应用突破，从通用到垂直领域，开源模型正在不断拓展AI能力的边界。",
      },
    ]}
    workshopsTitle="Workshops"
    workshops={[
      {
        title: "SGLang Workshop",
        text: "掌握使用 SGLang 进行高效可控的大语言模型推理与交互。",
        image: "sgl.png",
      },
      {
        title: "vLLM Workshop",
        text: "学习使用 vLLM 的高吞吐、低延迟推理引擎部署和扩展大语言模型服务。",
        image: "vllm.png",
      },
      {
        title: "Own Your Data Science and AI Workshop",
        text: "全天工作坊，聚焦前沿 AI 开源工具——从 GPU 加速的机器学习框架到开源主权大语言模型和表格基础模型。",
        image: "probabl.png",
      },
    ]}
    highlightsTitle="Spotlight & Hackathon"
    highlights={[
      {
        title: "GOSIM Spotlight 2026: Frontier Creators",
        text: "告别纯粹的 PPT 演示，迎接\u201cAI 务实主义（ROI导向）\u201d时代的巅峰对决，GOSIM Spotlight Demo 将从全球精选最具商业潜力的开源 AI 生成式爆款项目进行硬核实机演示。脱颖而出的创作者不仅将获得全额旅行赞助空降巴黎，更将直面全球顶尖投资人与技术大牛，开启属于你的开源高光时刻。",
        link: "https://spotlight.gosim.org/paris2026/",
      },
      {
        title: "Robotics Hackathon",
        text: "以 OpenArm（全开源 7 自由度人形机械臂）为核心的实战机器人黑客松。将最前沿模型应用于实体硬件，解决机器人抓取和操作领域的挑战。每队 3–5 人，支持远程访问。",
        link: "/zh/unaite-hackathon",
      },
      {
        title: "GOSIM Agentic Hackathon",
        text: "在这场高强度黑客松中构建下一代自主 AI 智能体。参赛团队将设计、开发和部署能够推理、规划和行动的智能体系统，探索开源 AI 智能体在真实世界场景中的无限可能。",
      },
    ]}
  />

