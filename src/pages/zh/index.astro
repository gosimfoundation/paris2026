  <TextAndImageReverse
    id="proposals"
    title="演讲提案征集现已开放"
    text="我们正在寻找大胆的想法和新鲜的声音来塑造未来。如果您对前沿技术、新兴趋势或变革性实践有见解，我们希望听到您的声音。提交演讲提案，加入由推动边界的创新者、思想领袖和变革者组成的阵容。"
    image={Proposals}
    imageAlt="GOSIM Paris 2026"
    dataBgSection="light"
    dataThemeSection="light"
    ctaButton={{
      text: "提交演讲提案",
      link: "https://cfp.gosim.org",
      openInNewTab: true,
