  <ConferenceTracks
    kicker="大会内容"
    title="精彩主题演讲与工作坊"
    intro="从开源模型、智能体框架到机器人、边缘 AI，再到连接智能体应用与 AgenticOS 的新一层，整套议程的目标是让你看清这条技术栈下一步往哪里走，也真正接近正在构建它的人。"
    tracksTitle="主题演讲"
    viewRouteLabel="查看主题"
    labLabel="工作坊"
    openLabel="打开"
    enterLabel="了解更多"
    tracks={[
      {
        title: "Agentic AI Summit (智能体 AI 峰会)",
        text: "智能体浪潮的战略层。聚焦 MCP、A2A、主权 AI、AI-native 开发方式，以及开源智能体正在形成的新协议、新软件范式与新商业路径。",
      },
      {
        title: "Open Source Robotics (开源机器人)",
        text: "智能体软件与物理系统真正相遇的地方。这里讨论开源机器人平台、具身智能技术栈，以及构建可感知、可规划、可执行的自主机器的真实方法。",
        link: "/zh/open-source-robotics",
      },
      {
        title: "Agentic AI on Edge (边缘智能体 AI)",
        text: "端侧 AI 正迎来类似 Nano Banana 2 式的性能觉醒，智能体正在向边缘设备全面渗透。本论坛聚焦资源受限环境下的强大 AI 模型部署，深挖端侧推理加速、模型压缩与实时决策的工程实践。与我们一同探索，如何让 AI 在无网、低功耗场景下依然爆发出极致的本地智能。",
      },
      {
        title: "Agentic OS & App (智能体操作系统与应用)",
        text: "当 AI 智能体成为人机交互的新界面，一个全新的操作系统层正在涌现。本论坛探索驱动智能体操作系统与应用的架构、框架和平台——从多智能体协调、运行时环境，到意图驱动的 AI 原生应用、创意工作流，以及支撑大规模自主、可组合、可信赖 AI 工作流的系统级原语。",
      },
      {
        title: "Open Source Model (开源模型)",
        text: "开源模型正在语言、视觉、音频与视频上快速进化。这一主题关注最新突破、实际落地，以及开放模型生态正在释放的新能力。",
      },
    ]}
    workshopsTitle="Workshops"
    workshops={[
      {
        title: "SGLang Workshop",
        text: "不只讲提示工程，而是深入 SGLang 项目本身：结构化生成、RadixAttention、KV Cache 复用、agent loop 设计，以及如何把这些能力真正用于高效可控的生产级推理与工作流系统。",
        theme: "structured-runtime",
      },
      {
        title: "vLLM Workshop",
        text: "直接上手 vLLM 项目级实践：PagedAttention、continuous batching、多 GPU 部署，以及团队如何用它搭建高吞吐、低延迟、面向生产的开源模型服务。",
        theme: "model-serving",
      },
      {
        title: "Own Your Data Science and AI Workshop",
        text: "全天工作坊，聚焦前沿 AI 开源工具——从 GPU 加速的机器学习框架到开源主权大语言模型和表格基础模型。",
        theme: "open-tooling",
      },
      {
        title: "Build Your Own Agentic App Workshop",
        text: "动手工作坊，使用开源工具和框架从零构建自主 AI 智能体，涵盖智能体设计模式、工具集成和实际部署。",
      },
    ]}
    highlightsTitle="Spotlight & Hackathon"
    highlights={[
      {
        title: "GOSIM Spotlight 2026: Frontier Creators",
        text: "告别纯粹的 PPT 演示，迎接\u201cAI 务实主义（ROI导向）\u201d时代的巅峰对决，GOSIM Spotlight Demo 将从全球精选最具商业潜力的开源 AI 生成式爆款项目进行硬核实机演示。脱颖而出的创作者不仅将获得全额旅行赞助空降巴黎，更将直面全球顶尖投资人与技术大牛，开启属于你的开源高光时刻。",
        link: "https://spotlight.gosim.org/paris2026/",
      },
      {
        title: "Robotics Hackathon",
        text: "以 OpenArm（全开源 7 自由度人形机械臂）为核心的实战机器人黑客松。将最前沿模型应用于实体硬件，解决机器人抓取和操作领域的挑战。每队 3–5 人，支持远程访问。",
        link: "/zh/unaite-hackathon",
      },
      {
        title: "GOSIM Agentic Hackathon",
        text: "在这场高强度黑客松中构建下一代自主 AI 智能体。参赛团队将设计、开发和部署能够推理、规划和行动的智能体系统，探索开源 AI 智能体在真实世界场景中的无限可能。",
        link: "https://create.gosim.org/",
      },
    ]}
  />

