---
// Components
import Layout from "layouts/LayoutLandingZh.astro";
import GetTickets from "components/GetTickets.astro";
import HeroText from "components/HeroText.astro";
import AllSponsors from "components/Sponsors.astro";
import TextAndSponsors from "components/TextAndSponsors.astro";
---

<Layout
  title="支持者 – GOSIM Paris 2026"
  description="GOSIM Paris 2026是开源AI项目、开发者、研究人员和行业支持者的聚会，旨在分享知识、相互学习和合作。"
  navBackground="light"
  pageTransitionName="支持者"
>
  <HeroText
    title="支持者"
    text="我们很高兴为您带来一次令人难以置信的体验，这要归功于我们的支持者和合作伙伴的慷慨支持。我们与真正的创新者合作，他们正在推动我们行业的边界。"
    lightgray
  />

  <AllSponsors lang="zh" />

  <GetTickets
    title="立即获取 GOSIM Paris 门票"
    location="法国巴黎"
    date="2026年5月5-6日"
    text="立即确保您在 GOSIM Paris 2026 的席位。与创新者合作，与行业先驱交流，成为塑造开源技术未来的一部分。"
    ctaButton={{
      text: "立即购票",
      link: "https://gosimparis2026.eventbrite.com/",
      openInNewTab: true,
    }}
  />
</Layout>
