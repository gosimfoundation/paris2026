---
// Components
import Layout from "layouts/LayoutLandingZh.astro";
import GetTickets from "components/GetTickets.astro";
import HeroText from "components/HeroText.astro";
import AllSponsors from "components/SponsorsZh.astro";
import TextAndSponsors from "components/TextAndSponsors.astro";
---

<Layout
  title="赞助商 – GOSIM Paris 2026"
  description="GOSIM Paris 2026是开源AI项目、开发者、研究人员和行业赞助商的聚会，旨在分享知识、相互学习和合作。"
  navBackground="light"
  pageTransitionName="赞助商"
>
  <HeroText
    title="赞助商"
    text="我们很高兴为您带来一次令人难以置信的体验，这要归功于我们的赞助商和合作伙伴的慷慨支持。我们与真正的创新者合作，他们正在推动我们行业的边界。"
    lightgray
  />

  <AllSponsors />

  <TextAndSponsors
    id="sponsorship"
    title="赞助机会"
    text="通过成为GOSIM Paris 2026的合作伙伴，接触到数千名目标受众。"
    text2="*仅展示往届GOSIM会议赞助商，仅供参考。"
    ctaButton={{
      text: "联系我们",
      link: "mailto:sponsor@gosim.org",
    }}
    logos={[
      {
        image: "openwallet.png",
        imageAlt: "OpenWallet logo",
      },
      {
        image: "ajtis.jpg",
        imageAlt: "AJTIS logo",
      },
      {
        image: "aifc.png",
        imageAlt: "AIFC logo",
      },
      {
        image: "lf-gen-ai.png",
        imageAlt: "Linux Foundation logo",
      },
      {
        image: "eclipse-foundation.png",
        imageAlt: "Eclipse Foundation logo",
      },
      {
        image: "osi.png",
        imageAlt: "Open Source Initiative logo",
      },
    ]}
  />

  <GetTickets
    title="立即获取 GOSIM Paris 门票"
    location="法国巴黎"
    date="2026年5月5-6日"
    text="立即确保您在 GOSIM Paris 2026 的席位。与创新者合作，与行业先驱交流，成为塑造开源技术未来的一部分。"
    ctaButton={{
      text: "立即购票",
      link: "https://gosimparis2026.eventbrite.com/",
      openInNewTab: true,
    }}
  />
</Layout>
