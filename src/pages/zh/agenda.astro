---
import Layout from "layouts/LayoutLandingZh.astro";
import GetTickets from "components/GetTickets.astro";
import HeroText from "components/HeroText.astro";
import AgendaOverview from "components/AgendaOverview.astro";
---

<Layout
  title="议程 – GOSIM Paris 2026"
  description="浏览 GOSIM Paris 2026 议程概览——涵盖所有大会议题和工作坊的演讲者与主题。"
  navBackground="light"
  pageTransitionName="议程"
>
  <HeroText
    title="议程概览"
    text="涵盖所有大会议题和工作坊的演讲者与主题概览。包含具体时间安排的完整日程将于活动临近前发布。"
    lightgray
  />

  <AgendaOverview lang="zh" speakerBasePath="/zh/speakers/" />

  <GetTickets
    title="立即获取 GOSIM Paris 门票"
    location="法国巴黎"
    date="2026年5月5-6日"
    text="立即确保您在 GOSIM Paris 2026 的席位。与创新者合作，与行业先驱交流，成为塑造开源技术未来的一部分。"
    ctaButton={{
      text: "立即购票",
      link: "https://gosimparis2026.eventbrite.com/",
      openInNewTab: true,
    }}
  />
</Layout>
