---
// Components
import Layout from "layouts/LayoutLandingZh.astro";
import GetTickets from "components/GetTickets.astro";
import HeroText from "components/HeroText.astro";
import BilingualSchedule from "components/BilingualSchedule.astro";
---

<Layout
  title="5月6日 – GOSIM Paris 2026"
  description="GOSIM Paris 2026是开源AI项目、开发者、研究人员和行业赞助商的聚会，旨在分享知识、相互学习和合作。"
  navBackground="light"
  pageTransitionName="5月6日"
>
  <HeroText title="议程安排：5月6日" lightgray />

  <BilingualSchedule currentDay="5月6日" />

  <GetTickets
    title="获取您的GOSIM Paris门票"
    location="巴黎"
    date="2026年5月4-6日"
    text="立即确保您在GOSIM Paris 2026的席位。与创新者合作，与行业先驱交流，成为塑造开源技术未来的一部分。"
    ctaButton={{
      text: "立即购票",
      link: "https://gosimparis2026.eventbrite.com/",
      openInNewTab: true,
    }}
  />
</Layout>
