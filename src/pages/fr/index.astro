  <PreviousEvents
    title="Événements passés"
    events={[
      {
        title: "GOSIM Hangzhou",
        date: "13–14 septembre 2025",
        description: "GOSIM Hangzhou a rassemblé des développeurs et contributeurs open source pour une journée de conférences, ateliers et échanges communautaires.",
