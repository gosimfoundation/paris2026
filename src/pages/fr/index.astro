  <div class="section-divider"></div>

  <VenueInfo
    subtitle="Le lieu"
    title="STATION F"
    location="5 Parv. Alan Turing, 75013 Paris, France"
    text="STATION F à Paris est le plus grand campus de startups au monde, abritant plus de 1 000 startups et de nombreux programmes technologiques. Réputée pour favoriser l'innovation en IA, STATION F héberge des accélérateurs spécialisés et des espaces dédiés qui réunissent des startups IA de pointe, des chercheurs et des partenaires industriels, stimulant la collaboration, les projets révolutionnaires et la croissance rapide de l'intelligence artificielle."
    image="/images/homepage/station-f.jpg"
    ctaButton={{
      text: "Infos sur le lieu",
      link: "/fr/venue",
    }}
  />

  <Testimonials
    embedUrns={[
      "urn:li:activity:7325758963134717952",
