---
// Components
import Layout from "layouts/LayoutLandingFr.astro"
import Hero from "components/Hero.astro"
import Intro from "components/Intro.astro"
import Statistics from "components/Statistics.astro"
import Tracks from "components/Tracks.astro"
import ConferenceTracks from "components/ConferenceTracks.astro"
import TextAndImage from "components/TextAndImage.astro"
import PreviousEvents from "components/PreviousEvents.astro"
import GetTickets from "components/GetTickets.astro"
import VenueInfo from "components/VenueInfo.astro"
import TextAndSponsors from "components/TextAndSponsors.astro"
import TextAndImageReverse from "components/TextAndImageReverse.astro"
import FeaturedSpeakers from "components/FeaturedSpeakersFr.astro"
import Timeline from "components/Timeline.astro"
import Marquee from "components/MarqueeFr.astro"
import Cards from "components/Cards.astro"
import CardsSponsors from "components/CardsSponsors.astro"
import Testimonials from "components/Testimonials.astro"

// Images
import Placeholder1 from "images/homepage/stats1.png"
import Placeholder2 from "images/homepage/stats2.jpg"
import Placeholder3 from "images/homepage/stats3.png"
import SpotlightBlue from "images/homepage/spotlight-hg.svg"
import Proposals from "images/homepage/hangzhou-proposals-min.jpg"

import GosimShanghai from "images/homepage/gosim-shanghai.png"
import GosimDelft from "images/homepage/gosim-delft.png"
import GosimBeijing from "images/homepage/gosim-beijing.png"
import GosimParis from "images/homepage/gosim-paris-min.png"
import GosimHangzhou from "images/homepage/gosim-hangzhou.png"
---

<Layout
  title="GOSIM Paris 2026"
  description="GOSIM Paris - 5-6 mai 2026"
  navDarkMode={true}
  navBackground="header-home"
  pageTransitionName="Home"
>
  <Hero
    date="5-6 mai 2026"
    location="STATION F, Paris"
    links={[
      {
        text: "Soumettre une proposition",
        link: "https://cfp.gosim.org",
        openInNewTab: true,
      },
      {
        text: "Obtenir des billets",
        link: "https://gosimparis2026.eventbrite.com/",
        openInNewTab: true,
        class: "btn hero-ticket xl btn-hover fade-in-last",
      },
    ]}
  />

  <!-- <FeaturedSpeakers
    title="Intervenants en vedette"
    ctaButton={{
      text: "Voir tous les intervenants",
      link: "/fr/speakers/",
    }}
  /> -->

  <div
    class="section-wrap"
    id="intro"
    data-theme-section="light"
    data-bg-section="lightgray"
  >
    <div class="intro-statistics-container" style="">
      <Intro>
        <h3 class="h3 light split-words animate-read">
          Rejoignez-nous à GOSIM Paris 2026, la conférence open source de
          référence, où innovation, collaboration et avancées technologiques
          convergent.
        </h3>
      </Intro>
    </div>
  </div>

  <ConferenceTracks
    title="Thématiques et ateliers passionnants"
    day1Title="Jour 1 — 5 mai"
    day1Subtitle="Conférence, ateliers, formations et hackathon"
    day2Title="Jour 2 — 6 mai"
    day2Subtitle="Conférence et finales du hackathon"
    day1Tracks={[
      {
        title: "Agentic AI Summit (Sommet IA Agentique)",
        text: "2026 marque une année charnière pour la croissance explosive de l'écosystème agentique. Ce sommet se concentre sur les standards fondamentaux et les paradigmes logiciels en évolution des systèmes agentiques, explorant des protocoles comme MCP et A2A, ainsi que les tendances émergentes de l'IA souveraine. Nous analyserons les nouveaux modèles de développement logiciel IA portés par des outils comme Codex. Réunissant startups innovantes, créateurs, investisseurs et dirigeants d'entreprise, cet événement est dédié à tracer les voies d'innovation et l'avenir commercial des agents open source.",
      },
      {
        title: "Open Source Robotics (Robotique Open Source)",
        text: "Alors que les grands modèles donnent une « âme » aux robots, l'open source forge leur « corps ». Cette thématique présente les dernières avancées et innovations en matière de plateformes et d'applications open source pour l'IA incarnée. À travers un mélange dynamique de conférences et d'ateliers pratiques, vous apprendrez à construire des systèmes robotiques autonomes et des applications IA réelles en utilisant des frameworks open source. C'est le terrain d'épreuve ultime où le matériel rencontre les algorithmes pour définir la prochaine génération d'intelligence incarnée.",
        link: "/fr/open-source-robotics",
      },
      {
        title: "Agentic App (Applications Agentiques)",
        text: "Des applications natives IA pilotées par l'intention à l'« Internet des Agents », cette thématique couvre l'ensemble de la pile technologique de l'ère agentique. Explorez la génération multimodale, les workflows créatifs avec des frameworks comme Makepad Splash et A2UI, ainsi que les protocoles clés comme MCP et ACP et les agents de codage open source comme OpenClaw et Claude Code. Que vous construisiez le prochain hit génératif ou co-créiez l'infrastructure de collaboration multi-agents, c'est ici que tout converge.",
      },
      {
        title: "Agentic AI on Edge (IA Agentique en Périphérie)",
        text: "L'IA embarquée connaît un éveil de performance comparable à Nano Banana 2, avec l'IA agentique qui s'infiltre rapidement dans les dispositifs en périphérie. Ce forum se concentre sur le déploiement de modèles IA puissants dans des environnements aux ressources limitées, plongeant au cœur des pratiques d'ingénierie pour l'accélération de l'inférence embarquée, la compression de modèles et la prise de décision en temps réel. Rejoignez-nous pour explorer comment l'IA peut libérer une intelligence locale ultime même dans des scénarios hors ligne et à faible consommation.",
      },
      {
        title: "AI Hardware (Matériel IA)",
        text: "En 2026, une ère où « la puissance de calcul est la puissance nationale », chaque évolution de l'architecture matérielle redéfinit le plafond des grands modèles. Connectant les communautés GOSIM de Paris et Shenzhen, cette thématique se concentre sur les puces IA de pointe, les écosystèmes d'accélérateurs et la co-optimisation matériel-logiciel, explorant comment les tendances du matériel open source peuvent briser les monopoles industriels. C'est le rassemblement ultime pour les passionnés de silicium et les fondateurs hardware du monde entier qui construisent les moteurs de calcul les plus efficaces pour les systèmes agentiques.",
      },
    ]}
    day2Tracks={[
      {
        title: "Agentic AI Summit (Sommet IA Agentique)",
        text: "2026 marque une année charnière pour la croissance explosive de l'écosystème agentique. Ce sommet se concentre sur les standards fondamentaux et les paradigmes logiciels en évolution des systèmes agentiques, explorant des protocoles comme MCP et A2A, ainsi que les tendances émergentes de l'IA souveraine. Nous analyserons les nouveaux modèles de développement logiciel IA portés par des outils comme Codex. Réunissant startups innovantes, créateurs, investisseurs et dirigeants d'entreprise, cet événement est dédié à tracer les voies d'innovation et l'avenir commercial des agents open source.",
      },
      {
        title: "Open Source Robotics (Robotique Open Source)",
        text: "Alors que les grands modèles donnent une « âme » aux robots, l'open source forge leur « corps ». Cette thématique présente les dernières avancées et innovations en matière de plateformes et d'applications open source pour l'IA incarnée. À travers un mélange dynamique de conférences et d'ateliers pratiques, vous apprendrez à construire des systèmes robotiques autonomes et des applications IA réelles en utilisant des frameworks open source. C'est le terrain d'épreuve ultime où le matériel rencontre les algorithmes pour définir la prochaine génération d'intelligence incarnée.",
        link: "/fr/open-source-robotics",
      },
      {
        title: "Agentic App (Applications Agentiques)",
        text: "Des applications natives IA pilotées par l'intention à l'« Internet des Agents », cette thématique couvre l'ensemble de la pile technologique de l'ère agentique. Explorez la génération multimodale, les workflows créatifs avec des frameworks comme Makepad Splash et A2UI, ainsi que les protocoles clés comme MCP et ACP et les agents de codage open source comme OpenClaw et Claude Code. Que vous construisiez le prochain hit génératif ou co-créiez l'infrastructure de collaboration multi-agents, c'est ici que tout converge.",
      },
      {
        title: "Open Source Model (Modèle Open Source)",
        text: "Les modèles open source atteignent un point d'inflexion paradigmatique où « les petits modèles surpassent leur catégorie ». Couvrant les modèles de fondation ouverts à travers les LLMs, l'audio, l'image et la vidéo, cette thématique met en lumière les dernières évolutions technologiques et les percées applicatives. Des capacités généralistes aux verticaux spécialisés, les modèles open source repoussent sans relâche les limites de ce que l'IA peut accomplir.",
      },
    ]}
    highlightsTitle="Spotlight & Hackathon"
    highlights={[
      {
        title: "GOSIM Spotlight 2026: Frontier Creators",
        text: "Dites adieu aux présentations PowerPoint et bienvenue à l'épreuve ultime de l'ère du « Pragmatisme IA » ! Le GOSIM Spotlight Demo sélectionnera les projets open source d'IA générative les plus prometteurs commercialement au monde pour des démonstrations hardcore en direct sur scène. Les créateurs sélectionnés recevront non seulement un parrainage complet de voyage pour venir à Paris, mais présenteront également directement aux investisseurs et visionnaires technologiques de premier plan mondial, s'appropriant leur moment de gloire open source.",
        link: "https://spotlight.gosim.org/paris2026/",
      },
      {
        title: "Robotics Hackathon",
        text: "Un hackathon robotique avec OpenArm — un bras robotique humanoïde 7 DoF entièrement open source. Appliquez des modèles de pointe sur du matériel physique pour résoudre les défis de la préhension et de la manipulation robotique. Équipes de 3 à 5 personnes, accès distant disponible.",
      },
    ]}
  />

  <Marquee />

  <Timeline
    todayLabel="Aujourd'hui"
    events={[
      {
        date: "12 fév.",
        title: "Ouverture des soumissions CFP",
        isoDate: "2026-02-12",
        type: "cfp",
      },
      {
        date: "10 mars",
        title: "Ouverture des candidatures Spotlight: Frontier Creators",
        isoDate: "2026-03-10",
        type: "spotlight",
      },
      {
        date: "31 mars",
        title: "Clôture des soumissions CFP",
        isoDate: "2026-03-31",
        type: "cfp",
      },
      {
        date: "10 avr.",
        title: "Clôture des candidatures Spotlight: Frontier Creators",
        isoDate: "2026-04-10",
        type: "spotlight",
      },
      {
        date: "15 avr.",
        title: "Candidats Spotlight: Frontier Creators annoncés",
        isoDate: "2026-04-15",
        type: "spotlight",
      },
      {
        date: "5-6 mai",
        title: "GOSIM Paris 2026",
        isoDate: "2026-05-05",
        type: "event",
      },
    ]}
  />

  <TextAndImageReverse
    id="proposals"
    title="Appel à propositions ouvert"
    text="Nous recherchons des idées audacieuses et des voix nouvelles pour façonner l'avenir. Si vous avez des perspectives sur les technologies de pointe, les tendances émergentes ou les pratiques transformatrices, nous voulons vous entendre. Soumettez une proposition pour intervenir et rejoignez une programmation d'innovateurs, de leaders d'opinion et d'acteurs du changement qui repoussent les limites du possible."
    image={Proposals}
    imageAlt="GOSIM Paris"
    dataBgSection="light"
    dataThemeSection="light"
    ctaButton={{
      text: "Soumettre une proposition",
      link: "https://cfp.gosim.org",
      openInNewTab: true,
    }}
  />

  <TextAndImage
    id="spotlight"
    title="GOSIM Spotlight 2026 : Créateurs d'Avant-garde"
    text="Cette plateforme célèbre les créateurs qui repoussent les limites à l'intersection de l'IA et de la créativité. Que vous développiez des produits, des systèmes, du code, de la recherche, des prototypes ou des œuvres artistiques — nous accueillons les soumissions de développeurs, artistes, chercheurs et entrepreneurs. Un jury indépendant sélectionnera 15 à 20 projets pour une présentation en direct à Paris. Les créateurs sélectionnés bénéficieront d'une visibilité mondiale, d'un soutien au voyage, de mentorat et de connexions avec des créateurs d'avant-garde du monde entier."
    image={SpotlightBlue}
    imageAlt="Gosim Spotlight badge — previous design, new design coming soon"
    dataBgSection="light"
    dataThemeSection="light"
    ctaButton={{
      text: "Postuler ou Nominer",
      link: "https://spotlight.gosim.org/paris2026/",
      openInNewTab: true,
    }}
  />

  <div class="section-divider"></div>

  <TextAndSponsors
    id="sponsorship"
    title="Opportunités de parrainage"
    text="Touchez des milliers de personnes dans votre audience cible en devenant une organisation partenaire de GOSIM Paris 2026."
    text2="*Les sponsors des précédentes conférences GOSIM sont présentés à titre indicatif uniquement."
    ctaButton={{
      text: "Contactez-nous",
      link: "mailto:sponsor@gosim.org",
    }}
    logos={[
      {
        image: "openwallet.png",
        imageAlt: "Logo OpenWallet",
      },
      {
        image: "ajtis.jpg",
        imageAlt: "Logo AJTIS",
      },
      {
        image: "aifc.png",
        imageAlt: "Logo AIFC",
      },
      {
        image: "lf-gen-ai.png",
        imageAlt: "Logo Linux Foundation",
      },
      {
        image: "eclipse-foundation.png",
        imageAlt: "Logo Eclipse Foundation",
      },
      {
        image: "osi.png",
        imageAlt: "Logo Open Source Initiative",
      },
    ]}
  />

  <VenueInfo
    subtitle="Le lieu"
    title="STATION F"
    location="5 Parv. Alan Turing, 75013 Paris, France"
    text="STATION F à Paris est le plus grand campus de startups au monde, abritant plus de 1 000 startups et de nombreux programmes technologiques. Réputée pour favoriser l'innovation en IA, STATION F héberge des accélérateurs spécialisés et des espaces dédiés qui réunissent des startups IA de pointe, des chercheurs et des partenaires industriels, stimulant la collaboration, les projets révolutionnaires et la croissance rapide de l'intelligence artificielle."
    image="/images/homepage/station-f.jpg"
    ctaButton={{
      text: "En savoir plus",
      link: "https://stationf.co/",
      openInNewTab: true,
    }}
  />

  <Testimonials
    embedUrns={[
      "urn:li:activity:7325758963134717952",
      "urn:li:ugcPost:7325474394246471681",
      "urn:li:ugcPost:7325823558645964802",
      "urn:li:activity:7327311785059901440",
    ]}
  />

  <PreviousEvents
    title="Événements précédents"
    events={[
      {
        title: "GOSIM Hangzhou",
        date: "13-14 septembre 2025",
        description:
          "GOSIM Hangzhou a réuni plus de 1800 participants pour explorer l'IA, l'open source et les technologies émergentes dans la magnifique ville de Hangzhou.",
        image: GosimHangzhou,
        link: "https://hangzhou2025.gosim.org/",
      },
      {
        title: "GOSIM AI Paris",
        date: "6-7 mai 2025",
        description:
          "Plus de 1000 participants et sommités se sont penchés sur le développement multifacette de l'IA lors de notre événement GOSIM Paris de 2 jours dans la Ville Lumière.",
        image: GosimParis,
        link: "https://paris2025.gosim.org/",
      },
      {
        title: "GOSIM Beijing",
        date: "17-18 octobre 2024",
        description:
          "Attirant plus de 1800 participants, GOSIM Beijing est de loin le plus grand événement GOSIM jamais organisé dans la capitale historique de la Chine.",
        image: GosimBeijing,
        link: "https://china2024.gosim.org/",
      },
      {
        title: "GOSIM Europe (Delft)",
        date: "6-7 juin 2024",
        description:
          "GOSIM Delft était un événement de deux jours avec 3 thématiques qui a réuni 1200 participants non seulement des Pays-Bas, mais du monde entier.",
        image: GosimDelft,
        link: "https://europe2024.gosim.org/",
      },
      {
        title: "GOSIM Conference (Shanghai)",
        date: "26 septembre 2023",
        description:
          "Là où tout a commencé, la conférence et les ateliers GOSIM se sont concentrés sur la promotion et le renforcement des contributions open source.",
        image: GosimShanghai,
        link: "https://conference2023.gosim.org/",
      },
    ]}
  />

  <GetTickets
    title="Obtenez votre billet GOSIM Paris"
    location="Paris"
    date="5-6 mai 2026"
    text="Réservez votre place dès aujourd'hui à GOSIM Paris 2026. Collaborez avec des innovateurs, échangez avec des pionniers de l'industrie et participez à façonner l'avenir de la technologie open source."
    ctaButton={{
      text: "Obtenir des billets",
      link: "https://gosimparis2026.eventbrite.com/",
      openInNewTab: true,
    }}
  />
</Layout>
