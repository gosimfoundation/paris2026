---
// Components
import Layout from "layouts/LayoutLandingFr.astro"
import Hero from "components/Hero.astro"
import Intro from "components/Intro.astro"
import Statistics from "components/Statistics.astro"
import Tracks from "components/Tracks.astro"
import ConferenceTracks from "components/ConferenceTracks.astro"
import TextAndImage from "components/TextAndImage.astro"
import PreviousEvents from "components/PreviousEvents.astro"
import GetTickets from "components/GetTickets.astro"
import VenueInfo from "components/VenueInfo.astro"
import TextAndSponsors from "components/TextAndSponsors.astro"
import TextAndImageReverse from "components/TextAndImageReverse.astro"
import FeaturedSpeakers from "components/FeaturedSpeakersFr.astro"
import Timeline from "components/Timeline.astro"
import Marquee from "components/MarqueeFr.astro"
import Cards from "components/Cards.astro"
import CardsSponsors from "components/CardsSponsors.astro"
import Testimonials from "components/Testimonials.astro"

// Images
import Placeholder1 from "images/homepage/stats1.png"
import Placeholder2 from "images/homepage/stats2.jpg"
import Placeholder3 from "images/homepage/stats3.png"
import SpotlightBlue from "images/homepage/spotlight_paris_2026.png"
import Proposals from "images/homepage/hangzhou-proposals-min.jpg"

import GosimShanghai from "images/homepage/gosim-shanghai.png"
import GosimDelft from "images/homepage/gosim-delft.png"
import GosimBeijing from "images/homepage/gosim-beijing.png"
import GosimParis from "images/homepage/gosim-paris-min.png"
import GosimHangzhou from "images/homepage/gosim-hangzhou.png"
---

<Layout
  title="GOSIM Paris 2026"
  description="GOSIM Paris 2026 — La Convergence de l'IA Agentique. 4-6 mai 2026 à STATION F, Paris."
  navDarkMode={true}
  navBackground="header-home"
  pageTransitionName="Home"
>
  <Hero
    date="4-6 mai 2026"
    location="STATION F, Paris"
    subtitle="La Convergence de l'IA Agentique"
    description="Les meilleurs projets open source, les développeurs de pointe et les dernières avancées de l'IA agentique — tous réunis à STATION F à Paris pour deux jours d'expériences immersives pour développeurs."
    links={[
      {
        text: "Soumettre une proposition",
        link: "https://cfp.gosim.org",
        openInNewTab: true,
      },
      {
        text: "Obtenir des billets",
        link: "https://gosimparis2026.eventbrite.com/",
        openInNewTab: true,
        class: "btn hero-ticket xl btn-hover fade-in-last",
      },
    ]}
  />

  <TextAndSponsors
    id="speaker-organizations"
    title="Organisations représentées (partiel)"
    text="Nos intervenants viennent d'universités, de laboratoires de recherche, de projets open source et d'entreprises à la pointe de l'IA agentique — voici la liste complète des organisations présentes."
    text2=""
    logoGroups={[
      {
        cols: 5,
        logos: [
          { image: "google.png", imageAlt: "Google", logoClass: "xl", url: "https://www.google.com" },
          { image: "amazon.png", imageAlt: "Amazon", logoClass: "xll", url: "https://www.amazon.com" },
          { image: "intel.png", imageAlt: "Intel", logoClass: "xl", url: "https://www.intel.com" },
          { image: "nvidia.png", imageAlt: "NVIDIA", logoClass: "xll", url: "https://www.nvidia.com" },
          { image: "arm.png", imageAlt: "Arm", logoClass: "xl", url: "https://www.arm.com" },
          { image: "huawei-vertical.png", imageAlt: "Huawei", logoClass: "xl", url: "https://www.huawei.com" },
          { image: "redhat.png", imageAlt: "Red Hat", logoClass: "xl", url: "https://www.redhat.com" },
          { image: "bytedance.png", imageAlt: "ByteDance", url: "https://www.bytedance.com" },
          { image: "huggingface.png", imageAlt: "Hugging Face", logoClass: "l", url: "https://huggingface.co" },
          { image: "minimax.png", imageAlt: "Minimax", url: "https://www.minimaxi.com" },
          { image: "kimi-logo.png", imageAlt: "Kimi", url: "https://kimi.ai" },
          { image: "zhipuai.png", imageAlt: "ZhipuAI", url: "https://www.zhipuai.cn" },
          { image: "sgl.png", imageAlt: "SGLang", url: "https://sglang.ai" },
          { image: "probabl.png", imageAlt: "Probabl", url: "https://probabl.ai" },
          { image: "inria.png", imageAlt: "INRIA", url: "https://www.inria.fr" },
        ],
      },
    ]}
  />

  <div
    class="section-wrap"
    id="intro"
    data-theme-section="light"
    data-bg-section="lightgray"
  >
    <div class="intro-statistics-container" style="">
      <Intro
        eyebrow="GOSIM PARIS 2026 / 4-6 MAI / STATION F"
        headlineLines={[
          "Comprendre Ce Qui Se Passe",
          "À La Frontière De L'IA",
          "Agentique —",
          "À GOSIM, À Paris",
        ]}
        accentLine={0}
        body="Les meilleurs projets open source, les développeurs de pointe et les dernières avancées de l'IA agentique — tous réunis à STATION F à Paris pour deux jours d'expériences immersives pour développeurs."
        facetsTitle="Dans Le Programme"
        facets={[
          {
            title: "Projets De Référence",
            text: "Retrouvez les équipes derrière llama.cpp, GLM, SGLang, vLLM et d'autres projets open source qui font bouger la pile.",
          },
          {
            title: "Line-Up Diversifié",
            text: "Builders, chercheurs, fondateurs, ingénieurs infra et maintainers open source venus de plusieurs régions et communautés.",
          },
          {
            title: "Mouvements Actuels",
            text: "Suivez l'élan le plus récent autour des frameworks d'agents, de l'interopérabilité type MCP, du model serving, de l'edge et de la production.",
          },
          {
            title: "Expérience Builder",
            text: "Workshops, demos spotlight, hackathons et participation internationale en font l'un des rendez-vous open source agentiques les plus singuliers d'Europe.",
          },
        ]}
        signals={[
          "Modèles De Base",
          "Frameworks D'Agents",
          "Model Serving",
          "Déploiement Edge",
          "Systèmes En Production",
        ]}
        projectsLabel="Projets présents"
        projects={[
          "llama.cpp",
          "GLM",
          "SGLang",
          "vLLM",
        ]}
      />
    </div>
  </div>

  <TextAndSponsors
    id="sponsors"
    title="Sponsors"
    text="GOSIM Paris 2026 est fièrement sponsorisé par ces organisations leaders."
    text2=""
    logoGroups={[
      {
        cols: 4,
        logos: [
          { image: "huawei-vertical.png", imageAlt: "Huawei", logoClass: "xl", url: "https://www.huawei.com" },
          { image: "openharmony.png", imageAlt: "OpenHarmony", url: "https://www.openharmony.cn" },
          { image: "openbmb.png", imageAlt: "OpenBMB", url: "https://www.openbmb.cn" },
          { image: "minimax.png", imageAlt: "MiniMax", url: "https://www.minimaxi.com" },
          { image: "kimi-logo.png", imageAlt: "Kimi", url: "https://kimi.ai" },
          { image: "zai.png", imageAlt: "Z.ai", logoClass: "xl", url: "https://z.ai" },
        ],
      },
    ]}
  />

  <ConferenceTracks
    kicker="Programme"
    title="Thématiques et ateliers passionnants"
    titleLink="/fr/schedule/"
    titleLinkLabel="Voir le programme"
    intro="Des modeles open source et frameworks d'agents a la robotique, a l'edge AI et a la couche emergente entre applications agentiques et systemes d'exploitation agentiques, le programme est concu pour montrer ou va la pile et rapprocher les developpeurs de celles et ceux qui la construisent."
    tracksTitle="Conference Tracks"
    viewRouteLabel="Voir le programme"
    labLabel="Workshop"
    openLabel="Voir le programme"
    enterLabel="Découvrir"
    tracks={[
      {
        title: "Sommet IA Agentique",
        text: "La couche stratégique de la vague agentique : protocoles, modèles logiciels, outillage et usages. On y suit MCP, A2A, l'IA souveraine, le développement AI-native et les nouveaux modèles ouverts des agents.",
        link: "/fr/schedule/#agentic-ai-summit",
      },
      {
        title: "Robotique Open Source",
        text: "Là où le logiciel agentique rencontre les systèmes physiques. Cette thématique couvre les plateformes robotiques ouvertes, les piles d'IA incarnée et les méthodes concrètes pour construire des machines autonomes qui perçoivent, planifient et agissent.",
        link: "/fr/schedule/#open-source-robotics",
      },
      {
        title: "IA Agentique en Périphérie",
        text: "L'IA embarquée connaît un éveil de performance comparable à Nano Banana 2, avec l'IA agentique qui s'infiltre rapidement dans les dispositifs en périphérie. Ce forum se concentre sur le déploiement de modèles IA puissants dans des environnements aux ressources limitées, plongeant au cœur des pratiques d'ingénierie pour l'accélération de l'inférence embarquée, la compression de modèles et la prise de décision en temps réel. Rejoignez-nous pour explorer comment l'IA peut libérer une intelligence locale ultime même dans des scénarios hors ligne et à faible consommation.",
        link: "/fr/schedule/#agentic-ai-on-edge",
      },
      {
        title: "OS & Applications Agentiques",
        text: "Alors que les agents IA deviennent la nouvelle interface entre humains et machines, une nouvelle couche de système d'exploitation émerge pour les orchestrer. Cette thématique explore l'architecture, les frameworks et les plateformes qui alimentent les systèmes d'exploitation et applications agentiques — de la coordination multi-agents et des environnements d'exécution aux applications IA natives pilotées par l'intention, workflows créatifs et primitives système qui permettent des workflows IA autonomes, composables et fiables à grande échelle.",
        link: "/fr/schedule/#ai-generative-app",
      },
      {
        title: "Modèles Open Source",
        text: "Les modèles ouverts progressent vite en langage, vision, audio et vidéo. Cette thématique suit les dernières percées, les déploiements concrets et les nouvelles capacités issues de l'écosystème open source.",
        link: "/fr/schedule/#open-source-model",
      },
    ]}
    workshopsTitle="Workshops"
    workshops={[
      {
        title: "Atelier SGLang",
        text: "Allez au-dela du simple prompting et explorez ce qui fait la force de SGLang : generation structuree, RadixAttention, reutilisation du cache KV, boucles agentiques et patterns concrets pour construire des pipelines d'inference et d'orchestration en production.",
        theme: "structured-runtime",
        link: "/fr/schedule/#ws-sglang-paris2026",
      },
      {
        title: "Atelier vLLM",
        text: "Travaillez directement avec la pile de service de vLLM : paged attention, continuous batching, deploiement multi-GPU et pratiques d'exploitation utilisees pour faire tourner des services de modeles ouverts a haut debit et faible latence en production.",
        theme: "model-serving",
        link: "/fr/schedule/#ws-vllm-paris2026",
      },
      {
        title: "Atelier Data Science & IA Souveraine",
        text: "Un atelier d'une journée complète sur les outils open source pour l'IA de pointe — des frameworks ML accélérés par GPU aux LLMs souverains et modèles de fondation tabulaires.",
        theme: "open-tooling",
        link: "/fr/schedule/#ws-own-your-data-paris2026",
      },
      {
        title: "Atelier Construisez Votre Application Agentique",
        text: "Un atelier pratique où vous construirez des agents IA autonomes à partir de zéro en utilisant des outils et frameworks open source, couvrant les patterns de conception d'agents, l'intégration d'outils et le déploiement réel.",
        link: "/fr/schedule/#ws-agentic-app",
      },
    ]}
    highlightsTitle="Spotlight & Hackathons"
    highlights={[
      {
        title: "GOSIM Spotlight 2026 : Créateurs d'Avant-garde",
        text: "Dites adieu aux présentations PowerPoint et bienvenue à l'épreuve ultime de l'ère du « Pragmatisme IA » ! Le GOSIM Spotlight Demo sélectionnera les projets open source d'IA générative les plus prometteurs commercialement au monde pour des démonstrations hardcore en direct sur scène. Les créateurs sélectionnés recevront non seulement un parrainage complet de voyage pour venir à Paris, mais présenteront également directement aux investisseurs et visionnaires technologiques de premier plan mondial, s'appropriant leur moment de gloire open source.",
        link: "https://spotlight.gosim.org/paris2026/",
      },
      {
        title: "Robotics Hackathon",
        text: "Un hackathon robotique avec OpenArm — un bras robotique humanoïde 7 DoF entièrement open source. Appliquez des modèles de pointe sur du matériel physique pour résoudre les défis de la préhension et de la manipulation robotique. Équipes de 3 à 5 personnes, accès distant disponible.",
      },
      {
        title: "GOSIM Agentic Hackathon",
        text: "Construisez la prochaine génération d'agents IA autonomes lors de ce hackathon intensif. Les équipes concevront, développeront et déploieront des systèmes agentiques capables de raisonner, planifier et agir — repoussant les limites de ce que les agents IA open source peuvent accomplir dans des scénarios réels.",
        link: "https://create.gosim.org/",
      },
    ]}
  />

  <!-- Marquee (Past Featured Projects) temporarily removed until projects are updated -->

  <FeaturedSpeakers
    title="Intervenants en vedette"
  />

