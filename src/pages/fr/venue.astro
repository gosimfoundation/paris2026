  <GetTickets
    title="Obtenez votre billet GOSIM Paris"
    location="Paris"
    date="5-6 mai 2026"
    text="Réservez votre place dès aujourd'hui à GOSIM Paris 2026. Collaborez avec des innovateurs, échangez avec des pionniers de l'industrie et participez à façonner l'avenir de la technologie open source."
    ctaButton={{
      text: "Obtenir des billets",
      link: "https://gosimparis2026.eventbrite.com/",
      openInNewTab: true,
    }}
  />
</Layout>

<style is:global>
  /* Connectivity Section */
  .section-connectivity {
    padding-top: var(--row-gap) !important;
    padding-bottom: var(--section-padding) !important;
  }

  .section-heading {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .connectivity-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--col-gap);
  }

  .connectivity-card {
    background: var(--color-white);
    border: 1px solid #d5d5c2;
    border-radius: 8px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .connectivity-card .card-icon {
    width: 3rem;
    height: 3rem;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-dark);
    color: var(--color-white);
  }

