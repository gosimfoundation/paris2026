---
import Layout from "layouts/LayoutLandingFr.astro"
import HeroText from "components/HeroText.astro"
import VenueInfo from "components/VenueInfo.astro"
import GetTickets from "components/GetTickets.astro"
---

<Layout
  title="Lieu – GOSIM Paris 2026"
  description="Informations sur le lieu pour GOSIM Paris 2026"
  navBackground="lightgray"
>
  <HeroText title="Lieu" lightgray />

  <VenueInfo
    subtitle="GOSIM Paris 2026"
    title="STATION F"
    location="5 Parv. Alan Turing, 75013 Paris, France"
    image="/images/venue/station-f.jpg"
    text="STATION F est le plus grand campus de start-up au monde, abritant plus de 1 000 start-up et de nombreux programmes technologiques. Situé dans le 13e arrondissement de Paris, le long de la Seine, il offre des installations exceptionnelles pour les conférences et événements. L'emblématique Halle Freyssinet s'étend sur 34 000 m² et dispose d'espaces événementiels modernes, du Wi-Fi haut débit et d'une excellente accessibilité."
  />

  <!-- Transport -->
  <section
    class="section section-connectivity"
    data-theme-section="light"
    data-bg-section="light"
  >
    <div class="container">
      <h2 class="section-heading">Comment s'y rendre</h2>
      <div class="connectivity-grid">
        <div class="connectivity-card">
          <div class="card-icon">
