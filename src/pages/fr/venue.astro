  <!-- Hôtels à proximité -->
  <section
    class="section section-hotels"
    data-theme-section="light"
    data-bg-section="lightgray"
  >
    <div class="container">
      <h2 class="section-heading">Hôtels à proximité</h2>
      <p class="hotels-intro">Voici des hôtels recommandés à distance de marche ou à proximité de STATION F.</p>
      <div class="hotels-grid">
        <div class="hotel-card">
          <h3>TOO Hôtel</h3>
          <p class="hotel-distance">350m — 5 min à pied</p>
          <p class="hotel-address">17 Bd du Général Jean Simon, 75013 Paris</p>
          <p class="hotel-desc">Hôtel moderne avec rooftop et vue panoramique sur Paris, juste à côté de STATION F.</p>
          <a class="hotel-link" href="https://toohotel.com/en/" target="_blank" rel="noopener noreferrer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
