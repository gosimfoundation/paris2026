---
// Components
import Layout from "layouts/LayoutLandingFr.astro";
import GetTickets from "components/GetTickets.astro";
import HeroText from "components/HeroText.astro";
import AllSponsors from "components/Sponsors.astro";
import TextAndSponsors from "components/TextAndSponsors.astro";
---

<Layout
  title="Soutiens – GOSIM Paris 2026"
  description="GOSIM Paris 2026 est un rassemblement de projets IA open source, de développeurs, de chercheurs et de soutiens industriels pour partager les connaissances, apprendre les uns des autres et collaborer."
  navBackground="light"
  pageTransitionName="Soutiens"
>
  <HeroText
    title="Soutiens"
    text="Nous sommes ravis de vous offrir une expérience incroyable, rendue possible grâce au généreux soutien de nos soutiens et organisations partenaires. Nous nous sommes associés à de véritables innovateurs qui repoussent les limites de notre industrie."
    lightgray
  />

  <AllSponsors lang="fr" />

  <GetTickets
    title="GOSIM Paris 2026 est terminé"
    location="Paris"
    date="5-6 mai 2026"
    text="Merci à tous ceux qui nous ont rejoints à GOSIM Paris 2026. Ce fut un rassemblement incroyable d'innovateurs, de pionniers de l'industrie et de passionnés de l'open source, façonnant ensemble l'avenir de la technologie."
    ctaButton={{
      text: "Événement terminé",
      link: "https://gosimparis2026.eventbrite.com/",
      openInNewTab: true,
    }}
  />
</Layout>
