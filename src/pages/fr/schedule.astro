---
// Components
import Layout from "layouts/LayoutLandingFr.astro";
import GetTickets from "components/GetTickets.astro";
import HeroText from "components/HeroText.astro";
import ScheduleTracks from "components/ScheduleTracks.astro";
---

<Layout
  title="Planning – GOSIM Paris 2026"
  description="GOSIM Paris 2026 est un rassemblement de projets IA open source, de développeurs, de chercheurs et de sponsors industriels pour partager les connaissances, apprendre les uns des autres et collaborer."
  navBackground="light"
  pageTransitionName="May 5"
>
  <HeroText title="Planning" lightgray />

  <ScheduleTracks currentDay="May 5" lang="fr" speakerBasePath="/fr/speakers/" />

  <GetTickets
    title="Obtenez votre billet GOSIM Paris"
    location="Paris"
    date="4-6 mai 2026"
    text="Réservez votre place dès aujourd'hui à GOSIM Paris 2026. Collaborez avec des innovateurs, échangez avec des pionniers de l'industrie et participez à façonner l'avenir de la technologie open source."
    ctaButton={{
      text: "Obtenir des billets",
      link: "https://gosimparis2026.eventbrite.com/",
      openInNewTab: true,
    }}
  />
</Layout>
