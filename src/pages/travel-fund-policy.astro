---
// Components
import Layout from "layouts/LayoutLanding.astro"
import Content from "markdown/TravelFundPolicy.md"
---

<Layout
  title="Travel Fund Policy – GOSIM Paris 2026"
  description="Travel fund reimbursement policy for GOSIM Paris 2026 attendees."
  navBackground="light"
  pageTransitionName="TravelFundPolicy"
>
  <section
    class="section speaker-detail-header"
    data-theme-section="light"
    data-bg-section="lightgray"
  >
    <div class="gradient-circle-wrap">
      <div class="gradient-circle"></div>
    </div>
    <div class="container">
      <div class="row">
        <div class="col-markdown">
          <h1>GOSIM Paris 2026 Travel Fund Policy</h1>
          <div class="template-cta-wrap">
            <a class="template-cta" href="/GOSIM-Travel-Fund-Reimbursement-Template.docx" download>Download Reimbursement Template (.docx)</a>
          </div>
          <Content />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .template-cta-wrap {
    margin: 0.5rem 0 2rem;
  }
  .template-cta {
    display: inline-block;
    padding: 0.7rem 1.8rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #333 !important;
    background: transparent;
    border: 2px solid #333;
    border-radius: 50px;
    text-decoration: none !important;
    cursor: pointer;
    box-shadow: 0 3px 8px rgba(0,0,0,0.2);
    transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }
  .template-cta:hover {
    background: #333;
    color: #fff !important;
    transform: translateY(-1px);
    box-shadow: 0 5px 14px rgba(0,0,0,0.3);
  }
</style>
