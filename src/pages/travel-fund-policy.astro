---
// Components
import Layout from "layouts/LayoutLanding.astro"
import HeroText from "components/HeroText.astro"
import Content from "markdown/TravelFundPolicy.md"
---

<Layout
  title="Travel Fund Policy – GOSIM Paris 2026"
  description="Travel fund reimbursement policy for GOSIM Paris 2026 attendees."
  navBackground="light"
  pageTransitionName="TravelFundPolicy"
>
  <HeroText
    title="Travel Fund Policy"
    lightgray
  >
    <a
      href="/GOSIM-Travel-Fund-Reimbursement-Template.docx"
      download
      class="template-cta"
    >Download Reimbursement Template (.docx)</a>
  </HeroText>

  <section
    class="section travel-section"
    data-theme-section="light"
    data-bg-section="lightgray"
  >
    <div class="container">
      <div class="travel-body">
        <Content />
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .default-header .col-text {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .default-header .col-text .col-row {
    max-width: none;
    text-align: center;
    padding-top: 0;
  }

  .travel-section {
    padding-top: var(--row-gap) !important;
  }

  .template-cta {
    display: inline-block;
    padding: 0.9rem 2.2rem;
    font-size: 1rem;
    font-weight: 700;
    color: #1a1a1a !important;
    background: transparent;
    border: 2px solid #1a1a1a;
    border-radius: 50px;
    text-decoration: none !important;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    position: relative;
  }
  .template-cta::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50px;
    border: 4px solid rgba(26, 26, 26, 0.3);
    animation: pulse-template 2s ease-in-out infinite;
    pointer-events: none;
    will-change: transform, opacity;
  }
  .template-cta:hover {
    background: #1a1a1a;
    color: #fff !important;
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
  }
  .template-cta:hover::after {
    animation: none;
    opacity: 0;
  }
  @keyframes pulse-template {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.25); opacity: 0; }
  }

  .travel-body {
    width: 100%;
    font-size: 1.05rem;
  }
  .travel-body h2 {
    font-size: 1.4rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .travel-body p {
    margin-bottom: 1rem;
    line-height: 1.6;
  }
  .travel-body ul, .travel-body ol {
    padding-left: 1.5em;
    margin-bottom: 1.5rem;
  }
  .travel-body ul {
    list-style: disc !important;
  }
  .travel-body ol {
    list-style: decimal !important;
  }
  .travel-body ul li {
    list-style: disc !important;
    display: list-item;
  }
  .travel-body ol li {
    list-style: decimal !important;
    display: list-item;
  }
  .travel-body ul li,
  .travel-body ol li {
    margin-bottom: 0.4rem;
    line-height: 1.6;
  }
  .travel-body ul li::before {
    display: none !important;
  }
  .travel-body table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
  }
  .travel-body th,
  .travel-body td {
    border: 1px solid #ccc;
    padding: 0.75rem 1rem;
    text-align: left;
  }
  .travel-body th {
    background: rgba(0,0,0,0.05);
    font-weight: 700;
  }
  .travel-body hr {
    border: none;
    border-top: 1px solid #ddd;
    margin: 2rem 0;
  }
</style>
