---
// Components
import Layout from "layouts/LayoutLanding.astro";
import GetTickets from "components/GetTickets.astro";
import HeroText from "components/HeroText.astro";
import BilingualSchedule from "components/BilingualSchedule.astro";
---

<Layout
  title="May 5 – GOSIM Paris 2026"
  description="GOSIM Paris 2026 is a gathering of open-source AI projects, developers, researchers, and industry sponsors to share knowledge, learn from each other, and collaborate."
  navBackground="light"
  pageTransitionName="May 5"
>
  <HeroText title="Schedule: May 5" lightgray />

  <BilingualSchedule currentDay="May 5" />

  <GetTickets
    title="Grab your GOSIM Paris ticket"
    location="Paris"
    date="May 4-6, 2026"
    text="Secure your spot today at GOSIM Paris 2026. Collaborate with innovators, engage with industry pioneers, and be part of shaping the future of open-source technology."
    ctaButton={{
      text: "Get Tickets",
      link: "https://gosimparis2026.eventbrite.com/",
      openInNewTab: true,
    }}
  />
</Layout>
