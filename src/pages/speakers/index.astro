---
// Components
import Layout from "layouts/LayoutLanding.astro";
import GetTickets from "components/GetTickets.astro";
import HeroText from "components/HeroText.astro";
import AllSpeakers from "components/Speakers.astro";
---

<Layout
  title="Speakers – GOSIM Paris 2026"
  description="GOSIM Paris 2026 is a gathering of open-source AI projects, developers, researchers, and industry sponsors to share knowledge, learn from each other, and collaborate."
  navBackground="light"
  pageTransitionName="Speakers"
>
  <HeroText title="Speakers" lightgray />
  <AllSpeakers />

  <GetTickets
    title="GOSIM Paris 2026 Has Concluded"
    location="Paris"
    date="May 4-6, 2026"
    text="Thank you to everyone who joined us at GOSIM Paris 2026. It was an incredible gathering of innovators, industry pioneers, and open-source enthusiasts shaping the future of technology together."
    ctaButton={{
      text: "Event Ended",
      link: "https://gosimparis2026.eventbrite.com/",
      openInNewTab: true,
    }}
  />
</Layout>
