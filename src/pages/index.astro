  <ConferenceTracks
    kicker="Conference Program"
    title="Exciting Tracks and Workshops"
    titleLink="/schedule/"
    titleLinkLabel="View Schedule"
    intro="From open source models and agent frameworks to robotics, edge AI, and the emerging layer between agentic apps and agentic operating systems, the program is built to show where the stack is moving next and let developers get close to the people building it."
    tracksTitle="Conference Tracks"
    tracks={[
      {
        title: "Agentic AI Summit",
        text: "The strategy layer of the agentic wave: protocols, software patterns, tooling, and business models. Follow MCP, A2A, sovereign AI, AI-native development, and the emerging playbook for open-source agents.",
        link: "/schedule/#agentic-ai-summit",
      },
      {
        title: "Open Source Robotics",
        text: "Where agentic software meets physical systems. Explore open robotics platforms, embodied AI stacks, and hands-on methods for building autonomous machines that can perceive, plan, and act.",
        link: "/schedule/#open-source-robotics",
      },
      {
        title: "Agentic AI on Edge",
        text: "On-device AI is experiencing a performance awakening akin to Nano Banana 2, with agentic AI rapidly infiltrating edge devices. This forum focuses on deploying powerful AI models in resource-constrained environments, diving deep into engineering practices for on-device inference acceleration, model compression, and real-time decision-making. Join us to explore how AI can unleash ultimate local intelligence even in offline and low-power scenarios.",
        link: "/schedule/#agentic-ai-on-edge",
      },
      {
        title: "Agentic OS & App",
        text: "As AI agents become the new interface between humans and machines, a new operating system layer is emerging to orchestrate them. This track explores the architecture, frameworks, and platforms powering agentic operating systems and applications — from multi-agent coordination and runtime environments to intent-driven AI-native apps, creative workflows, and the system-level primitives that enable autonomous, composable, and trustworthy AI workflows at scale.",
        link: "/schedule/#ai-generative-app",
      },
      {
        title: "Open Source Model",
        text: "Open models are advancing quickly across language, vision, audio, and video. This track follows the latest breakthroughs, practical deployments, and the new capabilities emerging from the open model ecosystem.",
        link: "/schedule/#open-source-model",
      },
    ]}
    workshopsTitle="Workshops"
    workshops={[
      {
        title: "SGLang Workshop",
        text: "Go beyond prompting and learn the project-level ideas that make SGLang fast and controllable: structured generation, RadixAttention, KV cache reuse, agent loops, and the patterns teams use to build production inference and workflow systems.",
        theme: "structured-runtime",
        link: "/schedule/#ws-sglang-paris2026",
      },
      {
        title: "vLLM Workshop",
        text: "Work directly with the vLLM serving stack: paged attention, continuous batching, multi-GPU deployment, and the operational patterns teams use to run high-throughput, low-latency open model services in production.",
        theme: "model-serving",
        link: "/schedule/#ws-vllm-paris2026",
      },
      {
        title: "Own Your Data Science and AI Workshop",
        text: "A full-day workshop on open source tooling for state-of-the-art AI — from GPU-accelerated ML frameworks to sovereign LLMs and tabular foundation models.",
        theme: "open-tooling",
        link: "/schedule/#ws-own-your-data-paris2026",
      },
      {
        title: "Build Your Own Agentic App Workshop",
        text: "A hands-on workshop where you'll build autonomous AI agents from scratch using open-source tools and frameworks, covering agent design patterns, tool integration, and real-world deployment.",
        link: "/schedule/#ws-agentic-app",
      },
    ]}
    highlightsTitle="Spotlight & Hackathon"
    highlights={[
      {
        title: "GOSIM Spotlight 2026: Frontier Creators",
        text: "Say goodbye to pure slide decks and welcome the ultimate showdown in the era of \"AI Pragmatism\"! The GOSIM Spotlight Demo will handpick the world's most commercially promising open-source AI generative projects for hardcore, live on-stage demonstrations. Selected creators will not only receive full travel sponsorships to fly to Paris but will also pitch directly to global top-tier investors and tech visionaries, claiming their open-source spotlight moment.",
        link: "https://spotlight.gosim.org/paris2026/",
      },
      {
        title: "Robotics Hackathon",
        text: "A hands-on robotics hackathon featuring OpenArm — a fully open-source 7 DoF humanoid robot arm. Apply state-of-the-art models on physical hardware to solve challenges in robotic grasping and manipulation. Teams of 3–5 people, with remote access available.",
        link: "/unaite-hackathon",
      },
      {
        title: "GOSIM Agentic Hackathon",
        text: "Build the next generation of autonomous AI agents in this intensive hackathon. Teams will design, develop, and deploy agentic systems that can reason, plan, and act — pushing the boundaries of what open-source AI agents can accomplish in real-world scenarios.",
        link: "https://create.gosim.org/",
      },
    ]}
  />

