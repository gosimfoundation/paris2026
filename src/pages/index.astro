<Layout
  title="GOSIM Paris 2026"
  description="GOSIM Paris 2026 — The Agentic AI Convergence. May 4-6, 2026 at STATION F, Paris."
  navDarkMode={true}
  navBackground="header-home"
  pageTransitionName="Home"
>
  <Hero
    date="May 4-6, 2026"
    location="STATION F, Paris"
    subtitle="The Agentic AI Convergence"
    description="Top open source projects, leading developers, and the latest agentic AI frontiers — all converging at STATION F in Paris for two days of immersive developer experiences."
