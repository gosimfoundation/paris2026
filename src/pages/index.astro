      text: "Submit a Proposal",
      link: "https://cfp.gosim.org",
      openInNewTab: true,
    }}
  />

  <TextAndImage
    id="spotlight"
    title="GOSIM Spotlight 2026: Frontier Creators"
    text="This platform celebrates creators pushing boundaries at the intersection of AI and creativity. Whether you're building products, systems, code, research, prototypes, or artistic works — we welcome submissions from developers, artists, researchers, and entrepreneurs. An independent jury will select 15-20 projects to present live in Paris. Selected creators receive global visibility, travel support, mentorship, and connections with frontier creators worldwide."
    image={SpotlightBlue}
    imageAlt="GOSIM Spotlight: Frontier Creators Paris 2026"
    dataBgSection="light"
    dataThemeSection="light"
    ctaButton={{
      text: "Apply Now",
      link: "https://spotlight.gosim.org/paris2026/",
      openInNewTab: true,
    }}
  />

