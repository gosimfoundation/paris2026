          { image: "bytedance.png", imageAlt: "ByteDance", url: "https://www.bytedance.com" },
          { image: "huggingface.png", imageAlt: "Hugging Face", logoClass: "l", url: "https://huggingface.co" },
          { image: "redhat.png", imageAlt: "Red Hat", logoClass: "xl", url: "https://www.redhat.com" },
          { image: "minimax.png", imageAlt: "Minimax", url: "https://www.minimaxi.com" },
          { image: "kimi-logo.png", imageAlt: "Kimi", url: "https://kimi.ai" },
          { image: "zhipuai.png", imageAlt: "ZhipuAI", url: "https://www.zhipuai.cn" },
          { image: "sgl.png", imageAlt: "SGLang", url: "https://sglang.ai" },
          { image: "inria.png", imageAlt: "INRIA", url: "https://www.inria.fr" },
          { image: "pollen-robotics.png", imageAlt: "Pollen Robotics", url: "https://www.pollen-robotics.com" },
          { image: "nvidia.png", imageAlt: "NVIDIA", logoClass: "xl", url: "https://www.nvidia.com" },
          { image: "probabl.png", imageAlt: "Probabl", url: "https://probabl.ai" },
          { image: "pleias.png", imageAlt: "Pleias", url: "https://pleias.fr" },
          { image: "quansight.png", imageAlt: "Quansight", url: "https://quansight.com" },
          { image: "quantstack.svg", imageAlt: "QuantStack", url: "https://quantstack.net" },
        ],
      },
    ]}
  />

  <div
    class="section-wrap"
    id="intro"
    data-theme-section="light"
    data-bg-section="lightgray"
  >
    <div class="intro-statistics-container" style="">
      <Intro
        eyebrow="GOSIM PARIS 2026 / MAY 4-6 / STATION F"
        headlineLines={[
          "Understand What's",
          "Happening At The Frontier",
          "Of Agentic AI —",
          "At GOSIM, In Paris",
        ]}
        accentLine={0}
        body="Top open source projects, leading developers, and the latest agentic AI frontiers — all converging at STATION F in Paris for two days of immersive developer experiences."
        facetsTitle="Across The Program"
        facets={[
          {
            title: "Top Projects",
            text: "Meet the teams behind llama.cpp, GLM, SGLang, vLLM, and other fast-moving open source efforts shaping the stack.",
          },
          {
            title: "Diverse Speakers",
            text: "Builders, researchers, founders, infrastructure engineers, and open source maintainers from multiple regions and communities.",
          },
          {
            title: "Latest Movements",
            text: "Follow the newest momentum across agent frameworks, MCP-style interoperability, model serving, edge deployment, and production systems.",
          },
          {
            title: "Builder Experience",
            text: "Workshops, spotlight demos, hackathons, and a global participant base make it one of Europe's most distinctive open source agentic AI conferences.",
          },
        ]}
        signals={[
          "Foundation Models",
          "Agent Frameworks",
          "Model Serving",
          "Edge Deployment",
          "Production Systems",
        ]}
        projectsLabel="Projects in the room"
        projects={[
          "llama.cpp",
          "GLM",
          "SGLang",
          "vLLM",
        ]}
      />

