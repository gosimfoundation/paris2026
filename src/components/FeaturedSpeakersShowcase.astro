<script>
  function initSpeakerShowcase(root) {
    if (!root || root.dataset.initialized === "true") {
      return;
    }

    const stage = root.closest(".speaker-constellation-stage");
    const hive = root.querySelector(".speaker-hive-shell");
    const hiveGrid = root.querySelector(".speaker-hive-grid");
    const ghostLayer = root.querySelector("[data-speaker-hive-ghosts]");
    const image = root.querySelector("[data-speaker-image]");
    const imageFallback = root.querySelector("[data-speaker-image-fallback]");
    const name = root.querySelector("[data-speaker-name]");
    const role = root.querySelector("[data-speaker-role]");
    const org = root.querySelector("[data-speaker-org]");
    const track = root.querySelector("[data-speaker-track]");
    const thesis = root.querySelector("[data-speaker-thesis]");
    const link = root.querySelector("[data-speaker-link]");
    const filterButtons = Array.from(root.querySelectorAll("[data-speaker-filter]"));
    const nodes = Array.from(root.querySelectorAll("[data-speaker-node]"));
    const signalChips = Array.from(root.querySelectorAll("[data-speaker-signal]"));

    if (
      !stage ||
      !hive ||
      !hiveGrid ||
      !name ||
      !role ||
      !org ||
      !track ||
      !thesis ||
      !link ||
      nodes.length === 0
    ) {
      return;
    }

    root.dataset.initialized = "true";
    hive.dataset.activeFilter = "all";
    hive.dataset.motionReady = "false";
    let activeIndex = 0;
    let activeFilterId = "all";
    let timerId = null;
    let isPaused = false;
    let visibleNodes = nodes.slice();
    const scaffoldCoordsCache = new Map();
    const occupiedCoordsCache = new Map();
    const neighborOffsets = [
      [1, 0],
      [1, -1],
      [0, -1],
      [-1, 0],
      [-1, 1],
      [0, 1],
    ];
    const cellScale = 1.08;
    let baseHexSize = 0;
    let baseCellWidth = 0;
    let baseCellHeight = 0;
    let filterMotionTimer = null;

    function matchesFilter(target, filterId) {
      if (filterId === "all") {
        return true;
      }

      return (target.dataset.speakerFilterBucket || "") === filterId;
    }

    function getHexCapacity(radius) {
      return 1 + 3 * radius * (radius + 1);
    }

    function coordKey({ q, r }) {
      return `${q},${r}`;
    }

    function getRingDistance({ q, r }) {
      return Math.max(Math.abs(q), Math.abs(r), Math.abs(-q - r));
    }

    function getMotionOrderMap(coords) {
      return new Map(
        coords
          .map((coord, index) => {
            const centerX = coord.q + coord.r / 2;
            const centerY = coord.r;

            return {
              index,
              distance: getRingDistance(coord),
              angle: Math.atan2(centerY, centerX),
            };
          })
          .sort((left, right) => {
            if (left.distance !== right.distance) {
              return left.distance - right.distance;
            }

            return left.angle - right.angle;
          })
          .map((entry, order) => [entry.index, order]),
      );
    }

    function sortCoords(coords) {
      return coords.slice().sort((left, right) => {
        const leftDistance = getRingDistance(left);
        const rightDistance = getRingDistance(right);
        if (leftDistance !== rightDistance) {
          return leftDistance - rightDistance;
        }

        const leftY = left.r;
        const rightY = right.r;
        if (leftY !== rightY) {
          return leftY - rightY;
        }

        const leftX = left.q + left.r / 2;
        const rightX = right.q + right.r / 2;
        return leftX - rightX;
      });
    }

    function buildScaffoldCoords(radius) {
      if (scaffoldCoordsCache.has(radius)) {
        return scaffoldCoordsCache.get(radius);
      }

      const coords = [];
      for (let r = -radius; r <= radius; r += 1) {
        const qMin = Math.max(-radius, -r - radius);
        const qMax = Math.min(radius, -r + radius);

        for (let q = qMin; q <= qMax; q += 1) {
          coords.push({ q, r });
        }
      }

      const sorted = sortCoords(coords);
      scaffoldCoordsCache.set(radius, sorted);
      return sorted;
    }

    function getScaffoldCoords(count) {
      let radius = 1;
      while (getHexCapacity(radius) < count) {
        radius += 1;
      }

      return buildScaffoldCoords(Math.max(radius, 1));
    }

    function rotateCoord(coord, turns = 1) {
      let next = { ...coord };

      for (let index = 0; index < turns; index += 1) {
        next = {
          q: -next.r,
          r: next.q + next.r,
        };
      }

      return next;
    }

    function reflectCoord(coord) {
      return {
        q: coord.q,
        r: -coord.q - coord.r,
      };
    }

    function transformCoord(coord, transformIndex) {
      if (transformIndex < 6) {
        return rotateCoord(coord, transformIndex);
      }

      return rotateCoord(reflectCoord(coord), transformIndex - 6);
    }

    function getSymmetryScore(coords, coordSet) {
      let bestScore = 0;

      for (let transformIndex = 1; transformIndex < 12; transformIndex += 1) {
        let matches = 0;

        coords.forEach((coord) => {
          if (coordSet.has(coordKey(transformCoord(coord, transformIndex)))) {
            matches += 1;
          }
        });

        bestScore = Math.max(bestScore, matches);
      }

      return bestScore;
    }

    function getComponentCount(coords) {
      if (coords.length === 0) {
        return 0;
      }

      const coordSet = new Set(coords.map(coordKey));
      const visited = new Set();
      let components = 0;

      coords.forEach((coord) => {
        const startKey = coordKey(coord);
        if (visited.has(startKey)) {
          return;
        }

        components += 1;
        const stack = [coord];
        visited.add(startKey);

        while (stack.length > 0) {
          const current = stack.pop();

          neighborOffsets.forEach(([dq, dr]) => {
            const next = { q: current.q + dq, r: current.r + dr };
            const nextKey = coordKey(next);

            if (!coordSet.has(nextKey) || visited.has(nextKey)) {
              return;
            }

            visited.add(nextKey);
            stack.push(next);
          });
        }
      });

      return components;
    }

    function chooseOccupiedCoords(count) {
      const scaffoldCoords = getScaffoldCoords(count);
      const cacheKey = `${scaffoldCoords.length}:${count}`;

      if (occupiedCoordsCache.has(cacheKey)) {
        return {
          scaffoldCoords,
          occupiedCoords: occupiedCoordsCache.get(cacheKey),
        };
      }

      if (count >= scaffoldCoords.length) {
        occupiedCoordsCache.set(cacheKey, scaffoldCoords);
        return {
          scaffoldCoords,
          occupiedCoords: scaffoldCoords,
        };
      }

      let bestCoords = scaffoldCoords.slice(0, count);
      let bestScore = -Infinity;
      const chosen = [];

      function scoreCandidate(candidate) {
        const coordSet = new Set(candidate.map(coordKey));
        const symmetryScore = getSymmetryScore(candidate, coordSet);
        const radiusScore = candidate.reduce((sum, coord) => sum + getRingDistance(coord), 0);
        const bounds = getHexBounds(candidate, 1, cellScale);
        const componentPenalty = Math.max(getComponentCount(candidate) - 1, 0) * 72;
        const centerBonus = coordSet.has("0,0") ? 72 : 0;
        const compactness = candidate.length / Math.max(bounds.width * bounds.height, 1);
        const balancePenalty = Math.abs(
          candidate.reduce((sum, coord) => sum + coord.q, 0),
        ) +
          Math.abs(candidate.reduce((sum, coord) => sum + coord.r, 0)) +
          Math.abs(candidate.reduce((sum, coord) => sum - coord.q - coord.r, 0));

        return (
          symmetryScore * 96 +
          centerBonus +
          compactness * 44 -
          radiusScore * 14 -
          balancePenalty * 60 -
          componentPenalty
        );
      }

      function search(scaffoldIndex, remaining) {
        if (remaining === 0) {
          const candidate = sortCoords(chosen);
          const score = scoreCandidate(candidate);

          if (score > bestScore) {
            bestScore = score;
            bestCoords = candidate;
          }
          return;
        }

        if (scaffoldCoords.length - scaffoldIndex < remaining) {
          return;
        }

        chosen.push(scaffoldCoords[scaffoldIndex]);
        search(scaffoldIndex + 1, remaining - 1);
        chosen.pop();
        search(scaffoldIndex + 1, remaining);
      }

      search(0, count);
      occupiedCoordsCache.set(cacheKey, bestCoords);
      return {
        scaffoldCoords,
        occupiedCoords: bestCoords,
      };
    }

    function getHexBounds(coords, size, scale = 1) {
      const halfWidth = Math.sqrt(3) * size * 0.5 * scale;
      const halfHeight = size * scale;
      let minX = Infinity;
      let maxX = -Infinity;
      let minY = Infinity;
      let maxY = -Infinity;

      if (coords.length === 0) {
        return {
          minX: 0,
          maxX: 0,
          minY: 0,
          maxY: 0,
          width: 0,
          height: 0,
        };
      }

      coords.forEach(({ q, r }) => {
        const centerX = Math.sqrt(3) * size * (q + r / 2);
        const centerY = 1.5 * size * r;

        minX = Math.min(minX, centerX - halfWidth);
        maxX = Math.max(maxX, centerX + halfWidth);
        minY = Math.min(minY, centerY - halfHeight);
        maxY = Math.max(maxY, centerY + halfHeight);
      });

      return {
        minX,
        maxX,
        minY,
        maxY,
        width: maxX - minX,
        height: maxY - minY,
      };
    }

    function ensureBaseMetrics() {
      const allCoords = getScaffoldCoords(nodes.length);
      const unitBounds = getHexBounds(allCoords, 1, cellScale);
      const availableWidth = hiveGrid.clientWidth * 0.985;

      baseHexSize = availableWidth / Math.max(unitBounds.width, 1);
      baseCellWidth = Math.sqrt(3) * baseHexSize * cellScale;
      baseCellHeight = baseHexSize * 2 * cellScale;
    }

    function renderGhostCells(
      scaffoldCoords,
      occupiedCoords,
      offsetX,
      offsetY,
      hexSize,
      cellWidth,
      cellHeight,
    ) {
      if (!ghostLayer) {
        return;
      }

      const occupiedKeys = new Set(occupiedCoords.map(coordKey));
      const ghostOrderMap = getMotionOrderMap(scaffoldCoords);
      ghostLayer.replaceChildren();

      scaffoldCoords.forEach((coord, coordIndex) => {
        if (occupiedKeys.has(coordKey(coord))) {
          return;
        }

        const centerX = Math.sqrt(3) * hexSize * (coord.q + coord.r / 2);
        const centerY = 1.5 * hexSize * coord.r;
        const x = centerX - cellWidth * 0.5 + offsetX;
        const y = centerY - cellHeight * 0.5 + offsetY;
        const ghost = document.createElement("span");

        ghost.className = "speaker-hive-ghost";
        ghost.style.setProperty("--hive-x", `${x}px`);
        ghost.style.setProperty("--hive-y", `${y}px`);
        ghost.style.setProperty("--hive-cell-width", `${cellWidth}px`);
        ghost.style.setProperty("--hive-cell-height", `${cellHeight}px`);
        ghost.style.setProperty("--ghost-delay", `${(ghostOrderMap.get(coordIndex) || 0) * 36}ms`);
        ghostLayer.appendChild(ghost);
      });
    }

    function layoutVisibleNodes(list) {
      if (list.length === 0) {
        hiveGrid.style.height = "0px";
        if (ghostLayer) {
          ghostLayer.replaceChildren();
        }
        return;
      }

      const { scaffoldCoords, occupiedCoords } = chooseOccupiedCoords(list.length);
      const isFocusedFilter = activeFilterId !== "all";
      const layoutCellScale = isFocusedFilter ? cellScale * 1.08 : cellScale;
      const unitBounds = getHexBounds(scaffoldCoords, 1, layoutCellScale);
      const availableWidth = hiveGrid.clientWidth * (isFocusedFilter ? 0.935 : 0.985);
      const maxHexSize = availableWidth / Math.max(unitBounds.width, 1);
      const expansionFactor = isFocusedFilter
        ? Math.min(1.34, 1.08 + Math.max(0, 7 - Math.min(list.length, 7)) * 0.055)
        : 1;
      const hexSize = isFocusedFilter
        ? Math.max(baseHexSize * 1.06, Math.min(maxHexSize, baseHexSize * expansionFactor))
        : baseHexSize;
      const bounds = getHexBounds(scaffoldCoords, hexSize, layoutCellScale);
      const cellWidth = Math.sqrt(3) * hexSize * layoutCellScale;
      const cellHeight = hexSize * 2 * layoutCellScale;
      const offsetX = (hiveGrid.clientWidth - bounds.width) * 0.5 - bounds.minX;
      const offsetY = Math.max(-bounds.minY, 0);
      const motionOrderMap = getMotionOrderMap(occupiedCoords);

      list.forEach((node, index) => {
        const { q, r } = occupiedCoords[index];
        const centerX = Math.sqrt(3) * hexSize * (q + r / 2);
        const centerY = 1.5 * hexSize * r;
        const x = centerX - cellWidth * 0.5 + offsetX;
        const y = centerY - cellHeight * 0.5 + offsetY;
        const motionOrder = motionOrderMap.get(index) || 0;

        node.style.setProperty("--hive-x", `${x}px`);
        node.style.setProperty("--hive-y", `${y}px`);
        node.style.setProperty("--hive-cell-width", `${cellWidth}px`);
        node.style.setProperty("--hive-cell-height", `${cellHeight}px`);
        node.style.setProperty("--motion-delay", `${motionOrder * 58}ms`);
        node.style.setProperty("--exit-delay", "0ms");
      });

      renderGhostCells(
        scaffoldCoords,
        occupiedCoords,
        offsetX,
        offsetY,
        hexSize,
        cellWidth,
        cellHeight,
      );
      hiveGrid.style.height = `${Math.max(bounds.height, cellHeight || 0)}px`;
    }

    function applyNode(node) {
      nodes.forEach((item) => item.classList.remove("is-active"));
      node.classList.add("is-active");

      name.textContent = node.dataset.speakerName || "";
      role.textContent = node.dataset.speakerRole || "";
      org.textContent = node.dataset.speakerOrg || "";
      track.textContent = node.dataset.speakerTrack || "";
      thesis.textContent = node.dataset.speakerThesis || "";
      link.setAttribute("href", node.dataset.speakerLink || "#");

      const accentFrom = node.dataset.speakerAccentFrom || "#1d4ed8";
      const accentTo = node.dataset.speakerAccentTo || "#ec4899";
      stage.style.setProperty("--speaker-accent-from", accentFrom);
      stage.style.setProperty("--speaker-accent-to", accentTo);
      track.style.setProperty("--accent-from", accentFrom);
      track.style.setProperty("--accent-to", accentTo);

      if (image && imageFallback) {
        if (node.dataset.speakerImage) {
          image.setAttribute("src", node.dataset.speakerImage);
          image.setAttribute("alt", node.dataset.speakerName || "");
          image.classList.remove("is-hidden");
          imageFallback.classList.add("is-hidden");
        } else {
          image.removeAttribute("src");
          image.setAttribute("alt", "");
          image.classList.add("is-hidden");
          imageFallback.textContent = node.dataset.speakerMonogram || "";
          imageFallback.classList.remove("is-hidden");
        }
      }
    }

    function startRotation() {
      if (timerId || visibleNodes.length < 2) {
        return;
      }

      timerId = window.setInterval(() => {
        if (isPaused) {
          return;
        }
        activeIndex = (activeIndex + 1) % visibleNodes.length;
        applyNode(visibleNodes[activeIndex]);
      }, 4600);
    }

    function stopRotation() {
      if (timerId) {
        window.clearInterval(timerId);
        timerId = null;
      }
    }

    function triggerFilterMotion() {
      if (hive.dataset.motionReady !== "true") {
        return;
      }

      hive.classList.remove("is-filter-animating");
      void hive.offsetWidth;
      hive.classList.add("is-filter-animating");

      if (filterMotionTimer) {
        window.clearTimeout(filterMotionTimer);
      }

      filterMotionTimer = window.setTimeout(() => {
        hive.classList.remove("is-filter-animating");
        filterMotionTimer = null;
      }, 1550);
    }

    function applyFilter(filterId) {
      activeFilterId = filterId;
      hive.dataset.activeFilter = filterId;

      filterButtons.forEach((button) => {
        const isActive = button.dataset.filterId === filterId;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-pressed", isActive ? "true" : "false");
      });

      visibleNodes = nodes.filter((node) => matchesFilter(node, filterId));

      nodes.forEach((node) => {
        const isVisible = matchesFilter(node, filterId);
        node.classList.toggle("is-filtered-out", !isVisible);
        node.setAttribute("aria-hidden", isVisible ? "false" : "true");
        node.tabIndex = isVisible ? 0 : -1;
      });

      nodes
        .filter((node) => !matchesFilter(node, filterId))
        .forEach((node, index) => {
          node.style.setProperty("--motion-delay", "0ms");
          node.style.setProperty("--exit-delay", `${index * 26}ms`);
        });

      signalChips.forEach((chip) => {
        const isVisible = matchesFilter(chip, filterId);
        chip.classList.toggle("is-filtered-out", !isVisible);
      });

      triggerFilterMotion();
      layoutVisibleNodes(visibleNodes);

      if (visibleNodes.length === 0) {
        stopRotation();
        return;
      }

      const currentNode = visibleNodes[activeIndex];
      const nextNode = currentNode || visibleNodes[0];
      activeIndex = visibleNodes.indexOf(nextNode);
      applyNode(nextNode);
      stopRotation();
      startRotation();
    }

    nodes.forEach((node, index) => {
      node.addEventListener("click", () => {
        activeIndex = visibleNodes.indexOf(node);
        applyNode(node);
      });
    });

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const nextFilterId = button.dataset.filterId || "all";
        if (nextFilterId === activeFilterId) {
          return;
        }
        activeIndex = 0;
        applyFilter(nextFilterId);
      });
    });

    root.addEventListener("mouseenter", () => {
      isPaused = true;
    });

    root.addEventListener("mouseleave", () => {
      isPaused = false;
    });

    const handleResize = () => {
      ensureBaseMetrics();
      layoutVisibleNodes(visibleNodes);
    };

    ensureBaseMetrics();
    applyFilter(activeFilterId);
    requestAnimationFrame(() => {
      hive.dataset.motionReady = "true";
    });
    window.addEventListener("resize", handleResize);
    window.addEventListener(
      "beforeunload",
      () => {
        stopRotation();
        if (filterMotionTimer) {
          window.clearTimeout(filterMotionTimer);
          filterMotionTimer = null;
        }
      },
      { once: true },
    );
  }

  function bootSpeakerShowcases() {
    document.querySelectorAll("[data-speaker-showcase]").forEach(initSpeakerShowcase);
  }

  bootSpeakerShowcases();
  document.addEventListener("astro:page-load", bootSpeakerShowcases);
</script>
