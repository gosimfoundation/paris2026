---
// JSON
import speakersData from "json/SpeakersCleaned.json";

interface Props {
  title: string;
  allLabel: string;
  allHref: string;
  eyebrow: string;
  intro: string;
  focusLabel: string;
  profileLabel: string;
  orbitLabel: string;
  filterLabel: string;
  filterAllLabel: string;
  filterModelBuildersLabel: string;
  filterAcademiaLabel: string;
  filterEvangelistsLabel: string;
  filterHackersLabel: string;
  filterEntrepreneursLabel: string;
  filterIndustryLabel: string;
  statVoicesLabel: string;
  statRoutesLabel: string;
  statLabsLabel: string;
  workshopBasePath: string;
  speakerBasePath: string;
}

interface SpeakerRecord {
  id: string;
  name: string;
  role?: string;
  org?: string;
  bio?: string;
  image?: string;
  draft?: boolean;
  tags?: string[];
}

const {
  title,
  allLabel,
  allHref,
  eyebrow,
  intro,
  focusLabel,
  profileLabel,
  orbitLabel,
  filterLabel,
  filterAllLabel,
  filterModelBuildersLabel,
  filterAcademiaLabel,
  filterEvangelistsLabel,
  filterHackersLabel,
  filterEntrepreneursLabel,
  filterIndustryLabel,
  statVoicesLabel,
  statRoutesLabel,
  statLabsLabel,
  workshopBasePath,
  speakerBasePath,
} = Astro.props;

const workshopCategories = new Set([
  "ws-sglang-paris2026",
  "ws-vllm-paris2026",
  "ws-future-web",
  "ws-cann",
  "ws-flutter",
  "ws-cangjie",
  "ws-edge-ai",
  "ws-chitu",
  "ws-ai-education",
  "ws-rn",
  "ws-dora",
  "ws-rust",
  "ws-sglang",
  "open-for-sdg",
  "forum-aivision",
]);

const tagMeta: Record<
  string,
  { label: string; short: string; from: string; to: string }
> = {
  "agentic-ai-summit": {
    label: "Agentic AI Summit",
    short: "Summit",
    from: "#dc2626",
    to: "#f97316",
  },
  "open-source-robotics": {
    label: "Open Source Robotics",
    short: "Robotics",
    from: "#0891b2",
    to: "#22d3ee",
  },
  "ai-generative-app": {
    label: "Agentic App",
    short: "Apps",
    from: "#2563eb",
    to: "#60a5fa",
  },
  "agentic-ai-on-edge": {
    label: "Agentic AI on Edge",
    short: "Edge",
    from: "#ca8a04",
    to: "#facc15",
  },
  "ai-hardware": {
    label: "AI Hardware",
    short: "Hardware",
    from: "#7c3aed",
    to: "#c084fc",
  },
  "open-source-model": {
    label: "Open Source Model",
    short: "Models",
    from: "#0f766e",
    to: "#2dd4bf",
  },
  "ws-sglang-paris2026": {
    label: "SGLang Workshop",
    short: "Lab",
    from: "#7c3aed",
    to: "#a78bfa",
  },
  "ws-vllm-paris2026": {
    label: "vLLM Workshop",
    short: "Lab",
    from: "#1d4ed8",
    to: "#38bdf8",
  },
};

const profileMeta = [
  {
    id: "model-builders",
    label: filterModelBuildersLabel,
    from: "#0f766e",
    to: "#2dd4bf",
  },
  {
    id: "academia",
    label: filterAcademiaLabel,
    from: "#1d4ed8",
    to: "#60a5fa",
  },
  {
    id: "evangelists",
    label: filterEvangelistsLabel,
    from: "#f59e0b",
    to: "#facc15",
  },
  {
    id: "hackers",
    label: filterHackersLabel,
    from: "#7c3aed",
    to: "#a78bfa",
  },
  {
    id: "entrepreneurs",
    label: filterEntrepreneursLabel,
    from: "#dc2626",
    to: "#f97316",
  },
  {
    id: "industry",
    label: filterIndustryLabel,
    from: "#0f172a",
    to: "#475569",
  },
] as const;
const profileMetaById = Object.fromEntries(profileMeta.map((item) => [item.id, item]));

const filteredSpeakers = (speakersData.speakers as SpeakerRecord[]).filter(
  (speaker) => speaker.draft !== true && speaker.id !== "tbd",
);

const sentenceFromBio = (bio = "") => {
  const cleaned = bio.replace(/\s+/g, " ").trim();
  if (!cleaned) {
    return "Open-source builders bringing their best systems, tooling, and field notes to Paris.";
  }

  const sentences = cleaned
    .split(/(?<=[.!?。])/)
    .map((part) => part.trim())
    .filter(Boolean);

  const first = sentences[0] || cleaned;
  if (first.length <= 150) {
    return first;
  }
  return `${first.slice(0, 147).trim()}...`;
};

const speakerHref = (speaker: SpeakerRecord) => {
  const hasWorkshopTag = speaker.tags?.some((tag) => workshopCategories.has(tag));
  const basePath = hasWorkshopTag ? workshopBasePath : speakerBasePath;
  return `${basePath}${speaker.id}/`;
};

const includesAny = (text: string, keywords: string[]) =>
  keywords.some((keyword) => text.includes(keyword));
const matchesAnyPattern = (text: string, patterns: RegExp[]) =>
  patterns.some((pattern) => pattern.test(text));

type SpeakerProfileBucket =
  | "model-builders"
  | "academia"
  | "evangelists"
  | "hackers"
  | "entrepreneurs"
  | "industry";

// Editorial rule: open-source project work belongs under "Hackers",
// even when the speaker also has a founder, research, or company title.
const curatedProfileBuckets: Record<string, SpeakerProfileBucket> = {
  "chao-jia": "hackers",
  "charbel-dandjinou": "entrepreneurs",
  "crozet-sbastien": "hackers",
  "dong-xin": "industry",
  "jiaming-liu": "academia",
  "jigyasa-grover-co-speaker-rishabh-misra": "model-builders",
  "jinwei-gu": "model-builders",
  "nouamane-tazi": "model-builders",
  "qingyueannie-wang": "evangelists",
  "xinyuan-tong": "hackers",
  "xuan-son-nguyen": "hackers",
  "yonghui-wu": "academia",
  "yuhao-yang": "hackers",
  "yuxuan-zhang": "evangelists",
  "guillaume-blaquiere": "hackers",
  "wzcai99": "hackers",
};

const profileBucketForSpeaker = (speaker: SpeakerRecord) => {
  const curatedBucket = curatedProfileBuckets[speaker.id];
  if (curatedBucket) {
    return curatedBucket;
  }

  const role = (speaker.role || "").toLowerCase();
  const org = (speaker.org || "").toLowerCase();
  const bio = (speaker.bio || "").toLowerCase();
  const text = `${role} ${org} ${bio}`.replace(/\s+/g, " ");
  const isAcademicOrg = includesAny(org, ["university", "laboratory", "college"]);
  const isProjectOrg = includesAny(org, ["sglang"]);
  const isOpenSourceHacker =
    includesAny(text, [
      "open source",
      "open-source",
      "open-sourced",
      "maintainer",
      "core maintainer",
    ]) ||
    (isProjectOrg && includesAny(role, ["maintainer", "developer"]));

  if (isOpenSourceHacker) {
    return "hackers";
  }

  const isEntrepreneur = matchesAnyPattern(role, [
    /\bfounder\b/,
    /\bco-founder\b/,
    /\bceo\b/,
    /\bcto\b/,
    /\bvice president\b/,
    /\bvp\b/,
  ]);
  if (isEntrepreneur) {
    return "entrepreneurs";
  }

  const isAcademia = matchesAnyPattern(role, [
    /\bprofessor\b/,
    /\bresearcher\b/,
    /\bph\.?d\.? student\b/,
  ]) ||
    isAcademicOrg ||
    matchesAnyPattern(bio, [/\bprofessor\b/, /\bvisiting scholar\b/]);
  if (isAcademia) {
    return "academia";
  }

  const isModelBuilder = includesAny(text, [
    "machine learning",
    "ml tech lead",
    "ml research engineer",
    "ml ",
    " ml",
    "ai lead",
    "large language model",
    "large language models",
    "foundation model",
    "foundation models",
    "world model",
    "world models",
    "generative ai",
    "embodied ai",
    "training",
    "agentic ai",
    "model",
  ]);
  if (isModelBuilder) {
    return "model-builders";
  }

  const isEvangelist = matchesAnyPattern(role, [
    /\bevangelist\b/,
    /\bdeveloper relations\b/,
    /\bdeveloper advocate\b/,
    /\badvocate\b/,
  ]);
  if (isEvangelist) {
    return "evangelists";
  }

  if (org && !isAcademicOrg) {
    return "industry";
  }

  return "hackers";
};

const enrichSpeaker = (speaker: SpeakerRecord) => {
  const primaryTag = speaker.tags?.[0] || "";
  const meta = tagMeta[primaryTag] || {
    label: "GOSIM Paris",
    short: "Live",
    from: "#1d4ed8",
    to: "#ec4899",
  };

  return {
    ...speaker,
    primaryTag,
    profileBucket: profileBucketForSpeaker(speaker),
    trackLabel: meta.label,
    trackShort: meta.short,
    accentFrom: meta.from,
    accentTo: meta.to,
    href: speakerHref(speaker),
    thesis: sentenceFromBio(speaker.bio),
    monogram: speaker.name
      .split(/\s+/)
      .slice(0, 2)
      .map((part) => part[0]?.toUpperCase() || "")
      .join(""),
  };
};

const interleaveByGroup = (
  speakers: ReturnType<typeof enrichSpeaker>[],
  getBucketKey: (speaker: ReturnType<typeof enrichSpeaker>) => string,
) => {
  const buckets = new Map<string, ReturnType<typeof enrichSpeaker>[]>();

  speakers.forEach((speaker) => {
    const bucketKey = getBucketKey(speaker) || "general";
    if (!buckets.has(bucketKey)) {
      buckets.set(bucketKey, []);
    }
    buckets.get(bucketKey)?.push(speaker);
  });

  const queue = Array.from(buckets.values()).sort((a, b) => b.length - a.length);
  const ordered: ReturnType<typeof enrichSpeaker>[] = [];

  while (queue.some((bucket) => bucket.length > 0)) {
    queue.forEach((bucket) => {
      const next = bucket.shift();
      if (next) {
        ordered.push(next);
      }
    });
  }

  return ordered;
};

const curatedSpeakers = interleaveByGroup(filteredSpeakers.map(enrichSpeaker), (speaker) =>
  speaker.profileBucket || speaker.primaryTag || "general",
);
const spotlightSpeaker = curatedSpeakers[0];
const activeRouteCount = new Set(filteredSpeakers.flatMap((speaker) => speaker.tags || [])).size;
const workshopLeadCount = filteredSpeakers.filter((speaker) =>
  speaker.tags?.some((tag) => workshopCategories.has(tag)),
).length;
const availableFilterIds = profileMeta
  .map((profile) => profile.id)
  .filter((profileId) =>
    curatedSpeakers.some((speaker) => speaker.profileBucket === profileId),
  );
const speakerFilters = [
  {
    id: "all",
    label: filterAllLabel,
    count: curatedSpeakers.length,
    from: "#0f172a",
    to: "#475569",
  },
  ...availableFilterIds.map((profileId) => ({
    id: profileId,
    label: profileMetaById[profileId].label,
    count: curatedSpeakers.filter((speaker) => speaker.profileBucket === profileId).length,
    from: profileMetaById[profileId].from,
    to: profileMetaById[profileId].to,
  })),
];
---

<section
  class="section section-speaker-constellation"
  data-theme-section="light"
  data-bg-section="light"
>
  <div class="speaker-grid-glow"></div>
  <div class="container wide speaker-constellation-shell">
    <div class="speaker-constellation-head">
      <div class="speaker-headline">
        <span class="speaker-kicker">{eyebrow}</span>
        <h2>{title}</h2>
      </div>
      <p class="speaker-intro">{intro}</p>
    </div>

    <div class="speaker-constellation-metrics">
      <div class="metric-card">
        <strong>{String(filteredSpeakers.length).padStart(2, "0")}</strong>
        <span>{statVoicesLabel}</span>
      </div>
      <div class="metric-card">
        <strong>{String(activeRouteCount).padStart(2, "0")}</strong>
        <span>{statRoutesLabel}</span>
      </div>
      <div class="metric-card">
        <strong>{String(workshopLeadCount).padStart(2, "0")}</strong>
        <span>{statLabsLabel}</span>
      </div>
    </div>

    <div class="speaker-constellation-stage" data-speaker-showcase>
      <article class="speaker-spotlight">
        <div class="speaker-spotlight-visual">
          <div class="speaker-aura"></div>
          <div class="speaker-image-shell">
            <img
              src={spotlightSpeaker.image || ""}
              alt={spotlightSpeaker.image ? spotlightSpeaker.name : ""}
              class={`speaker-spotlight-image${spotlightSpeaker.image ? "" : " is-hidden"}`}
              data-speaker-image
            />
            <div
              class={`speaker-spotlight-monogram${spotlightSpeaker.image ? " is-hidden" : ""}`}
              data-speaker-image-fallback
            >
              {spotlightSpeaker.monogram}
            </div>
          </div>
        </div>

        <div class="speaker-spotlight-copy">
          <span class="speaker-focus-label">{focusLabel}</span>
          <span
            class="speaker-track-pill"
            data-speaker-track
            style={`--accent-from:${spotlightSpeaker.accentFrom}; --accent-to:${spotlightSpeaker.accentTo};`}
          >
            {spotlightSpeaker.trackLabel}
          </span>
          <h3 data-speaker-name>{spotlightSpeaker.name}</h3>
          <p class="speaker-role" data-speaker-role>{spotlightSpeaker.role}</p>
          <p class="speaker-org" data-speaker-org>{spotlightSpeaker.org}</p>
          <p class="speaker-thesis" data-speaker-thesis>{spotlightSpeaker.thesis}</p>

          <div class="speaker-actions">
            <a href={spotlightSpeaker.href} class="speaker-profile-link" data-speaker-link>
              {profileLabel} <span>&rarr;</span>
            </a>
            <a href={allHref} class="speaker-all-link">
              {allLabel} <span>&rarr;</span>
            </a>
          </div>
        </div>
      </article>

      <div class="speaker-hive-shell">
        <div class="speaker-hive-header">
          <span class="speaker-hive-label">{orbitLabel}</span>
          <div class="speaker-filter-strip" role="group" aria-label={filterLabel}>
            {
              speakerFilters.map((filter, index) => (
                <button
                  type="button"
                  class={`speaker-filter-chip${index === 0 ? " is-active" : ""}`}
                  style={`--accent-from:${filter.from}; --accent-to:${filter.to};`}
                  data-speaker-filter
                  data-filter-id={filter.id}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  <span class="speaker-filter-swatch"></span>
                  <span>{filter.label}</span>
                  <strong class="speaker-filter-count">{String(filter.count).padStart(2, "0")}</strong>
                </button>
              ))
            }
          </div>
        </div>

        <div class="speaker-hive-grid">
          <div class="speaker-hive-ghosts" data-speaker-hive-ghosts aria-hidden="true"></div>
          {
            curatedSpeakers.map((speaker, index) => (
              <button
                type="button"
                class={`speaker-node speaker-hive-cell${index === 0 ? " is-active" : ""}`}
                style={`--accent-from:${speaker.accentFrom}; --accent-to:${speaker.accentTo};`}
                data-speaker-node
                data-speaker-name={speaker.name}
                data-speaker-role={speaker.role || ""}
                data-speaker-org={speaker.org || ""}
                data-speaker-track={speaker.trackLabel}
                data-speaker-filter-bucket={speaker.profileBucket}
                data-speaker-thesis={speaker.thesis}
                data-speaker-link={speaker.href}
                data-speaker-image={speaker.image || ""}
                data-speaker-monogram={speaker.monogram}
                data-speaker-accent-from={speaker.accentFrom}
                data-speaker-accent-to={speaker.accentTo}
                aria-label={speaker.name}
              >
                <span class="speaker-node-pulse"></span>
                <span class="speaker-hive-wall"></span>
                {
                  speaker.image ? (
                    <img src={speaker.image} alt={speaker.name} class="speaker-node-image" />
                  ) : (
                    <span class="speaker-node-monogram">{speaker.monogram}</span>
                  )
                }
              </button>
            ))
          }
        </div>

        <div class="speaker-signal-strip">
          {
            curatedSpeakers.map((speaker) => (
              <a
                href={speaker.href}
                class="speaker-signal-chip"
                data-speaker-signal
                data-speaker-filter-bucket={speaker.profileBucket}
              >
                <span
                  class="speaker-signal-dot"
                  style={`--accent-from:${speaker.accentFrom}; --accent-to:${speaker.accentTo};`}
                ></span>
                {speaker.name}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-speaker-constellation {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 12% 18%, rgba(96, 165, 250, 0.16), transparent 28%),
      radial-gradient(circle at 88% 14%, rgba(244, 114, 182, 0.15), transparent 26%),
      linear-gradient(180deg, #f8fbff 0%, #eef4fb 100%);
  }

  .section-speaker-constellation::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(148, 163, 184, 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 184, 0.12) 1px, transparent 1px);
    background-size: 2.75rem 2.75rem;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.85), transparent);
    pointer-events: none;
  }

  .speaker-grid-glow {
    position: absolute;
    inset: auto -10% -15% auto;
    width: 32rem;
    height: 32rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(14, 165, 233, 0.18), transparent 70%);
    filter: blur(20px);
    pointer-events: none;
  }

  .speaker-constellation-shell {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2rem;
  }

  .speaker-constellation-head {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    gap: 2rem;
    align-items: end;
  }

  .speaker-headline h2 {
    margin: 0;
    font-size: clamp(2.4rem, 4.2vw, 4.8rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .speaker-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #0f172a;
  }

  .speaker-kicker::before {
    content: "";
    width: 3rem;
    height: 1px;
    background: linear-gradient(90deg, #0ea5e9, transparent);
  }

  .speaker-intro {
    margin: 0;
    max-width: 38rem;
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(15, 23, 42, 0.74);
  }

  .speaker-constellation-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .metric-card {
    min-width: 9rem;
    padding: 0.9rem 1rem;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(12px);
    box-shadow: 0 14px 34px rgba(15, 23, 42, 0.06);
  }

  .metric-card strong {
    display: block;
    font-size: 1.55rem;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #0f172a;
  }

  .metric-card span {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(15, 23, 42, 0.48);
  }

  .speaker-constellation-stage {
    --speaker-accent-from: #1d4ed8;
    --speaker-accent-to: #ec4899;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 1.75rem;
    align-items: stretch;
  }

  .speaker-spotlight,
  .speaker-hive-shell {
    position: relative;
    min-height: 40rem;
    border-radius: 2rem;
    overflow: hidden;
    border: 1px solid rgba(15, 23, 42, 0.08);
    background: rgba(255, 255, 255, 0.78);
    box-shadow: 0 24px 70px rgba(15, 23, 42, 0.08);
    backdrop-filter: blur(16px);
  }

  .speaker-spotlight {
    display: grid;
    grid-template-columns: minmax(13rem, 0.9fr) minmax(0, 1.1fr);
  }

  .speaker-spotlight::before {
    content: "";
    position: absolute;
    inset: 1rem;
    border-radius: 1.55rem;
    background:
      linear-gradient(140deg, rgba(255, 255, 255, 0.65), rgba(255, 255, 255, 0.05)),
      radial-gradient(circle at top, color-mix(in srgb, var(--speaker-accent-from) 12%, transparent), transparent 55%);
    pointer-events: none;
  }

  .speaker-spotlight-visual,
  .speaker-spotlight-copy {
    position: relative;
    z-index: 1;
  }

  .speaker-spotlight-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem 2rem 2rem;
  }

  .speaker-aura {
    position: absolute;
    inset: auto;
    width: 18rem;
    height: 18rem;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--speaker-accent-from) 34%, transparent),
      transparent 72%
    );
    filter: blur(10px);
    animation: aura-breathe 7s ease-in-out infinite;
  }

  .speaker-image-shell {
    position: relative;
    width: min(100%, 20rem);
    aspect-ratio: 4 / 5;
    border-radius: 1.8rem;
    overflow: hidden;
    background:
      linear-gradient(160deg, var(--speaker-accent-from), var(--speaker-accent-to));
    box-shadow:
      0 22px 60px color-mix(in srgb, var(--speaker-accent-from) 16%, transparent),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
    transform: rotate(-4deg);
  }

  .speaker-image-shell::after {
    content: "";
    position: absolute;
    inset: 1rem;
    border-radius: 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.26);
    pointer-events: none;
  }

  .speaker-spotlight-image,
  .speaker-spotlight-monogram {
    width: 100%;
    height: 100%;
  }

  .speaker-spotlight-image.is-hidden,
  .speaker-spotlight-monogram.is-hidden {
    display: none;
  }

  .speaker-spotlight-image {
    object-fit: cover;
    object-position: center 18%;
  }

  .speaker-spotlight-monogram {
    display: grid;
    place-items: center;
    font-size: 4rem;
    font-weight: 800;
    letter-spacing: -0.06em;
    color: #fff;
  }

  .speaker-spotlight-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.85rem;
    padding: 2.3rem 2.4rem 2.3rem 0.6rem;
  }

  .speaker-focus-label {
