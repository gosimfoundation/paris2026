---
import FeaturedSpeakersShowcase from "./FeaturedSpeakersShowcase.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<FeaturedSpeakersShowcase
  title={title}
  allLabel="All Speakers"
  allHref="/speakers/"
  eyebrow="Speaker Hive"
  intro="A dense rotating hive of founders, maintainers, and systems builders defining the agentic AI stack in public."
  focusLabel="In Focus"
  profileLabel="Open profile"
  orbitLabel="Live speaker hive"
  filterLabel="Filter by speaker profile"
  filterAllLabel="All"
  filterModelBuildersLabel="Model Builders"
  filterAcademiaLabel="Academia"
  filterEvangelistsLabel="Evangelists"
  filterHackersLabel="Hackers"
  filterEntrepreneursLabel="Entrepreneurs"
  filterIndustryLabel="Industry"
  statVoicesLabel="featured voices"
  statRoutesLabel="active routes"
  statLabsLabel="workshop leads"
  workshopBasePath="/workshops/"
  speakerBasePath="/speakers/"
/>
