---
import FeaturedSpeakersShowcase from "./FeaturedSpeakersShowcase.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<FeaturedSpeakersShowcase
  title={title}
  allLabel="全部演讲嘉宾"
  allHref="/zh/speakers/"
  eyebrow="Speaker Hive"
  intro="用一组更密集、会旋转的嘉宾蜂巢来呈现本届大会最有代表性的创作者、维护者与系统构建者。"
  focusLabel="焦点人物"
  profileLabel="查看主页"
  orbitLabel="演讲嘉宾蜂巢"
  filterLabel="按嘉宾画像筛选"
  filterAllLabel="全部"
  filterModelBuildersLabel="模型构建者"
  filterAcademiaLabel="学术界"
  filterEvangelistsLabel="布道者"
  filterHackersLabel="黑客"
  filterEntrepreneursLabel="创业者"
  filterIndustryLabel="产业界"
  statVoicesLabel="焦点嘉宾"
  statRoutesLabel="主题路线"
  statLabsLabel="工作坊讲师"
  workshopBasePath="/zh/workshops/"
  speakerBasePath="/zh/speakers/"
/>
