---
export interface Props {
  events: Array<{
    date: string;
    title: string;
    isoDate: string;
    type?: "cfp" | "spotlight" | "event";
  }>;
  todayLabel?: string;
}

const {
  events = [],
  todayLabel = "Today",
} = Astro.props;

// Calculate proportional positions (0–100%)
const timestamps = events.map((e) => new Date(e.isoDate).getTime());
const minTime = Math.min(...timestamps);
const maxTime = Math.max(...timestamps);
const range = maxTime - minTime || 1;
const positions = timestamps.map((t) => ((t - minTime) / range) * 100);

// Pass range data to client script
const isoDateList = events.map((e) => e.isoDate);
---

<section
  class="section section-timeline"
  id="timeline"
  data-theme-section="light"
  data-bg-section="light"
  data-scroll-section
>
  <div class="container">
    <div class="row">
    <div class="tl-wrap">
      <!-- line -->
      <div class="tl-line"></div>

      <!-- today (positioned by client JS) -->
      <div class="tl-today" style="display:none"
        data-min={isoDateList[0]}
        data-max={isoDateList[isoDateList.length - 1]}
      >
        <span class="tl-today-text">{todayLabel}</span>
        <div class="tl-today-needle"></div>
      </div>

      <!-- events -->
      {events.map((ev, i) => {
        const side = i % 2 === 0 ? "above" : "below";
        const t = ev.type || "event";
        return (
          <div class={`tl-ev tl-ev--${side} tl-ev--${t}`} style={`left:${positions[i]}%`}>
            <div class="tl-dot"></div>
            <div class="tl-info">
              <h4>{ev.date}</h4>
              <p>{ev.title}</p>
            </div>
          </div>
        );
      })}
    </div>
    </div>
  </div>
</section>

<style lang="scss">
  .section-timeline {
    padding-top: calc(var(--section-padding) * 0.5) !important;
    padding-bottom: 0 !important;
  }

  /* wrapper — tall enough for labels above & below */
  .tl-wrap {
    position: relative;
    width: 100%;
    height: 280px;       /* fixed height so abs children have space */
  }

  /* horizontal line at vertical center */
  .tl-line {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 4px;
    background: #1a1a1a;
    border-radius: 2px;
    transform: translateY(-50%);
    z-index: 1;
  }

  /* each event pin */
  .tl-ev {
    position: absolute;
    top: 50%;
    transform: translate(0, -50%);  /* vertically center the dot on the line */
    z-index: 2;
  }

  .tl-dot {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    margin-left: -10px;   /* center dot on left edge */
  }

  .tl-ev--cfp .tl-dot      { background: var(--color-primary); }
  .tl-ev--spotlight .tl-dot { background: var(--color-secondary); }
  .tl-ev--event .tl-dot     { background: #1a1a1a; }

  /* label block */
  .tl-info {
    position: absolute;
    left: -10px;
    white-space: nowrap;

    h4 { margin: 0; padding-bottom: 4px; }
    p  { margin: 0; }
  }

  .tl-ev--cfp .tl-info      { h4, p { color: var(--color-primary); } }
  .tl-ev--spotlight .tl-info { h4, p { color: var(--color-secondary); } }
  .tl-ev--event .tl-info     { h4, p { color: #1a1a1a; } }

  /* above: label sits above dot */
  .tl-ev--above .tl-info {
    bottom: 28px;       /* 20px dot + 8px gap */
  }
  /* below: label sits below dot */
  .tl-ev--below .tl-info {
    top: 28px;
  }

  /* ---- today marker ---- */
  .tl-today {
    position: absolute;
    top: 0;
    bottom: 0;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
  }
  .tl-today-needle {
    width: 2px;
    flex: 1;
    background: #e74c3c;
    border-radius: 1px;
  }
  .tl-today-text {
    font-size: 0.75rem;
    font-weight: 700;
    color: #e74c3c;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding-bottom: 4px;
  }

  .tl-today[style*="display:none"] {
    display: none !important;
  }

  /* ---- mobile: vertical layout ---- */
  @media screen and (max-width: 768px) {
    .tl-wrap {
      height: auto;
      padding-left: 2.5rem;
    }

    .tl-line {
      top: 0;
      left: 0;
      right: auto;
      width: 4px;
      height: 100%;
      transform: none;
    }

    .tl-ev {
      position: relative;
      top: auto;
      left: auto !important;
      transform: none;
      padding: 1.5rem 0;
    }

    .tl-dot {
      position: absolute;
      left: -2.5rem;
      top: 50%;
      transform: translateY(-50%);
      margin-left: -10px;
    }

    .tl-info {
      position: relative !important;
      left: 0 !important;
      top: auto !important;
      bottom: auto !important;
      white-space: normal;
    }

    .tl-today {
      position: relative;
      top: auto;
      bottom: auto;
      left: auto !important;
      transform: none;
      flex-direction: row;
      padding: 1rem 0;
      gap: 0.5rem;
    }
    .tl-today-needle {
      width: 20px;
      height: 2px;
      flex: none;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const el = document.querySelector(".tl-today") as HTMLElement;
    if (!el) return;

    const minDate = new Date(el.dataset.min!).getTime();
    const maxDate = new Date(el.dataset.max!).getTime();
    const range = maxDate - minDate;
    if (!range) return;

    const now = Date.now();
    const pct = ((now - minDate) / range) * 100;

    if (pct >= 0 && pct <= 100) {
      el.style.left = pct + "%";
      el.style.display = "";
    }
  });
</script>
