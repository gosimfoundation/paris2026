---
---

<canvas id="amazinghand-canvas"></canvas>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";
  import { STLLoader } from "three/examples/jsm/loaders/STLLoader.js";

  const HF_BASE = "https://huggingface.co/datasets/haixuantao/urdfs/resolve/main/amazinghand";

  function quatFromMJCF(q: string): THREE.Quaternion {
    const [w, x, y, z] = q.split(/\s+/).map(Number);
    return new THREE.Quaternion(x, y, z, w);
  }

  function posFromMJCF(p: string): THREE.Vector3 {
    const [x, y, z] = p.split(/\s+/).map(Number);
    return new THREE.Vector3(x, y, z);
  }

  function parseMJCFBody(bodyEl: Element, stlLoader: STLLoader, parent: THREE.Object3D, material: THREE.Material) {
    const pos = bodyEl.getAttribute("pos");
    const quat = bodyEl.getAttribute("quat");

    const group = new THREE.Group();
    if (pos) group.position.copy(posFromMJCF(pos));
    if (quat) group.quaternion.copy(quatFromMJCF(quat));

    const geoms = bodyEl.querySelectorAll(":scope > geom[class='visual']");
    geoms.forEach((geom) => {
      const meshName = geom.getAttribute("mesh");
      const geomPos = geom.getAttribute("pos");
      const geomQuat = geom.getAttribute("quat");
      if (!meshName) return;

      stlLoader.load(
        `${HF_BASE}/assets/${meshName}.stl`,
        (geometry: THREE.BufferGeometry) => {
          const mesh = new THREE.Mesh(geometry, material);
          if (geomPos) mesh.position.copy(posFromMJCF(geomPos));
          if (geomQuat) mesh.quaternion.copy(quatFromMJCF(geomQuat));
          group.add(mesh);
        }
      );
    });

    const childBodies = bodyEl.querySelectorAll(":scope > body");
    childBodies.forEach((child) => {
      parseMJCFBody(child, stlLoader, group, material);
    });

    parent.add(group);
  }

  async function initAmazingHand() {
    const canvas = document.getElementById("amazinghand-canvas") as HTMLCanvasElement;
    if (!canvas) return;

    const container = canvas.closest('.viewer-amazinghand') as HTMLElement;
    if (!container) return;

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    } catch {
      canvas.style.display = "none";
      return;
    }

    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();

    scene.add(new THREE.AmbientLight(0xffffff, 0.4));
    const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
    dirLight.position.set(5, 10, 7);
    scene.add(dirLight);
    const dirLight2 = new THREE.DirectionalLight(0x4488ff, 0.3);
    dirLight2.position.set(-5, 3, -5);
    scene.add(dirLight2);

    const camera = new THREE.PerspectiveCamera(45, 1, 0.001, 100);
    camera.position.set(0.15, 0.15, 0.25);
    camera.lookAt(0, 0.05, 0);

    const controls = new OrbitControls(camera, canvas);
    controls.autoRotate = true;
    controls.autoRotateSpeed = 1.0;
    controls.enableZoom = false;
    controls.enablePan = false;
    controls.target.set(0, 0.05, 0);
    controls.update();

    const material = new THREE.MeshPhongMaterial({
      color: 0x8899aa,
      specular: 0x222222,
      shininess: 40,
    });

    // Use LoadingManager to know when all meshes are loaded
    const manager = new THREE.LoadingManager();
    const rootGroup = new THREE.Group();

    manager.onLoad = () => {
      // All meshes loaded — auto-center and scale
      const box = new THREE.Box3().setFromObject(rootGroup);
      const size = box.getSize(new THREE.Vector3());
      const maxDim = Math.max(size.x, size.y, size.z);
      if (maxDim > 0) {
        const scale = 0.25 / maxDim;
        rootGroup.scale.setScalar(scale);
        const box2 = new THREE.Box3().setFromObject(rootGroup);
        const center2 = box2.getCenter(new THREE.Vector3());
        rootGroup.position.sub(center2);
        rootGroup.position.y += box2.getSize(new THREE.Vector3()).y / 2;
        controls.target.set(0, box2.getSize(new THREE.Vector3()).y / 2, 0);
        controls.update();
      }
    };

    const stlLoader = new STLLoader(manager);

    // Fetch and parse the MJCF XML
    const response = await fetch(`${HF_BASE}/robot.xml`);
    const xmlText = await response.text();
    const parser = new DOMParser();
    const xmlDoc = parser.parseFromString(xmlText, "text/xml");

    const worldbody = xmlDoc.querySelector("worldbody");
    if (!worldbody) return;

    const rootBodies = worldbody.querySelectorAll(":scope > body");
    rootBodies.forEach((body) => {
      parseMJCFBody(body, stlLoader, rootGroup, material);
    });

    scene.add(rootGroup);

    function resize() {
      const w = container.clientWidth;
      const h = container.clientHeight;
      if (w === 0 || h === 0) return;
      renderer.setSize(w, h);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    resize();

    const ro = new ResizeObserver(resize);
    ro.observe(container);

    let visible = true;
    const io = new IntersectionObserver(
      ([entry]) => { visible = entry.isIntersecting; },
      { threshold: 0 }
    );
    io.observe(canvas);

    function animate() {
      requestAnimationFrame(animate);
      if (!visible) return;
      controls.update();
      renderer.render(scene, camera);
    }
    animate();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAmazingHand);
  } else {
    initAmazingHand();
  }
</script>

<style>
  #amazinghand-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: auto;
  }
</style>
