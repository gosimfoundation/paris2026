---
import FeaturedSpeakersShowcase from "./FeaturedSpeakersShowcase.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<FeaturedSpeakersShowcase
  title={title}
  allLabel="Tous les intervenants"
  allHref="/fr/speakers/"
  eyebrow="Ruche"
  intro="Une ruche dense et mobile de fondateurs, mainteneurs et architectes open source qui donnent forme a l'ere agentique."
  focusLabel="A la une"
  profileLabel="Voir le profil"
  orbitLabel="Ruche d'intervenants"
  filterLabel="Filtrer par profil d'intervenant"
  filterAllLabel="Tous"
  filterModelBuildersLabel="Constructeurs de modeles"
  filterAcademiaLabel="Academia"
  filterEvangelistsLabel="Evangelistes"
  filterHackersLabel="Hackers"
  filterEntrepreneursLabel="Entrepreneurs"
  filterIndustryLabel="Industrie"
  statVoicesLabel="voix selectionnees"
  statRoutesLabel="routes actives"
  statLabsLabel="leads workshop"
  workshopBasePath="/fr/workshops/"
  speakerBasePath="/fr/speakers/"
/>
