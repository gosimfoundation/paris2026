---
// JSON
import speakersData from "json/Speakers.json";

const filteredSpeakers = speakersData.speakers.filter(
  (speaker) => speaker.draft !== true && speaker.id !== "tbd",
);

interface Props {
  title: string;
}

const { title } = Astro.props;

const getRouteForTag = (tagId: string): string => {
  const workshopCategories = ["ws-future-web", "ws-cann", "ws-flutter", "ws-cangjie", "ws-edge-ai", "ws-chitu", "ws-ai-education", "ws-rn", "ws-dora", "ws-rust", "ws-sglang", "open-for-sdg", "forum-aivision"];
  if (workshopCategories.includes(tagId)) {
    return "/fr/workshops/";
  }
  return "/fr/speakers/";
};
---

<section
  class="section section-speakers-featured"
  data-theme-section="light"
  data-bg-section="light"
>
  <div class="container wide">
    <div class="row">
      <div class="col col-title">
        <h2>{title}</h2>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="speakers-marquee-container">
      <div class="speakers-track">
        {
          filteredSpeakers.map((loop) => (
            <a
              href={`${getRouteForTag(loop.tags?.[0] || '')}${loop.id}/`}
              class="speaker-slide"
            >
              <div class="single-speakers-card">
                <div class="card-row card-row-image">
                  <div class="card-image">
                    {loop?.image && (
                      <img src={loop.image} alt={loop.name} class="overlay" />
                    )}
                  </div>
                </div>
                <div class="card-row card-row-info">
                  <h3 class="h5">{loop.name}</h3>
                  <p>{loop.role}</p>
                  <p>{loop.org}</p>
                </div>
              </div>
            </a>
          ))
        }
        {
          filteredSpeakers.map((loop) => (
            <a
              href={`${getRouteForTag(loop.tags?.[0] || '')}${loop.id}/`}
              class="speaker-slide"
            >
              <div class="single-speakers-card">
                <div class="card-row card-row-image">
                  <div class="card-image">
                    {loop?.image && (
                      <img src={loop.image} alt={loop.name} class="overlay" />
                    )}
                  </div>
                </div>
                <div class="card-row card-row-info">
                  <h3 class="h5">{loop.name}</h3>
                  <p>{loop.role}</p>
                  <p>{loop.org}</p>
                </div>
              </div>
            </a>
          ))
        }
      </div>
      <button class="speakers-nav-btn speakers-prev" aria-label="Previous speakers">&#8592;</button>
      <button class="speakers-nav-btn speakers-next" aria-label="Next speakers">&#8594;</button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.speakers-marquee-container').forEach((container) => {
    const track = container.querySelector('.speakers-track') as HTMLElement;
    const prevBtn = container.querySelector('.speakers-prev');
    const nextBtn = container.querySelector('.speakers-next');
    if (!track || !prevBtn || !nextBtn) return;

    const speed = window.innerWidth <= 720 ? 2.5 : 1.8;
    let position = 0;
    let paused = false;
    let nudgeVelocity = 0;
    const halfWidth = track.scrollWidth / 2;

    function tick() {
      if (!paused) {
        position -= speed;
      }

      if (Math.abs(nudgeVelocity) > 0.1) {
        position += nudgeVelocity;
        nudgeVelocity *= 0.92;
      } else {
        nudgeVelocity = 0;
      }

      if (position <= -halfWidth) {
        position += halfWidth;
      } else if (position > 0) {
        position -= halfWidth;
      }

      track.style.transform = `translateX(${position}px)`;
      requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);

    container.addEventListener('mouseenter', () => { paused = true; });
    container.addEventListener('mouseleave', () => { paused = false; });

    prevBtn.addEventListener('click', () => { nudgeVelocity += 40; });
    nextBtn.addEventListener('click', () => { nudgeVelocity -= 40; });
  });
</script>
