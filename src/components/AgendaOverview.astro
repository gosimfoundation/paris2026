<section class="section agenda-overview" data-theme-section="light" data-bg-section="lightgray">
  <div class="container">
    {days.map((day) => (
      <div class="day-section">
        <div class="day-header">
          <span class="day-label">{t(day.label)}</span>
          <span class="day-date">{t(day.date)}</span>
        </div>

        <div class="blocks">
          {day.blocks.map((block) => {
            if (block.type === "break") {
              return (
                <div class="block block-break">
                  <span class="block-time">{block.time}</span>
                  <span class="block-label">{t(block.label)}</span>
                </div>
              );
            }

            if (block.type === "keynote") {
              return (
                <div class="block block-keynote"
                  data-overview-track="agentic-ai-summit"
                  data-overview-day={day.date.en.includes("5") ? "May 5" : "May 6"}
                >
                  <span class="block-time">{block.time}</span>
                  <span class="block-label">Keynote</span>
                </div>
              );
            }

            if (block.type === "spotlight") {
              return (
                <div class="block block-spotlight">
                  <span class="block-time">{block.time}</span>
                  <span class="block-label">{t(block.label)}</span>
                </div>
              );
            }

            if (block.type === "closing") {
              return (
                <div class="block block-closing">
                  <span class="block-time">{block.time}</span>
                  <div class="block-closing-content">
                    <span class="block-label">{t(block.label)}</span>
                    {block.note && <span class="block-note">{t(block.note)}</span>}
                  </div>
                </div>
              );
            }

            if (block.type === "lunch-combo") {
              return (
                <div class="block block-lunch-combo">
                  <span class="block-time">{block.time}</span>
                  <div class="lunch-combo-items">
                    {block.items.map((item) => {
                      const color = item.colorId ? trackColors[item.colorId] : null;
                      const Tag = item.href ? "a" : "div";
                      return (
                        <Tag
                          class={`lunch-combo-item lunch-combo-${item.style}`}
                          style={color ? `--from: ${color.from}; --to: ${color.to};` : ""}
                          data-overview-track={item.colorId || ""}
                          data-overview-day={day.date.en.includes("5") ? "May 5" : "May 6"}
                          {...(item.href ? { href: item.href, target: "_blank", rel: "noopener" } : {})}
                        >
                          {color && <div class="lunch-combo-bar" />}
                          <span class="lunch-combo-label">{t(item.label)}</span>
                        </Tag>
                      );
                    })}
                  </div>
                </div>
              );
            }

            if (block.type === "sessions") {
              return (
                <div class="block block-sessions">
                  <span class="block-time">{block.time}</span>
                  <div class="sessions-grid">
                    {block.sessions.map((session) => {
                      const isHackathon = session.type === "hackathons";
                      const overviewDay = day.date.en.includes("5") ? "May 5" : "May 6";

                      if (isHackathon && session.items) {
                        return (
                          <div class="hackathon-stack">
                            {session.items.map((item) => {
                              const itemColor = trackColors[item.colorId] ?? trackColors["hackathon"];
                              return (
                                <div
                                  class="session-card session-card-mini"
                                  style={`--from: ${itemColor.from}; --to: ${itemColor.to};`}
                                  data-overview-track={item.colorId}
                                  data-overview-day={overviewDay}
                                >
                                  <div class="session-bar"></div>
                                  <div class="session-body">
                                    <p class="session-name">{item.name.en}</p>
                                    {lang !== "en" && t(item.name) !== item.name.en && (
                                      <p class="session-name-translation">{t(item.name)}</p>
                                    )}
                                  </div>
                                </div>
                              );
                            })}
                          </div>
                        );
                      }

                      const color = trackColors[session.colorId ?? "hackathon"] ?? trackColors["hackathon"];
                      return (
                        <div
                          class="session-card"
                          style={`--from: ${color.from}; --to: ${color.to};`}
                          data-overview-track={session.colorId || ""}
                          data-overview-day={overviewDay}
                        >
                          <div class="session-bar"></div>
                          <div class="session-body">
                            <div class="session-venue">
                              <span class="venue-name">{session.venue.en}</span>
                            </div>
                            <p class="session-name">{session.name.en}</p>
                            {lang !== "en" && t(session.name) !== session.name.en && (
                              <p class="session-name-translation">{t(session.name)}</p>
                            )}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              );
            }
          })}
        </div>
      </div>
    ))}

    <p class="disclaimer">
      {lang === "zh"
        ? "日程安排如有变动，请以最新信息为准。"
        : lang === "fr"
        ? "Le programme est susceptible d'évoluer."
        : "Schedule is subject to change."}
    </p>
  </div>
</section>

<style is:global>
  .agenda-overview {
    padding-top: var(--section-padding);
    padding-bottom: var(--section-padding);
  }

  /* Day section */
  .agenda-overview .day-section {
    margin-bottom: 3rem;
  }

  .agenda-overview .day-section:last-of-type {
    margin-bottom: 0;
  }

  .agenda-overview .day-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--color-dark, #0f172a);
  }

  .agenda-overview .day-label {
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    font-weight: 800;
    color: var(--color-dark, #0f172a);
    letter-spacing: -0.01em;
  }

  .agenda-overview .day-date {
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(15, 23, 42, 0.45);
  }

  /* Blocks */
  .agenda-overview .blocks {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .agenda-overview .block {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .agenda-overview .block-time {
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(15, 23, 42, 0.4);
    white-space: nowrap;
    width: 7rem;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  /* Full-width event blocks */
  .agenda-overview .block-break,
  .agenda-overview .block-keynote,
  .agenda-overview .block-spotlight,
  .agenda-overview .block-closing {
    align-items: center;
  }

  .agenda-overview .block-break .block-label,
  .agenda-overview .block-keynote .block-label,
  .agenda-overview .block-spotlight .block-label,
  .agenda-overview .block-closing .block-label {
    flex: 1;
    padding: 0.6rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .agenda-overview .block-break .block-label {
    background: rgba(15, 23, 42, 0.05);
    color: rgba(15, 23, 42, 0.45);
  }

  .agenda-overview .block-keynote {
    cursor: pointer;
    transition: opacity 0.15s;
  }

  .agenda-overview .block-keynote:hover {
    opacity: 0.85;
  }

  .agenda-overview .block-keynote .block-label {
    background: var(--color-dark, #0f172a);
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .agenda-overview .block-spotlight .block-label {
    background: linear-gradient(135deg, #f59e0b, #f97316);
    color: #fff;
    font-weight: 700;
  }

  /* Lunch combo block */
  .agenda-overview .block-lunch-combo {
    align-items: center;
  }

  .agenda-overview .lunch-combo-items {
    flex: 1;
    display: flex;
    gap: 0.5rem;
  }

  .agenda-overview .lunch-combo-item {
    flex: 1;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
