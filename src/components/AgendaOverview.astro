---
interface Props {
  lang?: "en" | "zh" | "fr";
}

const { lang = "en" } = Astro.props;

type L = { en: string; zh: string; fr: string };
type HackathonItem = { name: L; colorId: string };
type Session = {
  venue: L;
  capacity: string;
  name: L;
  colorId?: string;
  confirmed?: boolean;
  type?: "hackathons";
  items?: HackathonItem[];
};
type LunchItem = { label: L; colorId?: string; style: "spotlight" | "break" | "session"; href?: string };
type Block =
  | { type: "break" | "keynote" | "spotlight" | "closing"; time: string; label: L; note?: L }
